&НаКлиенте
Процедура СортироватьТаблицуДанных(ИмяКолонки,Направление="Возр")
	
	Если ИмяКолонки="" Тогда
		Элемент = Элементы.ТаблицаСеансов.ТекущийЭлемент;
		Если Элемент=Неопределено Тогда
			Возврат;
		КонецЕсли;
		ИмяКолонки = СтрЗаменить(Элемент.Имя,"ТаблицаСеансов","");
		ИмяКолонкиСортировки = ИмяКолонки+" "+Направление;
	КонецЕсли;
	
	Попытка
		ТаблицаСеансов.Сортировать(ИмяКолонкиСортировки);
	Исключение
		// сбросим если нет сортировки
		ИмяКолонкиСортировки = "";
	КонецПопытки;
		
КонецПроцедуры


