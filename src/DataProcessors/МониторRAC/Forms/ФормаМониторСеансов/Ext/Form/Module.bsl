Процедура ЗаполнитьСписокИБ(мПараметры)
	
	Элементы.ИнформационнаяБаза.СписокВыбора.Очистить();
	ИнформационныеБазы.Очистить();
	
	Ковычка = Символ(34); 
	ТекПлатформа = РегистрыСведений.зд_АктуальнаяПлатформа.ПолучитьПоследнее(ТекущаяДата()).Платформа;			
	СтрокаПлатформа = Ковычка+ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекПлатформа,"ПутьКRAC")+Ковычка; 
	СтрокаКластера = Новый УникальныйИдентификатор(мПараметры.cluster); 
	
	
	МассивКластер = СтрРазделить(мПараметры.key, ":", Ложь);
	Сервер = МассивКластер[0]; 	                              
	Порт = МассивКластер[1];
	
	Для Каждого ИБ Из МодульRAC.ПолучитьТаблицуИнформационныхБазНаСервере(СтрокаПлатформа,Сервер,СтрокаКластера,Порт) Цикл
		Элементы.ИнформационнаяБаза.СписокВыбора.Добавить(ИБ.infobase,ИБ.name);
		ЗаполнитьЗначенияСвойств(ИнформационныеБазы.Добавить(),ИБ);
	КонецЦикла;
	
	Элементы.ИнформационнаяБаза.СписокВыбора.СортироватьПоПредставлению();
	
КонецПроцедуры

Процедура СоздатьТаблицыДанных()
	
	ИмяТаблицы = "ТаблицаСеансов";
	
	МассивДобавляемыхЭлементов = новый Массив;
	
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.ксСеансы.Ресурсы Цикл
		ДобавляемыеРеквизиты = Новый Массив; 
		НовыйРеквизит = Новый РеквизитФормы(Ресурс.Имя, Ресурс.Тип, ИмяТаблицы, Ресурс.Синоним, Ложь);
		МассивДобавляемыхЭлементов.Добавить(НовыйРеквизит);
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхЭлементов);
	
	Для Каждого Реквизит Из МассивДобавляемыхЭлементов Цикл
		НовыйЭлемент = Элементы.Добавить(ИмяТаблицы + Реквизит.Имя, Тип("Полеформы"), Элементы[ИмяТаблицы]);
		// TO DO
		//	Если Колонка.ТипСтрокой="Булево" Или  Колонка.ТипСтрокой="Boolean"Тогда
		//		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		//	Иначе
		//		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		//		НовыйЭлемент.Высота = 0;
		//		НовыйЭлемент.Ширина = Колонка.Ширина;                
		//	КонецЕсли;
			НовыйЭлемент.ТолькоПросмотр = Истина;   
		//	НовыйЭлемент.Заголовок = Колонка.Заголовок;
		//	НовыйЭлемент.Подсказка = "";
			НовыйЭлемент.ПутьКДанным = ИмяТаблицы + "." + Реквизит.Имя;
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуКластеров()
	
	ТаблицаКластеров.Очистить();
	Элементы.Кластер.СписокВыбора.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ксКластеры.cluster КАК cluster,
		|	ксКластеры.host КАК host,
		|	ксКластеры.port КАК port,
		|	ксКластеры.name КАК name,
		|	ксКластеры.Кластер КАК key
		|ИЗ
		|	РегистрСведений.ксКластеры КАК ксКластеры";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Строка = ТаблицаКластеров.Добавить();
		ЗаполнитьЗначенияСвойств(Строка,ВыборкаДетальныеЗаписи);
		
		Элементы.Кластер.СписокВыбора.Добавить(ВыборкаДетальныеЗаписи.key);
		
	КонецЦикла;

КонецПроцедуры 

&НаКлиенте
Функция СформироватьСтруктуруЗапроса()
	
	НайденныеСтроки = ТаблицаКластеров.НайтиСтроки(Новый Структура("key",Кластер));
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		ТекущиеДанные = Неопределено;
	Иначе
		ТекущиеДанные = НайденныеСтроки[0];
	КонецЕсли;
	
	
	мПараметры = новый Структура();
	//мПараметры.Вставить("ПутьКИсполняемомуФайлуRAC",ПутьКИсполняемомуФайлуRAC);
	//мПараметры.Вставить("КодировкаТекстаФайла",КодировкаТекстаФайла);
	Если НЕ ТекущиеДанные=Неопределено Тогда
		мПараметры.Вставить("host",ТекущиеДанные.host);
		мПараметры.Вставить("port",ТекущиеДанные.port);
		мПараметры.Вставить("cluster",ТекущиеДанные.cluster);
	//	мПараметры.Вставить("cluster_user",ТекущиеДанные.cluster_user);
	//	мПараметры.Вставить("cluster_pwd",ТекущиеДанные.cluster_pwd);
	//	cluster = ТекущиеДанные.cluster;
	Иначе
		мПараметры.Вставить("host","");
		мПараметры.Вставить("port",1541);
		мПараметры.Вставить("cluster","");
	//	мПараметры.Вставить("cluster_user","");
	//	мПараметры.Вставить("cluster_pwd","");
	//	cluster = "";
	КонецЕсли;
	
	мПараметры.Вставить("key", ТекущиеДанные.key);

	Возврат мПараметры;

КонецФункции

