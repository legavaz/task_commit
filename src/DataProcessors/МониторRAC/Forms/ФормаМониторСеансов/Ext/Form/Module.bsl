		НоваяСтрока = ТаблицаСеансов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
			НоваяСтрока.infobasename = ИмяИнформационнойБазы(Строка.infobase);
