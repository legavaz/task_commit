&НаСервере
Процедура ЗаполнитьТаблицаКластеров()
	
	ТаблицаКластеров.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ксКластеры.cluster КАК cluster,
		|	ксКластеры.host КАК host,
		|	ксКластеры.port КАК port,
		|	ксКластеры.name КАК name,
		|	ксКластеры.Кластер КАК key
		|ИЗ
		|	РегистрСведений.ксКластеры КАК ксКластеры";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Строка = ТаблицаКластеров.Добавить();
		ЗаполнитьЗначенияСвойств(Строка,ВыборкаДетальныеЗаписи);
	КонецЦикла;

КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТаблицаАгрегацииДанных(Список)
	
	ТаблицаАгрегацииДанных.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Т.Список КАК Список,
		|	Т.Свойство КАК Свойство,
		|	Т.Функция КАК Функция,
		|	Т.Синоним КАК Синоним,
		|	Т.Желтый КАК Желтый,
		|	Т.Красный КАК Красный
		|ИЗ
		|	РегистрСведений.ксИндикаторы КАК Т
		|
		|ГДЕ
		|	Т.Список = &Список";
	
	Запрос.УстановитьПараметр("Список", Список);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Строка = ТаблицаАгрегацииДанных.Добавить();
		ЗаполнитьЗначенияСвойств(Строка,ВыборкаДетальныеЗаписи);
	КонецЦикла;

КонецПроцедуры 


&НаСервере
Процедура ЗаполнитьДатуОбновления(Кластер = "", list)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	MAX(Т.ПериодЗаписи) КАК ПериодЗаписи
		|ИЗ
		|	РегистрСведений." +list+" КАК Т
		|ГДЕ
		|	Т.Кластер = CASE WHEN &Кластер = """" THEN Т.Кластер ELSE &Кластер END";
	
	Запрос.УстановитьПараметр("Кластер", Кластер);
	РезультатЗапроса = Запрос.Выполнить();
		
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДатаОбновления = ВыборкаДетальныеЗаписи.ПериодЗаписи;
	КонецЦикла;

КонецПроцедуры

