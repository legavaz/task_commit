&НаСервере
Функция ПолучитьСписок(мПараметры,list)
	
	ТекстОшибки = ""; 
	
	
	Ковычка = Символ(34); 
	ТекПлатформа = РегистрыСведений.зд_АктуальнаяПлатформа.ПолучитьПоследнее(ТекущаяДата()).Платформа;			
	СтрокаПлатформа = Ковычка+ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекПлатформа,"ПутьКRAC")+Ковычка; 
	СтрокаКластера = Новый УникальныйИдентификатор(мПараметры.cluster); 
	
	ЗаполнитьДатуОбновления(КлючКластера, list); 
	МассивКластер = СтрРазделить(КлючКластера, ":", Ложь);
	Если МассивКластер.Количество() > 1 Тогда
		Сервер = МассивКластер[0]; 	                              
		Порт = МассивКластер[1];
		Если Интерактивно Тогда
			Если list = "ксСеансы" Тогда
				МодульRAC.ЗаполнитьТаблицуСеансовНаСервере(СтрокаПлатформа,Сервер,СтрокаКластера,Порт);
			ИначеЕсли list = "ксПроцессы" Тогда
				МодульRAC.ЗаполнитьТаблицуПроцессовНаСервере(СтрокаПлатформа,Сервер,СтрокаКластера,Порт);
			ИначеЕсли list = "ксСоединения" Тогда
				МодульRAC.ЗаполнитьТаблицуСоединенийНаСервере(СтрокаПлатформа,Сервер,СтрокаКластера,Порт);
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли;
	МассивСоответствиеДанных = Новый Массив;
	ЗаполнитьДатуОбновления(КлючКластера, list);
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ Т.*
		|ИЗ
		|	&ТаблицаРС КАК Т
		|ГДЕ
		|	Т.ПериодЗаписи = &ПериодЗаписи
		|	И Т.Кластер = &Кластер";	
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТаблицаРС", "РегистрСведений." + list); 
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Кластер", КлючКластера);
	Запрос.УстановитьПараметр("ПериодЗаписи", ДатаОбновления); 
	РезЗапроса = Запрос.Выполнить();
	Выборка = РезЗапроса.Выбрать();  
	МассивКолонок = Новый Массив;
	Для Каждого Кол ИЗ РезЗапроса.Колонки Цикл
		МассивКолонок.Добавить(Кол);
	КонецЦикла;
	номерстроки = 1;  
	ИнфБазы = ИнформационныеБазы(КлючКластера);
	Пока Выборка.Следующий() Цикл
		СоответствиеДанных = Новый Соответствие;
		Для Каждого ИмяПараметра Из МассивКолонок Цикл
			Если ИмяПараметра.Имя = "infobase" Тогда
				ИмяБазы = ИнфБазы[Выборка[ИмяПараметра.Имя]];
				СоответствиеДанных.Вставить("infobase", ИмяБазы);
			Иначе
				СоответствиеДанных.Вставить(ИмяПараметра.Имя,Выборка[ИмяПараметра.Имя]);
			КонецЕсли;
		КонецЦикла;
		
		СоответствиеДанных.Вставить("line-number",номерстроки);
		МассивСоответствиеДанных.Добавить(СоответствиеДанных);

		номерстроки = номерстроки +1
	КонецЦикла;

	
	
			
	СтруктураДанныхОтвета = новый Структура();
	СтруктураДанныхОтвета.Вставить("МассивСоответствиеДанных",МассивСоответствиеДанных);
	
	Возврат СтруктураДанныхОтвета;
КонецФункции

Функция ИнформационныеБазы(Кластер)
	 СоответствиеДанных = Новый Соответствие; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ксИнформационныеБазы.infobase КАК infobase,
		|	ксИнформационныеБазы.name КАК name
		|ИЗ
		|	РегистрСведений.ксИнформационныеБазы КАК ксИнформационныеБазы
		|ГДЕ
		|	ксИнформационныеБазы.Кластер = &Кластер";
	
	Запрос.УстановитьПараметр("Кластер", Кластер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеДанных.Вставить(ВыборкаДетальныеЗаписи.infobase, ВыборкаДетальныеЗаписи.name); 
	КонецЦикла;

	Возврат СоответствиеДанных;
КонецФункции

&НаКлиенте
Процедура ЗавершитьРаботуСенаса(Команда)
	
	
	ТекущиеДанныеКластеров = Элементы.ТаблицаКластеров.ТекущиеДанные; 
	МассивВыделенных = Новый Массив;
	Для Каждого Стр Из Элементы.ТаблицаДанных.ВыделенныеСтроки Цикл 
		МассивВыделенных.Добавить(Стр);
	КонецЦикла;
	Для Каждого ТекВыд Из МассивВыделенных Цикл
		Элементы.ТаблицаДанных.ТекущаяСтрока = ТекВыд;
		ТекущиеДанные = Элементы.ТаблицаДанных.ТекущиеДанные;
	
		Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанныеКластеров=Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если СтарыеКолонки=Неопределено Тогда
			СтарыеКолонки = новый Массив;
		КонецЕсли;		
		
		session = "";
		// найдем поле сессия
		Для каждого стр из СтарыеКолонки Цикл
			Если стр.Ключ="session" Тогда
				session = ТекущиеДанные[стр.Имя];
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если session="" Тогда
			Возврат;
		КонецЕсли;
		
		мПараметры = СформироватьСтруктуруЗапроса(ТекущиеДанныеКластеров);
		мПараметры.Вставить("session",session);
		СтруктураДанныхОтвета = ЗавершитьРаботуСенасаНаСервере(мПараметры); 
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Функция ЗавершитьРаботуСенасаНаСервере(мПараметры)  
	Результат = "";
	Ковычка = Символ(34); 
	ТекПлатформа = РегистрыСведений.зд_АктуальнаяПлатформа.ПолучитьПоследнее(ТекущаяДата()).Платформа;			
	СтрокаПлатформа = Ковычка+ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекПлатформа,"ПутьКRAC")+Ковычка; 
	СтрокаКластера = Новый УникальныйИдентификатор(мПараметры.cluster); 
	МассивКластер = СтрРазделить(КлючКластера, ":", Ложь);  
	Если МассивКластер.Количество() > 1 Тогда
		Сервер = МассивКластер[0]; 	                              
		Порт = МассивКластер[1];	
		МодульRAC.ЗавершитьСеансНаСервере(СтрокаПлатформа,Сервер,Порт,СтрокаКластера,мПараметры.session,Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции


&НаКлиенте
Процедура ПрименитьСоставПолей(Команда)
	ОбновитьВидимостьКолонок(Список);
	СохранитьНастройкиКолонокТекущегоСписка(Список);
КонецПроцедуры    

&НаКлиенте
Процедура ОбновитьВидимостьКолонок(list)
	
	СоответствиеКолонок = новый Соответствие();
	
	Для каждого стр из СтарыеКолонки Цикл
		СоответствиеКолонок.Вставить(стр.Ключ,стр);
	КонецЦикла;
	
	ВидимыхПолей = 0;
	
	Для каждого стр из ТаблицаСвойств Цикл
		
		СвойстваКолонки = СоответствиеКолонок.Получить(стр.name);
		Если СвойстваКолонки=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Элемент = Элементы.Найти("ТаблицаДанных"+СвойстваКолонки.ИмяКолонки);
		
		Если Элемент=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ Элемент.Видимость=стр.use Тогда
			Элемент.Видимость = стр.use;
			СвойстваКолонки.Видимость = стр.use;
		КонецЕсли;
		
		Если Элемент.Видимость=Истина Тогда
			ВидимыхПолей=ВидимыхПолей+1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВидимыхПолей=0 Тогда
		Сообщить("Вы убрали все поля. Оставьте хотябы одно поле!");
	КонецЕсли;
	
КонецПроцедуры 



