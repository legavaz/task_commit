&НаКлиенте
Процедура ОбновитьГрафикИстории()
	
	ТекущиеДанные = Элементы.ТаблицаАгрегацииДанных.ТекущиеДанные;
	
	Если ТекущиеДанные=Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ОбновитьГрафикИсторииСервер(Список,ТекущиеДанные.Свойство,ТекущиеДанные.Синоним,ТекущиеДанные.Функция,КлючКластера, ТекущиеДанные.Желтый, ТекущиеДанные.Красный);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьГрафикИсторииСервер(ТипСобытия,name,synonim,func,key, Желтый, Красный)
	
	ДатаСобытия = ДатаОбновления;
	Если ДатаСобытия=Дата(1,1,1) Тогда
		ДатаСобытия = ТекущаяДата();
	КонецЕсли;

	Свойство = synonim;
	
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы=ТипДиаграммы.График;
	Диаграмма.ОбластьЛегенды.Расположение = РасположениеЛегендыДиаграммы.Низ;
	
	Запрос = новый Запрос;
	
	Если func = "count ЗначениеЗаполнено" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	""" + synonim + """ КАК Свойство,
		|	count(Т." + name + ") КАК ЗначениеЧисло,
		|	Т.ПериодЗаписи КАК ДатаСобытия
		|ИЗ
		|	РегистрСведений." + ТипСобытия + " КАК Т
		|ГДЕ
		|	Т.ПериодЗаписи МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И Т.Кластер = &Кластер
		|	И Т." + name + " <> 0
		|GROUP BY Т.ПериодЗаписи
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСобытия";	

	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		|	""" + synonim + """ КАК Свойство,
		|	"+func+"(Т." + name + ") КАК ЗначениеЧисло,
		|	Т.ПериодЗаписи КАК ДатаСобытия
		|ИЗ
		|	РегистрСведений." + ТипСобытия + " КАК Т
		|ГДЕ
		|	Т.ПериодЗаписи МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И Т.Кластер = &Кластер  
		|GROUP BY Т.ПериодЗаписи
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСобытия";	
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаСобытия-ИнтервалИстории);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаСобытия);
	// кластер
	Запрос.УстановитьПараметр("Кластер", key);
	Выборка = Запрос.Выполнить().Выбрать();
	
	СерияОкно = Диаграмма.УстановитьСерию(Свойство);
	СуждениеЦветоваяИндикация = Неопределено;
	Если Желтый > 0 ИЛИ Красный > 0 Тогда 
		СуждениеЦветоваяИндикация = Новый Соответствие;
		СуждениеЦветоваяИндикация.Вставить("Желтый", Желтый);
		СуждениеЦветоваяИндикация.Вставить("Красный", Красный);	
	КонецЕсли;

	Если НЕ СуждениеЦветоваяИндикация = Неопределено Тогда
		СерияЖелтый = Диаграмма.УстановитьСерию("Желтый");
		СерияЖелтый.Цвет = Новый Цвет(249,166,2);
		СерияКрасный = Диаграмма.УстановитьСерию("Красный");
		СерияКрасный.Цвет = Новый Цвет(255,100,100);
	КонецЕсли;
	
	
	Пока Выборка.Следующий() Цикл
		
		ТочкаДиаграммы = Диаграмма.УстановитьТочку(Выборка.ДатаСобытия);
			
		// добавим значение	
		Диаграмма.УстановитьЗначение(ТочкаДиаграммы, СерияОкно, Выборка.ЗначениеЧисло);
		
		Если НЕ СуждениеЦветоваяИндикация = Неопределено Тогда
			ЗначениеЧисло = СуждениеЦветоваяИндикация.Получить("Желтый");
			Диаграмма.УстановитьЗначение(ТочкаДиаграммы, СерияЖелтый, ЗначениеЧисло);
			ЗначениеЧисло = СуждениеЦветоваяИндикация.Получить("Красный");
			Диаграмма.УстановитьЗначение(ТочкаДиаграммы, СерияКрасный, ЗначениеЧисло);
		КонецЕсли;
		
	КонецЦикла;
	 	
КонецПроцедуры


