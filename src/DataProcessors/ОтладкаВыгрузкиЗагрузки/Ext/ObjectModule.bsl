Функция глПолучитьКаталог(Кат)
  Возврат ?(ПустаяСтрока(Кат)=0, ?(Прав(СОКРП(Кат),1)<>"\",СОКРЛП(Кат)+"\",СОКРЛП(Кат)),"");
КонецФункции

//Команды:
//export  - выгрузка в хмл
//sync - синхронизация файлов
//import - загрузка из хмл
//save - сохранить в cf
//load - загрузить из  cf
//apply - обновит конфигурацию базы данных (с выполнением, при необходимости, реструктуризации базы данных).
//dump - выгрузка dt   
//restore - восстановить
Процедура ВыполнитьСценарийАвтономногоСервера(ИнформационнаяБаза,Команда,знач РабочийКаталог,ИмяРасширения="") Экспорт
	
	Ковычка = Символ(34); 
	КодВозврата = "999";		    
	КодировкаЗаписи = "cp866";
	
	мНачалоСценария = ТекущаяДата(); 
	КомандаХМЛ = Новый Массив;
	КомандаХМЛ.Добавить("export");	
	КомандаХМЛ.Добавить("sync");
	КомандаХМЛ.Добавить("import"); 
	
	КомандаДТ = Новый Массив;
	КомандаДТ.Добавить("dump");	
	КомандаДТ.Добавить("restore");
	
	КомандаForce = Новый Массив;
	КомандаForce.Добавить("apply");	
	КомандаForce.Добавить("check");

	КомандаВыводФайла = Новый Массив;	
	КомандаВыводФайла.Добавить("save");
	КомандаВыводФайла.Добавить("saveExt");	
	КомандаВыводФайла.Добавить("load");	
	КомандаВыводФайла.Добавить("dump");	
		
	
	РабочийКаталог = глПолучитьКаталог(РабочийКаталог);
	
	ЭтоДТ_Команда 		= КомандаДТ.Найти(Команда)<>Неопределено;	
	ЭтоХМЛ_Команда 		= КомандаХМЛ.Найти(Команда)<>Неопределено;	
	ЭтоForce_Команда 	= КомандаForce.Найти(Команда)<>Неопределено;	
	ЭтоВыводФайла_Команда 	= КомандаВыводФайла.Найти(Команда)<>Неопределено;	
	
	Если не ПроверитьНаличиеФайла(РабочийКаталог) Тогда
		СоздатьКаталог(РабочийКаталог);
		ОбщегоНазначения.СообщитьПользователю(""+РабочийКаталог+" - создан!");
	КонецЕсли;   
	
	КаталогВыгрузкиXML = РабочийКаталог + "cfg_xml";	
	Если ЭтоХМЛ_Команда и 
		не ПроверитьНаличиеФайла(КаталогВыгрузкиXML) Тогда
		
		СоздатьКаталог(КаталогВыгрузкиXML);
		ОбщегоНазначения.СообщитьПользователю(""+КаталогВыгрузкиXML+" - создан!");		
	КонецЕсли;	
	
	РеквизитыИБ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИнформационнаяБаза,"ИмяБазы,ПортАвтономногоСервера,ЛогинБазы,ПарольБазы");	
	
	//Платформа
	ТекПлатформа = РегистрыСведений.зд_АктуальнаяПлатформа.ПолучитьПоследнее(ТекущаяДата()).Платформа;   
	Версия1С = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекПлатформа,"ПутьКПлатформе1С");
	Версия1С = СтрЗаменить(Версия1С,"1cv8.exe","ibcmd.exe");  
	
	ИмяФайла_ibcmd =  Команда+"_"+РеквизитыИБ.ИмяБазы;	
	ИмяБатФайла = ИмяФайла_ibcmd + ".bat";
	ИмяlogФайла = РабочийКаталог+ИмяФайла_ibcmd+?(ПустаяСтрока(ИмяРасширения),"","_"+ИмяРасширения)+ ".log";
		
	Если ПустаяСтрока(ИмяФайла1С) Тогда
		ИмяФайла1С = РеквизитыИБ.ИмяБазы+?(ПустаяСтрока(ИмяРасширения),"","_"+ИмяРасширения)+?(ЭтоДТ_Команда,".dt",?(ПустаяСтрока(ИмяРасширения),".cf",".cfe"));
	КонецЕсли;	
		
	КонфигурационныйФайл = КаталогВременныхФайлов() + РеквизитыИБ.ИмяБазы + ".yml"; 		
	КонфигурационныйФайл = АвтономныйСервер.СоздатьКонфигурационныйФайл(Версия1С,РеквизитыИБ.ИмяБазы, КонфигурационныйФайл, Ложь, ?(РеквизитыИБ.ПортАвтономногоСервера=0,Неопределено,РеквизитыИБ.ПортАвтономногоСервера)); 
	
	Если НЕ ПроверитьНаличиеФайла(КонфигурационныйФайл) Тогда
		ОбщегоНазначения.СообщитьПользователю("(Отмена скрипта)не создан конф. файл: "+КонфигурационныйФайл);	
		Возврат;
	КонецЕсли;
	
	МассивКомманд = Новый Массив;
	МассивКомманд.Добавить(Ковычка+Версия1С+Ковычка);
	
	//БатФайл.ДобавитьСтроку("%v8% infobase dump -c " + КонфигурационныйФайл + " " + ПутьВыгрузки + "\" + ИмяБазы + "\1cv8.dt -u " + ЛогинБазы + " -P " + ПарольБазы);
	
	//echo off
	//"C:\Program Files\1cv8\8.3.27.1859\bin\ibcmd.exe" infobase config save --user=prog1C --password=GY9xolug --config=D:\Data1C\temp\ERP_work_arvaninov.yml --extension=ExtDopFunkcional E:\sborka\ERP_work_arvaninov\ExtDopFunkcional.cfu >E:\sborka\ERP_work_arvaninov\save_ExtDopFunkcional.log
	
	Если ЭтоДТ_Команда Тогда
		МассивКомманд.Добавить("infobase "+Команда);				
	Иначе		
		Если Команда="sync" Тогда
			МассивКомманд.Добавить("infobase config export");		
		Иначе
			МассивКомманд.Добавить("infobase config "+Команда);			
		КонецЕсли;			
	Конецесли;
		
	МассивКомманд.Добавить("--user="+РеквизитыИБ.ЛогинБазы);
	МассивКомманд.Добавить("--password="+РеквизитыИБ.ПарольБазы);
	
	Если Команда="sync" Тогда
		МассивКомманд.Добавить("--sync="+КонфигурационныйФайл);	
	КонецЕсли;
	
	МассивКомманд.Добавить("--config="+КонфигурационныйФайл);
	
	Если не ПустаяСтрока(ИмяРасширения) Тогда
		МассивКомманд.Добавить("--extension="+ИмяРасширения);
	КонецЕсли;	
	
	Если ЭтоХМЛ_Команда Тогда
		МассивКомманд.Добавить(КаталогВыгрузкиXML);
	ИначеЕсли ЭтоВыводФайла_Команда Тогда
		МассивКомманд.Добавить(РабочийКаталог+ИмяФайла1С);		
	КонецЕсли; 
	
	Если ЭтоForce_Команда Тогда
		МассивКомманд.Добавить("--force");		
	КонецЕсли;
	
	МассивКомманд.Добавить(">"+ИмяlogФайла);
	
	стрКоманда = СтрСоединить(МассивКомманд," "); 	
	
	БатФайл = Новый ТекстовыйДокумент;	
	БатФайл.ДобавитьСтроку("echo off");
	БатФайл.ДобавитьСтроку(стрКоманда);
	БатФайл.Записать(РабочийКаталог+ИмяБатФайла, КодировкаЗаписи);
	ЗапуститьПриложение(ИмяБатФайла, РабочийКаталог, Истина, КодВозврата);
	Сообщить("("+КодВозврата+") Начало:"+мНачалоСценария+" - завершено: "+ТекущаяДата());	
	   
	//чтение логов  
	мТекстФайла="";
	Если ПроверитьНаличиеФайла(ИмяlogФайла) Тогда
		мТекстФайла = "";
		ТекстФайл = новый Файл(ИмяlogФайла);
		Если ТекстФайл.Существует() Тогда
			Текст = Новый ТекстовыйДокумент;	
			Текст.Прочитать(ИмяlogФайла,КодировкаТекста.UTF8);	
			мТекстФайла = Текст.ПолучитьТекст();
		КонецЕсли;
		Сообщить(""+ИмяlogФайла+": "+Символы.ПС+мТекстФайла);  
	КонецЕсли;    
	ЗаписьЖурналаРегистрации("АвтономныйСервер."+Команда,?(КодВозврата=0,УровеньЖурналаРегистрации.Информация,УровеньЖурналаРегистрации.Ошибка),Метаданные.Справочники.ЗД_ИнформационныеБазы,ИнформационнаяБаза,""+мНачалоСценария+"-"+ТекущаяДата()+" "+мТекстФайла);
	
		
КонецПроцедуры

Функция ПроверитьНаличиеФайла(ИмяФайла)
	Рез = Ложь;
	МойФайл = Новый Файл(ИмяФайла);
	Рез = МойФайл.Существует(); 
	Возврат Рез;
КонецФункции    

Функция ОстановитьИсполнение()
	
	Если Константы.ОстановитьИсполнение.Получить() = Истина Тогда
		
		ТекстСообщения = "Выполнение остановлено пользователем через константу";
		ЗаписьЖурналаРегистрации("Обновление из хранилища",,,,ТекстСообщения);
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура Пауза(Секунд) Экспорт
	
	Для к=1 По Секунд Цикл
		
		Если ОстановитьИсполнение() Тогда
			Прервать;
		КонецЕсли; 
		
		СтрокаЗапроса = "ping -n 2 localhost"; 
		Соединение = Новый COMОбъект("WScript.Shell");
		Соединение.Run(СтрокаЗапроса, 0, -1);	
		
	КонецЦикла;
	
КонецПроцедуры








