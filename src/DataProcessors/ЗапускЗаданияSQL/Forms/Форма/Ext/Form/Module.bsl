
&НаСервере
Процедура ВыполнитьJobНаСервере()
		
	Если НЕ ЗначениеЗаполнено(Задание) Тогда
		Сооб = Новый СообщениеПользователю;
		Сооб.Текст = "Не выбрано задание!";
		Сооб.Сообщить();
		Возврат;
	КонецЕсли;

	
	Структура = Новый Структура;
	Для Каждого Стр Из Объект.SQLПараметры Цикл 
		Если ЗначениеЗаполнено(Стр.Значение) Тогда
			Структура.Вставить(Стр.Имя, Стр.Значение);
		Иначе
			Сооб = Новый СообщениеПользователю;
			Сооб.Текст = "Не задан параметр " + Стр.Имя;
			Сооб.Сообщить();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	СтрокаИдентификатора = Строка(ТекущаяДата()) + "," + Строка(Пользователи.ТекущийПользователь());
	Если ПроверитьНеВыполненые(Задание, Структура) Тогда
		SQLВыполнениеЗаданий.ДобавитьЗаписьВРегистрВыполнениеЗаданий(Задание, Структура, СтрокаИдентификатора);
		SQLВыполнениеЗаданий.ОбработатьЗадания();
	Иначе
		Сооб = Новый СообщениеПользователю;
		Сооб.Текст = "Такое задание существует и не выполнено!";
		Сооб.Сообщить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьJob(Команда)
	ВыполнитьJobНаСервере();
КонецПроцедуры

