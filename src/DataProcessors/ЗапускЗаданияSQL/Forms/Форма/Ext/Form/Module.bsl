&НаСервере
Функция ПроверитьНеВыполненые(Задание, Структура)
	Рез = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SQLВыполнениеЗаданий.СтрокаJson КАК СтрокаJson
		|ИЗ
		|	РегистрСведений.SQLВыполнениеЗаданий КАК SQLВыполнениеЗаданий
		|ГДЕ
		|	SQLВыполнениеЗаданий.РезультатВыполнения = Ложь
		|	И SQLВыполнениеЗаданий.КоличествоПопыток < &КоличествоПопыток
		|	И SQLВыполнениеЗаданий.Задание = &Задание";
	
	Запрос.УстановитьПараметр("Задание", Задание);
	Запрос.УстановитьПараметр("Ложь", Ложь);
	КоличествоПопыток = Константы.SQLЗаданиеКоличествоПопыток.Получить();
	Запрос.УстановитьПараметр("КоличествоПопыток",КоличествоПопыток);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		СтруктураЗадания = SQLВыполнениеЗаданий.СтрокаJSONВСтруктуруПараметров(ВыборкаДетальныеЗаписи.СтрокаJson);
		Если ОбщегоНазначения.КоллекцииИдентичны(СтруктураЗадания, Структура) Тогда
			Рез = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Рез;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗначениеПоУмолчанию(Значение)
	Рез = Неопределено; 
	Если ТипЗнч(Значение) =  Тип("СправочникСсылка.Пользователи") Тогда
		Рез = Пользователи.ТекущийПользователь();
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.SQLDBТестовые") Тогда
		Рез = Значение;
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	SQLDBТестовые.Ссылка КАК Ссылка,
			|	SQLDBТестовые.Код КАК Код,
			|	SQLDBТестовые.Разработчик КАК Разработчик
			|ИЗ
			|	Справочник.SQLDBТестовые КАК SQLDBТестовые
			|ГДЕ
			|	SQLDBТестовые.Разработчик = &Разработчик
			|
			|УПОРЯДОЧИТЬ ПО
			|	Код";
		
		Запрос.УстановитьПараметр("Разработчик", Пользователи.ТекущийПользователь());
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Рез = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;
	Иначе
		Рез = Значение;
	КонецЕсли;
	Возврат Рез;
КонецФункции

&НаСервереБезКонтекста
Функция ДоступныеЗадания() 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
							|	П.Задание КАК Задание
							|ИЗ
							|	РегистрСведений.SQLПравоЗапускаЗаданий КАК П
							|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
							|			ГруппыДоступаПользователи.Ссылка КАК Ссылка
							|		ИЗ
							|			Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
							|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставыГруппПользователей КАК СоставыГруппПользователей
							|				ПО (СоставыГруппПользователей.Используется)
							|					И (СоставыГруппПользователей.Пользователь = &Пользователь)
							|					И ГруппыДоступаПользователи.Пользователь = СоставыГруппПользователей.ГруппаПользователей) КАК Д
							|		ПО (П.ГруппаДоступа = Д.Ссылка)");
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());	
	РезЗапроса =  Запрос.Выполнить();
	Если РезЗапроса.Пустой() Тогда
		Возврат Справочники.SQLЗадания.ПустаяСсылка();
	Иначе 
		Выборка = РезЗапроса.Выбрать();
		Рез = Новый СписокЗначений;
		Пока Выборка.Следующий() Цикл
			Рез.Добавить(Выборка.Задание);
		КонецЦикла;
		
		Возврат Рез;
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Процедура ЗаданиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = ДоступныеЗадания();

КонецПроцедуры
