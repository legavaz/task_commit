&НаСервере
Процедура ЗаданиеПриИзмененииНаСервере()
	Объект.SQLПараметры.Очистить();
	Если ЗначениеЗаполнено(Задание) Тогда
		Для Каждого Стр Из Задание.SQLПараметры Цикл
			НовыйСтр = Объект.SQLПараметры.Добавить();
			НовыйСтр.Имя = Стр.Имя; 
			НовыйСтр.Значение = ТипДляЗначения(Стр.НазваниеТипа); 			
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаданиеПриИзменении(Элемент)
	ЗаданиеПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Функция ТипДляЗначения(НазваниеТипа)
	Рез = "";
	Для каждого элТип из Метаданные.ОпределяемыеТипы.SQLТипыПараметров.Тип.Типы() Цикл
		обМетаданных = Метаданные.НайтиПоТипу(элТип);
		
		Если обМетаданных <> Неопределено И обМетаданных.Имя = НазваниеТипа Тогда
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(обМетаданных.ПолноеИмя());
			Рез = МенеджерОбъекта.ПустаяСсылка();
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 	
	Возврат Рез;
КонецФункции  

&НаСервере
Процедура ЗапуститьРегламентноеЗадание()
   ИмяМетода = Метаданные.РегламентныеЗадания.SQLВыполнениеЗаданий.ИмяМетода;

   // Проверка, выполняется ли фоновое задание.
   Отбор = Новый Структура;
   Отбор.Вставить("ИмяМетода", ИмяМетода);
   Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
   ФоновыеЗаданияВыполнениеЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
   Если ФоновыеЗаданияВыполнениеЗаданий.Количество() = 0 Тогда
      НаименованиеФоновогоЗадания = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
        НСтр("ru = 'Запуск вручную: %1'"), "SQL выполнение заданий");
      ФоновыеЗадания.Выполнить(ИмяМетода,,, НаименованиеФоновогоЗадания);
   КонецЕсли;
КонецПроцедуры
