&НаКлиенте
Функция ПеренестиРекомендуемыйПараметр(Параметр)
	
	Если РежимЗапуска = "ENTERPRISE" Тогда
		СтрокиПоиска = НайтиЗначениеВДереве(ТаблицаЛево.ПолучитьЭлементы(), "Параметр", "ПРЕДПРИЯТИЕ");
	ИначеЕсли РежимЗапуска = "DESIGNER" Тогда
		СтрокиПоиска = НайтиЗначениеВДереве(ТаблицаЛево.ПолучитьЭлементы(), "Параметр", "КОНФИГУРАТОР");
	ИначеЕсли РежимЗапуска = "CREATEINFOBASE" Тогда
			СтрокиПоиска = НайтиЗначениеВДереве(ТаблицаЛево.ПолучитьЭлементы(), "Параметр", "СОЗДАНИЕ БД");
	КонецЕсли;
		
	СтрокаТаблицы = НайтиПараметрВДереве(Параметр, СтрокиПоиска);
	
	Если СтрокаТаблицы = Неопределено Тогда
		СтрокаТаблицы = НайтиПараметрВДереве(Параметр); //сначала в своем разделе, если не нашли, то по всему дереву
	КонецЕсли;
	
	
	Данные = СтрокаТаблицы.СтруктураЗначенияПараметра;
	
	
	Если СтрокаТаблицы.ЭтоГруппа Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	Если ПроверитьПараметрУжеЕсть(СтрокаТаблицы.Параметр) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	НоваяСтрока = ТаблицаПраво.Добавить();
	
	НоваяСтрока.Параметр = СтрокаТаблицы.Параметр;
	НоваяСтрока.Данные = Данные;
	
	Если Данные <> Неопределено Тогда
		Если Данные.Свойство("Значение0") Тогда
			Данные.Значение0.Свойство("ВозможноПустое", НоваяСтрока.ВозможноПустоеЗначение0);
		КонецЕсли;
		
	КонецЕсли;
	
	Массив = ПолучитьПодсказкиВвода(СтрокаТаблицы);
	Для Сч = 0 По Массив.ВГраница() Цикл
		НоваяСтрока["ПодсказкаВвода" + Сч] = Массив[Сч];
	КонецЦикла;
	
	
	НоваяСтрока.КлючСвязиЛево = СтрокаТаблицы.ПолучитьИдентификатор();
	
	ОбновитьТаблицуРекомендуемые();
	
	СформироватьСтрокуЗапуска();
	
	Возврат НоваяСтрока;
	
КонецФункции

