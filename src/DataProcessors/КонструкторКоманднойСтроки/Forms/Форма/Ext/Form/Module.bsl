&НаКлиентеНаСервереБезКонтекста
Функция СтрокаДереваВСтруктуру(СтрокаДерева, Знач Колонки) 
	
	Если ТипЗнч("Колонки") = Тип("Строка") Тогда
		Колонки = СтрРазделить(Колонки, ",", Ложь);
	КонецЕсли;
	
	НовСтруктура = Новый Структура();
	Для каждого выбКолонка Из Колонки Цикл
		Значение = СтрокаДерева[выбКолонка];
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			Значение = СкопироватьСтруктуру(Значение);
		КонецЕсли;
		
		НовСтруктура.Вставить(выбКолонка, Значение);
	КонецЦикла;
	
	НовСтруктура.Вставить("КлючСвязиЛево", СтрокаДерева.ПолучитьИдентификатор());
	
	Возврат НовСтруктура;
	
КонецФункции

