&НаКлиенте
Процедура ОбновитьТаблицуРекомендуемые() 
	
	ТаблицаРекомендуемые.Очистить();
	
	Соотв = Новый Соответствие;
		
	Для каждого СтрокаПраво Из ТаблицаПраво Цикл
		
		СтрокаЛево = ТаблицаЛево.НайтиПоИдентификатору(СтрокаПраво.КлючСвязиЛево);
		
		РекПараметры = СтрокаЛево.РекомендуемыеПараметрыСправа;
		
		Если Не ЗначениеЗаполнено(РекПараметры) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(РекПараметры) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		СодержитЗначения = Ложь;
		РекПараметры.Свойство("СодержитЗначения", СодержитЗначения);
		
		Если СодержитЗначения <> Истина Тогда
			Продолжить;	
		КонецЕсли;
		
		Для каждого КЗ Из РекПараметры Цикл
			Если КЗ.Ключ = "СодержитЗначения" Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВидимостьСоотвествуетУсловиям(КЗ.Значение.Параметр, КЗ.Значение.УсловияВидимости) = Ложь Тогда
				Продолжить;
			КонецЕсли;
			Структура = Новый Структура("Представление, УсловияВидимости", КЗ.Значение.Представление, КЗ.Значение.УсловияВидимости);
			
			Соотв.Вставить(КЗ.Значение.Параметр, Структура);
			
		КонецЦикла;
		
	КонецЦикла;	
	
	МассивУдалить = Новый Массив;
	Для каждого КЗ Из Соотв Цикл
		Парам = Лев(КЗ.Ключ, НайтиКонецСлова(КЗ.Ключ, 2));
		Для каждого Строка Из ТаблицаПраво Цикл
			Если Строка.Параметр = Парам Тогда
				МассивУдалить.Добавить(КЗ.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для каждого Эл Из МассивУдалить Цикл
		Соотв.Удалить(Эл);
	КонецЦикла;
	
	
	Для каждого КЗ Из Соотв Цикл
		НоваяСтрока = ТаблицаРекомендуемые.Добавить();
		НоваяСтрока.Параметр = КЗ.Ключ;
		НоваяСтрока.Представление = КЗ.Значение.Представление;
		НоваяСтрока.УсловияВидимости = КЗ.Значение.УсловияВидимости;
	КонецЦикла;	
	
	Если ТаблицаРекомендуемые.Количество() > 0 Тогда
	Элементы.ДекорацияПустышка.Видимость = Ложь;
	Иначе
		Элементы.ДекорацияПустышка.Видимость = Истина;
	КонецЕсли;
	
	Если ТаблицаРекомендуемые.Количество() = 0 Тогда
		Элементы.ГруппаРекомендуемые.Видимость = Ложь;
		Элементы.ВсяСтрокаЗапуска.Высота = 8;
		ОтключитьОбработчикОжидания("ТаблицаРекомендуемыеУбратьВыделениеСтроки");
	Иначе
		Элементы.ГруппаРекомендуемые.Видимость = Истина;
		Элементы.ВсяСтрокаЗапуска.Высота = 4;
		ПодключитьОбработчикОжидания("ТаблицаРекомендуемыеУбратьВыделениеСтроки", 1, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРекомендуемыеУбратьВыделениеСтроки() Экспорт 
	
	Если ТекущийЭлемент <> Элементы.ТаблицаРекомендуемые Тогда
		Элементы.ТаблицаРекомендуемые.ТекущаяСтрока = Неопределено;
