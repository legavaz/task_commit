&НаКлиенте
Процедура ТаблицаПравоУсловноеОформлениеСтроки(СтрокаТЧ)
	
	Если СтрокаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеЗначение0 = Элементы.ТаблицаПравоЗначение0;
	
	ОчиститьЭлементыУправленияПоля(ПолеЗначение0);
	
	ПолеЗначение1 = Элементы.ТаблицаПравоЗначение1;
	
	ОчиститьЭлементыУправленияПоля(ПолеЗначение1);
		
	Если ДанныеСодержатЗначения(СтрокаТЧ.Данные) = Ложь Тогда	
		Возврат;
	КонецЕсли;
	
	Сч = 0;
	МассивЗначений = ПолучитьМассивЗначенийДанных(СтрокаТЧ.Данные);
	Для каждого КЗ Из МассивЗначений Цикл
		
		выбПолеЗначение = Элементы["ТаблицаПравоЗначение" + Сч];
		СтруктураДанных = КЗ.Значение;
		ТаблицаПравоУсловноеОформлениеПоля(выбПолеЗначение, СтруктураДанных);
		Сч = Сч + 1;
	КонецЦикла;
	
	Если МассивЗначений.Количество() > 1 Тогда
		ПолеЗначение1.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДанныеСодержатЗначения(Данные) 
	
	Если Данные = Неопределено Или Данные.Свойство("СодержитЗначения") = Ложь Или Данные.СодержитЗначения = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Данные.Свойство("Значение0") = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Данные.Значение0.ТипЗначения) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПолучитьМассивЗначенийДанных(Данные) 
	
	Массив = Новый Массив;
	
	Если Не ДанныеСодержатЗначения(Данные) Тогда
		Возврат Массив;
	КонецЕсли;
	
	Для каждого КЗ Из Данные Цикл
		Если КЗ.Ключ = "СодержитЗначения" Тогда
			Продолжить;
		КонецЕсли;
		Массив.Добавить(КЗ);	
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

&НаКлиенте
Процедура ТаблицаПравоУсловноеОформлениеПоля(Поле, СтруктураДанных) 
	
	ТипЗначения = СтруктураДанных.ТипЗначения;
	
	
	Если ТипЗначения = "Строка" Тогда
		Поле.РедактированиеТекста = Истина;
		
	ИначеЕсли ТипЗначения = "Список" Тогда
		СписокДоступныхЗначений = СтруктураДанных.СписокВыбора;
		
		СписокВыбора = СтрРазделить(СписокДоступныхЗначений, ";", Ложь);
		
		Поле.КнопкаВыпадающегоСписка = Истина;
		Поле.СписокВыбора.ЗагрузитьЗначения(СписокВыбора); 
	ИначеЕсли Лев(ТипЗначения, 6) = "Диалог" Тогда
		Поле.КнопкаВыбора = Истина;
		Поле.РедактированиеТекста = Истина;

	ИначеЕсли ТипЗначения = "Расширения" Тогда
		Если СписокРасширений = Неопределено Тогда
			ОбновитьСписокРасширений();
		КонецЕсли;
		
		//СписокВыбора = СписокРасширений.ВыгрузитьЗначения();
		
		Поле.КнопкаВыпадающегоСписка = Истина;
		Поле.РедактированиеТекста = Истина;
		//Поле.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
		ТаблицаПравоОбновитьСписокВыбораРасширений();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Лог(Знач Текст, Дописывать = Истина) 
	
	Путь = КаталогЭтойОбработки + "log.txt";
	
	ТекстДок = Новый ТекстовыйДокумент;
	
	Если Дописывать Тогда
		Файл = Новый Файл(Путь);
		
		Если Файл.Существует() Тогда
			ТекстДок.Прочитать(Путь);
			Текст = ТекстДок.ПолучитьТекст() + Символы.ПС + XMLСтрока(ТекущаяДата()) + Символы.ПС + Текст;
		КонецЕсли;
		
	КонецЕсли;
	
	
	ТекстДок.УстановитьТекст(XMLСтрока(ТекущаяДата()) + Символы.ПС + Текст);
	ТекстДок.Записать(Путь, КодировкаТекста.ANSI);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПравоЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СообщениеОтладки("ТаблицаПраво НачалоВыбора");
	
	Строка = ТаблицаПраво.НайтиПоИдентификатору(Элементы.ТаблицаПраво.ТекущаяСтрока);

	Индекс = ТаблицаПраво.Индекс(Строка);
	
	ИмяКолонки = Сред(Элемент.Имя, СтрДлина("ТаблицаПраво") + 1);
	
	Если Элемент.КнопкаВыбора = Истина Тогда
		
		РежимВыбора = РежимДиалогаВыбораФайла[Строка.Данные[ИмяКолонки].РежимДиалога];
		
		ПараметрыДиалога = Новый Структура("РежимДиалогаВыбора, НачальныйКаталог, Фильтр");
		ПараметрыДиалога.Вставить("РежимДиалогаВыбора", РежимВыбора);
		ПараметрыДиалога.Вставить("НачальныйКаталог", "");
		ПараметрыДиалога.Вставить("Фильтр", Строка.Данные[ИмяКолонки].ФильтрДиалога);
		
		ВыбратьФайлИлиКаталог("ТаблицаПраво[" + XMLСтрока(Индекс) + "]." + ИмяКолонки, ПараметрыДиалога);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокРасширений() Экспорт 
	
	СписокРасширений = Новый СписокЗначений;
	СписокРасширений.Добавить("Список расширений загружается...");
	ТаблицаПравоОбновитьСписокВыбораРасширений();
	
	ПодключитьОбработчикОжидания("ОбновитьСписокРасширенийОтложенное", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПравоОбновитьСписокВыбораРасширений() 
	
	Если Элементы.ТаблицаПраво.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ТаблицаПраво.ТекущиеДанные.Параметр = "-Extension" Тогда
		Элементы.ТаблицаПравоЗначение0.СписокВыбора.Очистить();
		Для каждого Расш Из СписокРасширений Цикл
			Элементы.ТаблицаПравоЗначение0.СписокВыбора.Добавить(Расш.Значение, Расш.Представление);
		КонецЦикла;
		Если СписокРасширений.Количество() = 0 Тогда
			Элементы.ТаблицаПравоЗначение0.СписокВыбора.Добавить("Нет расширений");
		КонецЕсли;
		
		Элементы.ТаблицаПраво.ЗакончитьРедактированиеСтроки(Истина);
		Элементы.ТаблицаПраво.ЗакончитьРедактированиеСтроки(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтрокаСоединенияВедетКЭтойБазе() 
	
	СтрокаСоединенияЭтойБазы = СтрокаСоединенияИнформационнойБазы();
	
	Соотв = Новый Соответствие;
	Соотв.Вставить(1, "ПоИмениБазы");
	Соотв.Вставить(2, "КлиентСервер");
	Соотв.Вставить(3, "Файловый");
	Соотв.Вставить(4, "ПоСтрокеСоединения");
	
	Результат = Соотв[ВариантЗапуска];
	
	Если ВариантЗапуска = 1 Тогда
		ФайлСписка = ИмяФайлаСпискаИнфобазПользователяОС();
		выбСтрокаСоединения = ПолучитьСтрокуСоединенияИзСпискаБаз(ФайлСписка);
		
		Возврат ВРЕГ(СтрокаСоединенияЭтойБазы) = ВРЕГ(выбСтрокаСоединения);
	ИначеЕсли ВариантЗапуска = 2 Тогда
		Возврат ВРЕГ(СтрокаСоединенияЭтойБазы) = ВРЕГ(СтрокаСоединения);
	ИначеЕсли ВариантЗапуска = 3 Тогда
		Возврат ВРЕГ(СтрокаСоединенияЭтойБазы) = ВРЕГ(СтрокаСоединения);
	ИначеЕсли ВариантЗапуска = 4 Тогда
		Возврат СтрНайти(СтрокаСоединения, СтрокаСоединенияЭтойБазы) > 0;
	Иначе
		ВызватьИсключение("Данный вариант запуска не предусмотрен");
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
