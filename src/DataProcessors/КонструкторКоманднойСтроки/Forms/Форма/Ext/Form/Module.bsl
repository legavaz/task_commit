// WshShell.Run(СтрокаЗапуска, СкрыватьОкно, bWaitOnReturn)
//
// Скрывать окно – является необязательным, и задает стиль окна. Параметр может принимать целые значения от 0 до 10. Согласно документации, в языке vbscript можно использовать именованные константы, но, они не всегда дают ожидаемый результат, и так как эти значения между собой повторяются, я упомянул лишь три:
//
// 0 – скрывает окно, будет виден только процесс в диспетчере задач.
// 1 – нормальный режим
// 2 – свернутый вид
// 3 – развернутый вид
//
//bWaitOnReturn – может принимать 
//   Истина – сценарий будет ожидать завершения работы запущенного приложения, и только потом перейдет к выполнению следующей строчки кода, 
//   Ложь   – будет продолжатся выполнение сценария независимо от того, завершилась работа запущенного приложения или нет
&НаКлиенте
Процедура Запустить(Команда)
	
	СтрокаЗапуска = ПолучитьСтрокуЗапуска(ВсяСтрокаЗапуска);
	
	WshShell = Новый COMОбъект("WScript.Shell");
	
	
	Если РежимЗапуска = "DESIGNER" Тогда
		ОжидатьЗавершения = -1; 			//истина
	ИначеЕсли РежимЗапуска = "ENTERPRISE" Или СтрНайти(СтрокаЗапуска, "/AgentMode") > 0 Тогда
		ОжидатьЗавершения = 0;				//ложь
	КонецЕсли;
	
	WshShell.Run(Строка(СтрокаЗапуска), 0, ОжидатьЗавершения);

	
	
	ПутьКФайлуЛога = ПутьКФайлуЛога();
	Если ЗначениеЗаполнено(ПутьКФайлуЛога) Тогда
		ТД = Новый ТекстовыйДокумент;
		
		ДополнительныеПараметры = Новый Структура("ТекстДок", ТД);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЧтенияФайлаЛога", ЭтотОбъект, ДополнительныеПараметры);
		
		ТД.НачатьЧтение(ОписаниеОповещения, ПутьКФайлуЛога, КодировкаТекста.UTF8);
		
	Иначе
		
		Если Не ВводДоступен() Тогда
			ОткрытьЗначениеВОтдельнойФорме("Выполнение команды завершено");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

