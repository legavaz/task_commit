&НаКлиенте
Процедура ТаблицаПравоВыполнитьВыборЗначения() 
	
	ВыбраннаяСтрока = Элементы.ТаблицаПраво.ТекущаяСтрока;
	Поле = Элементы.ТаблицаПраво.ТекущийЭлемент;
	
	Если Поле.Имя = "ТаблицаПравоПараметр" Тогда
		Возврат;
	КонецЕсли;
	ИмяКолонки = Сред(Поле.Имя, СтрДлина("ТаблицаПраво") + 1);
	
	ИмяКолонки = Сред(Поле.Имя, СтрДлина("ТаблицаПраво") + 1);
	
	
	Строка = ТаблицаПраво.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если ДанныеСодержатЗначения(Строка.Данные) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Значение = Строка.Данные[ИмяКолонки];
	
	Если Значение.ТипЗначения = "Диалог" Тогда
		РежимДиалога = РежимДиалогаВыбораФайла[Значение.РежимДиалога];
		
		ПараметрыДиалога = Новый Структура("РежимДиалогаВыбора, НачальныйКаталог, Фильтр");
		ПараметрыДиалога.Вставить("РежимДиалогаВыбора", РежимДиалога);
		ПараметрыДиалога.Вставить("НачальныйКаталог", "");
		ПараметрыДиалога.Вставить("Фильтр", Значение.ФильтрДиалога); 
		
		ВыбратьФайлИлиКаталог("Элементы.ТаблицаПраво.ТекущиеДанные." + ИмяКолонки, ПараметрыДиалога);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СортироватьПоИдентификатору() 
	
	Строки = Новый Массив;	
	ТЗКолонки = ТаблицаПраво.Выгрузить(Строки);
	
	ТЗ_ДополнительныеПараметры = ТЗКолонки.СкопироватьКолонки();
	ТЗ_ОсновныеПараметры       = ТЗКолонки.СкопироватьКолонки();
	ТЗ_ПараметрыСоединения     = ТЗКолонки.СкопироватьКолонки();
	
	
	Для каждого Строка Из ТаблицаПраво Цикл
		СтрокаЛево = ТаблицаЛево.НайтиПоИдентификатору(Строка.КлючСвязиЛево);
		
		
		Родитель = СтрокаЛево.ПолучитьРодителя();
		РодительРодитель = Родитель.ПолучитьРодителя();
		
		Если ВГруппе(СтрокаЛево, "Вспомогательные параметры")
			Или ВГруппе(СтрокаЛево, "16. Прочие параметры") 
			Или ВГруппе(СтрокаЛево, "Прочие параметры") Тогда
			НовСтрока = ТЗ_ДополнительныеПараметры.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
		ИначеЕсли ВГруппе(СтрокаЛево, "Параметры запуска") Тогда
			НовСтрока = ТЗ_ПараметрыСоединения.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
		Иначе
			НовСтрока = ТЗ_ОсновныеПараметры.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
		КонецЕсли;
	КонецЦикла;
	
	ТЗ_ПараметрыСоединения.Сортировать("КлючСвязиЛево");
	ТЗ_ОсновныеПараметры.Сортировать("КлючСвязиЛево");
	
	// если есть параметр /UpdateDBCfg, то переместить его вниз основной таблицы с потомками
	КоличествоСмещенных = 0;
	Для Сч = 1 - ТЗ_ОсновныеПараметры.Количество() По 0 Цикл
		Индекс = -Сч;
		Строка = ТЗ_ОсновныеПараметры[Индекс];
		Родитель = ТаблицаЛево.НайтиПоИдентификатору(Строка.КлючСвязиЛево).ПолучитьРодителя();
		Если Родитель.Параметр = "/UpdateDBCfg" Или Строка.Параметр = "/UpdateDBCfg" Тогда
			ТЗ_ОсновныеПараметры.Сдвинуть(Индекс, ТЗ_ОсновныеПараметры.Количество() - Индекс - 1 - КоличествоСмещенных);
			КоличествоСмещенных = КоличествоСмещенных + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТЗ_ДополнительныеПараметры.Сортировать("КлючСвязиЛево");
	
	ТаблицаПраво.Очистить();
	Для каждого Строка Из ТЗ_ПараметрыСоединения Цикл
		НовСтрока = ТаблицаПраво.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
	КонецЦикла;
	
	Для каждого Строка Из ТЗ_ОсновныеПараметры Цикл
		НовСтрока = ТаблицаПраво.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
	КонецЦикла;
	
	Для каждого Строка Из ТЗ_ДополнительныеПараметры Цикл
		НовСтрока = ТаблицаПраво.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаСекцииПараметра(СтрокаПраво) 
	
	СтрокаЛево = ТаблицаЛево.НайтиПоИдентификатору(СтрокаПраво.КлючСвязиЛево);
	
	Родитель = СтрокаЛево.ПолучитьРодителя();
	РодительРодитель = Родитель.ПолучитьРодителя();
	
	Если СтрокаЛево.Параметр = "/@" Тогда
		Возврат "ТЗ_ОсновныеПараметры";
	ИначеЕсли Родитель.Параметр = "Вспомогательные параметры"
		Или Родитель.Параметр = "16. Прочие параметры"
		Или Родитель.Параметр = "Прочие параметры" Тогда
		Возврат "ТЗ_ДополнительныеПараметры"
	ИначеЕсли РодительРодитель <> Неопределено И РодительРодитель.Параметр = "Параметры запуска" Тогда
		Возврат "ТЗ_ПараметрыСоединения";
	Иначе
		Возврат "ТЗ_ОсновныеПараметры";
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ВГруппе(СтрокаДерева, ИмяГруппы) 
	
	Родитель = СтрокаДерева.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Родитель.Параметр = ИмяГруппы Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ВГруппе(Родитель, ИмяГруппы);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура МассивСокрЛП(Массив) 
	
	Для Сч = 0 По Массив.Вграница() Цикл
		Массив[Сч] = СокрЛП(Массив[Сч]);
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Функция СледующийПараметр(Строка) 
	
	Индекс = ТаблицаПраво.Индекс(Строка);
	
	Если Индекс = ТаблицаПраво.Количество() - 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаПраво[Индекс + 1].Параметр;
	
КонецФункции

&НаСервере
Функция ПроверитьОбязательныеПараметры(СтрокаОбязательные) 
	
	МассивИ_ИЛИ = СтрРазделить(СтрокаОбязательные, "[]", Ложь);
	МассивИ2 = Новый Массив;
	Ошибки = Новый Массив;
	
	Для каждого ЭлИ_ИЛИ Из МассивИ_ИЛИ Цикл
		МассивИ = СтрРазделить(ЭлИ_ИЛИ, ";", Ложь);
		Для каждого ЭлИ Из МассивИ Цикл
			МассивИЛИ = СтрРазделить(ЭлИ, "|", Ложь);
			МассивСокрЛП(МассивИЛИ);
			МассивИ2.Добавить(МассивИЛИ);
		КонецЦикла;		
	КонецЦикла;
	
	
	Для каждого ЭлИ2 Из МассивИ2 Цикл
		НайденоИЛИ = Ложь;
		
		
		МассивЗначений = Новый Массив;	
		Для каждого ЭлИЛИ Из ЭлИ2 Цикл
			
			ЧастиУсловия = СтрРазделить(ЭлИЛИ, "=", Ложь);
			МассивСокрЛП(ЧастиУсловия);
			Для каждого Строка Из ТаблицаПраво Цикл
				
				
				
				Если Строка.Параметр = ЧастиУсловия[0] Тогда
					Если ЧастиУсловия.Количество() > 1 Тогда
						Если ЧастиУсловия[1] = Строка.Значение0 Или ЧастиУсловия[1] = Строка.Значение1
							Или СледующийПараметр(Строка) = ЧастиУсловия[1] Тогда
							НайденоИЛИ = Истина;
							Перейти ~ВыходИзДвойногоЦикла;
						КонецЕсли;
					Иначе
						НайденоИЛИ = Истина;
						Перейти ~ВыходИзДвойногоЦикла;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЧастиУсловия.Количество() > 1 Тогда
				Точка = Символ(9679);
				МассивЗначений.Добавить("    " + Точка + "  " + ЧастиУсловия[1]);
			Иначе
				МассивЗначений.Добавить("    " + Точка + "  " + ЧастиУсловия[0]);
			КонецЕсли;
			
		КонецЦикла;
		
		Если НайденоИЛИ = Ложь Тогда
			Если ЧастиУсловия.Количество() > 1 Тогда
				Значения = СтрСоединить(МассивЗначений, Символы.ПС);
				Если МассивЗначений.Количество() = 1 Тогда
					Значение = СтрЗаменить(Значения, "    " + Точка + "  ", ""); 
					Ошибки.Добавить("Сначала нужно добавить значение " + Значение + ";параметра " + ЧастиУсловия[0]);
				Иначе
					Ошибки.Добавить("Сначала нужно добавить одно из значений:;" + Символы.ПС + Значения + Символы.ПС + Символы.ПС + "параметра " + ЧастиУсловия[0]);
				КонецЕсли;
				
			Иначе
				Ошибки.Добавить("Сначала нужно добавить параметр: " + ЭлИЛИ);
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;	
		
		~ВыходИзДвойногоЦикла:
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

&НаСервере
Функция МожноДобавитьПараметрСвойство(СтрокаДереваЛево) 
	
	Ошибки = Новый Массив;
	
	//0. Отсутствует обязательный параметр слева
	Обязательные = СтрокаДереваЛево.ОбязательныеПараметрыСлева;
	Массив = СтрРазделить(Обязательные, ";", Ложь);
	МассивСокрЛП(Массив);
	
	Ошибки = ПроверитьОбязательныеПараметры(Обязательные);
	
	Если Ошибки.Количество() > 0 Тогда
		Возврат Ошибки;
	КонецЕсли;
	
	//1. Определить, в какую секцию попадет параметр - ПараметрыСоединения, ОсновныеПараметры, ДополнительныеПараметры
	
	Строки = Новый Массив;	
	ТЗ_Все = ТаблицаПраво.Выгрузить();
	
	ТЗ_ДополнительныеПараметры = ТЗ_Все.СкопироватьКолонки();
	ТЗ_ОсновныеПараметры       = ТЗ_Все.СкопироватьКолонки();
	ТЗ_ПараметрыСоединения     = ТЗ_Все.СкопироватьКолонки();
	
	Данные = СтрокаДереваЛево.СтруктураЗначенияПараметра;
	
	НоваяСтрока = ТЗ_Все.Добавить();
	НоваяСтрока.КлючСвязиЛево = СтрокаДереваЛево.КлючСвязиЛево;
	НоваяСтрока.Параметр = СтрокаДереваЛево.Параметр;
	НоваяСтрока.Данные = Данные;
	
	Если Данные <> Неопределено Тогда
		Если Данные.Свойство("Значение0") Тогда
			Данные.Значение0.Свойство("ВозможноПустое", НоваяСтрока.ВозможноПустоеЗначение0);
		КонецЕсли;
		Если Данные.Свойство("Значение1") Тогда
			Данные.Значение1.Свойство("ВозможноПустое", НоваяСтрока.ВозможноПустоеЗначение1);
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаСекцииПараметра = ТаблицаСекцииПараметра(НоваяСтрока);
	
	
	Массив = ПолучитьПодсказкиВвода(СтрокаДереваЛево);
	Для Сч = 0 По Массив.ВГраница() Цикл
		НоваяСтрока["ПодсказкаВвода" + Сч] = Массив[Сч];
	КонецЦикла;
	
	
	Для каждого Строка Из ТЗ_Все Цикл
		выбТаблицаСекцииПараметра = ТаблицаСекцииПараметра(Строка);
		Табл = Вычислить(выбТаблицаСекцииПараметра);
		
		НовСтрока = Табл.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
		
	КонецЦикла;
	
	
	
	
	//2. Отсортировать
	ТЗ_ПараметрыСоединения.Сортировать("КлючСвязиЛево");
	ТЗ_ОсновныеПараметры.Сортировать("КлючСвязиЛево");
	ТЗ_ДополнительныеПараметры.Сортировать("КлючСвязиЛево");
	
	
	//3. Проверить параметры из своей секции на исключающие параметры этого параметра
	ИсключающиеПараметры = СтрокаДереваЛево.ИсключающиеПараметры;
	Массив = СтрРазделить(ИсключающиеПараметры, ";", Ложь);
	
	
	Ошибки = Новый Массив;
	Для каждого Эл Из Массив Цикл

			Табл = Вычислить(ТаблицаСекцииПараметра);
			ТекОшибки = КонфликтующиеПараметрыВТаблице(Табл, СтрокаДереваЛево.Параметр, Эл);
			Для каждого Эл Из ТекОшибки Цикл
				Ошибки.Добавить(Эл);
			КонецЦикла;
					

	КонецЦикла;	
	
	Возврат Ошибки;
	
КонецФункции

&НаСервере
Функция КонфликтующиеПараметрыВТаблице(Таблица, выбПараметр, ИсключающийПараметр) 
	
	Ошибки = Новый Массив;
	
	Для каждого Строка Из Таблица Цикл
		Если Строка.Параметр = выбПараметр Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИсключающийПараметр = Строка.Параметр Тогда
			Ошибка = "Параметры " + выбПараметр + " и " + Строка.Параметр + ";не могут присутствовать одновременно";
			Ошибки.Добавить(Ошибка);
			Возврат Ошибки;
		КонецЕсли;
		
		Если ИсключающийПараметр = "[Все]" И СтрНачинаетсяС(Строка.Параметр, "/") Тогда
			Ошибка = "Параметры " + выбПараметр + " и " + Строка.Параметр + ";не могут присутствовать одновременно";
			Ошибки.Добавить(Ошибка);
			Возврат Ошибки;
		КонецЕсли;
		
			
		Если СтрНайти(ИсключающийПараметр, "=") > 0 Тогда	
			Результат = Вычислить(ИсключающийПараметр);
			Если Результат = Истина Тогда
				Ошибка = "Нельзя добавить параметр, т.к. " + ИсключающийПараметр;
				Ошибки.Добавить(Ошибка);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

// Вспомогательная функция
&НаКлиенте
Функция НайтиЗначениеВДереве(Коллекция, ИмяСвойства, Значение)
	
	Массив = Новый Массив;
	
	Для каждого Строка Из Коллекция Цикл
		Если СтрНайти(Строка[ИмяСвойства], Значение) > 0 Тогда
			Массив.Добавить(Строка);
		КонецЕсли;
		Подчиненные = Строка.ПолучитьЭлементы();
		Если Подчиненные.Количество() > 0 Тогда
			МассивПодчиненных = НайтиЗначениеВДереве(Подчиненные, ИмяСвойства, Значение);
			Для каждого Эл Из МассивПодчиненных Цикл
				Массив.Добавить(Эл);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

