&НаКлиенте
Процедура УдалитьСПодчиненными() 
	
	Строка = Элементы.ТаблицаПраво.ТекущиеДанные;
	
	СтрокаЛево = ТаблицаЛево.НайтиПоИдентификатору(Строка.КлючСвязиЛево);
	
	Подчиненные = СтрокаЛево.ПолучитьЭлементы();
	
	МассивУдалить = Новый Массив;
	Для каждого Эл Из Подчиненные Цикл
		Для каждого СтрокаТЧ Из ТаблицаПраво Цикл
			Если Эл.ПолучитьИдентификатор() = СтрокаТЧ.КлючСвязиЛево Тогда
				МассивУдалить.Добавить(СтрокаТЧ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для каждого Эл Из МассивУдалить Цикл
		ТаблицаПраво.Удалить(Эл);
	КонецЦикла;
	
КонецПроцедуры

