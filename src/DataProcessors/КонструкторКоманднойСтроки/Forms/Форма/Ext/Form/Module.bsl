&НаКлиенте
Процедура Копировать(Команда) 
	
	ТекстКопирования = СтрЗаменить(ВсяСтрокаЗапуска, "Пароль скрыт", РасшифроватьBase64(Пароль));
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстКопирования);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	
	ДопПараметры = Новый Структура("ИмяВременногоФайла, Текст", ИмяВременногоФайла, ТекстКопирования); 
	ОписаниеОповещения = Новый ОписаниеОповещения("ВремФайлЗаписьЗавершение", ЭтотОбъект, ДопПараметры);
	
	ТекстовыйДокумент.НачатьЗапись(ОписаниеОповещения, ИмяВременногоФайла, КодировкаТекста.ANSI, Символы.ПС);
	
КонецПроцедуры

&НаКлиенте
Процедура ВремФайлЗаписьЗавершение(Результат, ДопПараметры) Экспорт 
	
	WScriptShell = Новый COMОбъект("WScript.Shell");
	
	Попытка
	СтрокаЗапуска = "powershell -c Get-Content """ + ДопПараметры.ИмяВременногоФайла + """ | Set-Clipboard";
	WScriptShell.Run(СтрокаЗапуска, 0, Истина);
	Исключение
		ПоказатьОповещениеПользователя("Не удалось скопировать текст в буфер обмена");
	КонецПопытки;
	
	НачатьУдалениеФайлов(, ДопПараметры.ИмяВременногоФайла);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокуЗапуска(СтрокаЗапуска) 
	
	Если СтрНайти(СтрокаЗапуска, "Пароль скрыт") > 0 Тогда
		Возврат СтрЗаменить(СтрокаЗапуска, "Пароль скрыт", РасшифроватьBase64(Пароль));
	Иначе
		Возврат СтрокаЗапуска;
	КонецЕсли;
	
	
КонецФункции

&НаКлиенте
Функция РасшифроватьBase64(Строка) Экспорт
	
	Двоичные = Base64Значение(Строка);
	
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	Поток = Двоичные.ОткрытьПотокДляЧтения();
	
	
	ЧтениеТекста = Новый ЧтениеТекста(Поток, КодировкаТекста.UTF8);
	Стр = ЧтениеТекста.ПрочитатьСтроку();
	ЧтениеТекста.Закрыть();
	
	Поток.Закрыть();
	
    Возврат Стр;
    
КонецФункции

