&НаКлиенте
Функция ВидимостьСоотвествуетУсловиям(Параметр, УсловияВидимости) 
	
	Видимость = Истина;
	
	// КОНСТАНТЫ УСЛОВИЙ ВИДИМОСТИ
	//ЭтоФайловаяБаза - реквизит формы, уже заполнена	
	//--
	
	
	
	Массив = СтрРазделить(УсловияВидимости, ";", Ложь);
	
	Для каждого Эл Из Массив Цикл
		Попытка
			Видимость = Видимость И Вычислить(Эл);
		Исключение
			Сообщить("Ошибка в условиях параметра " + Параметр + " " + Эл, СтатусСообщения.Внимание);
		КонецПопытки;
			
	КонецЦикла;
	
	Возврат Видимость;
	
КонецФункции

