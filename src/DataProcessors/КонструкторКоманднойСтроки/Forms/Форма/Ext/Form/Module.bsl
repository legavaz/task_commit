&НаКлиенте
Процедура ПроверкаНаличияФайлаДампРезультата() Экспорт 
	
	Лог("ПроверкаНаличияФайлаДампРезультата");
	ФайлДампаДоступен = ФайлДоступенДляЧтения(ПутьКФайлуДампРезультата);
	
	Если ФайлДампаДоступен <> Истина Тогда
		ПодключитьОбработчикОжидания("ПроверкаНаличияФайлаДампРезультата", 1, Истина);
		Возврат;
	КонецЕсли;
		
	ТД = Новый ТекстовыйДокумент;
		
	ДопПараметры = Новый Структура("ТекстДок, ПутьКФайлу", ТД, ПутьКФайлуДампРезультата);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЧтениеФайлаДампРезультатаЗавершение", ЭтотОбъект, ДопПараметры);
	
	ТД.НачатьЧтение(ОписаниеОповещения, ПутьКФайлуДампРезультата, КодировкаТекста.UTF8);
	
КонецПроцедуры

&НаКлиенте
Процедура ЧтениеФайлаДампРезультатаЗавершение(ДопПараметры) Экспорт
	
	ДампРезультата = ДампРезультата(ДопПараметры.ПутьКФайлу, ДопПараметры.ТекстДок);
	Лог("ЧтениеФайлаДампРезультатаЗавершение. Результат " + ДампРезультата);
	Если ДампРезультата = Истина Тогда
		ПроверкаНаличияФайлаЛогаРасширения();
	Иначе
		СписокРасширений.Очистить();
		СписокРасширений.Добавить("Не удалось получить список расширений");
		ТаблицаПравоОбновитьСписокВыбораРасширений();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаНаличияФайлаЛогаРасширения() Экспорт 
	
	ФайлЛогаДоступен = ФайлДоступенДляЧтения(ПутьКФайлуЛогаРасширения);
	
	Если ФайлЛогаДоступен <> Истина Тогда
		ПодключитьОбработчикОжидания("ПроверкаНаличияФайлаЛогаРасширения", 1, Истина);
		Возврат;
	КонецЕсли;
		
	ТД = Новый ТекстовыйДокумент;
		
	ДопПараметры = Новый Структура("ТекстДок, ПутьКФайлу", ТД, ПутьКФайлуЛогаРасширения);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЧтениеФайлаЛогаРасширенияЗавершение", ЭтотОбъект, ДопПараметры);
	
	ТД.НачатьЧтение(ОписаниеОповещения, ПутьКФайлуЛогаРасширения, КодировкаТекста.UTF8);
	
КонецПроцедуры

&НаКлиенте
Процедура ЧтениеФайлаЛогаРасширенияЗавершение(ДопПараметры) Экспорт
	
	ТекстДок = ДопПараметры.ТекстДок;

	СписокРасширений.Очистить();
	Для Сч = 1 По ТекстДок.КоличествоСтрок() Цикл
		СписокРасширений.Добавить(ТекстДок.ПолучитьСтроку(Сч));
	КонецЦикла;
	Если ПервоеЗначение(СписокРасширений) <> Неопределено И ПервоеЗначение(СписокРасширений).Значение = "Список расширений загружается..." Тогда
		СписокРасширений.Удалить(0);
	КонецЕсли;
	
	
	Если Элементы.ТаблицаПраво.ТекущиеДанные <> Неопределено И Элементы.ТаблицаПраво.ТекущиеДанные.Данные.СодержитЗначения И Элементы.ТаблицаПраво.ТекущиеДанные.Данные.Значение0.ТипЗначения = "Расширения" Тогда
		Элементы.ТаблицаПравоЗначение0.СписокВыбора.ЗагрузитьЗначения(СписокРасширений.ВыгрузитьЗначения());
	КонецЕсли;
	
	Если СписокРасширений.Количество() = 0 Тогда
		Элементы.ТаблицаПравоЗначение0.СписокВыбора.Очистить();
		Элементы.ТаблицаПравоЗначение0.СписокВыбора.Добавить("Нет расширений");	
	КонецЕсли;
	
	УдалитьФайлы(ДопПараметры.ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Функция ДампРезультата(выбПутьКФайлу, ТекстДок = Неопределено) 
	
	Если ТекстДок = Неопределено Тогда
		
		Файл = Новый Файл(выбПутьКФайлу);
		Если Файл.Существует() = Ложь Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.Прочитать(выбПутьКФайлу);
		
	КонецЕсли;
	
	Текст = ТекстДок.ПолучитьТекст();
	Если СокрЛП(Текст) = "0" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьФайлИлиКаталог(ИмяРеквизитаРезультатВыбора, ПараметрыДиалога)
	
	
	ДополнительныеПараметры = Новый Структура("ИмяРеквизитаРезультатВыбора", ИмяРеквизитаРезультатВыбора); 
	
	ПослеВыбораКаталога = Новый ОписаниеОповещения("ПослеВыбораКаталога", ЭтотОбъект, ДополнительныеПараметры);
	ДиалогВыбора = Новый ДиалогВыбораФайла(ПараметрыДиалога.РежимДиалогаВыбора);
	
	ДиалогВыбора.Каталог = СокрЛП(ПараметрыДиалога.НачальныйКаталог);
	ДиалогВыбора.Фильтр = ПараметрыДиалога.Фильтр;
	
	ДиалогВыбора.Показать(ПослеВыбораКаталога);
	
КонецПроцедуры
	
