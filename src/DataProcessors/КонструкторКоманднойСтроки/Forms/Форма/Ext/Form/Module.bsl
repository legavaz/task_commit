&НаКлиенте
Процедура ОбновитьСписокРасширенийОтложенное() Экспорт
	
	Если СтрокаСоединенияВедетКЭтойБазе() Тогда
		Для каждого Расш Из ПолучитьРасширенияЭтойБазыСервер() Цикл
			СписокРасширений.Добавить(Расш.Значение, Расш.Представление);
		КонецЦикла;
		Если ПервоеЗначение(СписокРасширений) <> Неопределено И ПервоеЗначение(СписокРасширений).Значение = "Список расширений загружается..." Тогда
			СписокРасширений.Удалить(0);
		КонецЕсли;
		
		ТаблицаПравоОбновитьСписокВыбораРасширений();
		Возврат;
		
	КонецЕсли;
	
	ПутьКФайлуЛогаРасширения = ПолучитьИмяВременногоФайла("txt");
	ПутьКФайлуДампРезультата = ПолучитьИмяВременногоФайла("txt");
	
	Шаблон = "%1 DESIGNER %2 /DumpDBCfgList -AllExtensions /Out %3 /DisableStartupMessages /DisableStartupDialogs /DumpResult %4";
	
	СтрокаЗапуска = СтрШаблон(Шаблон, ВКавычки(ПутьКИсполняемомуФайлу), СтрокаСоединенияИБ, ВКавычки(ПутьКФайлуЛогаРасширения), ВКавычки(ПутьКФайлуДампРезультата));
	
	СтрокаЗапуска = ПолучитьСтрокуЗапуска(СтрокаЗапуска);
	
	ОжидатьЗавершения = Ложь;
	
	Если WsShell = Неопределено Тогда
		WsShell = Новый COMОбъект("WScript.Shell");
	КонецЕсли;
	А = WsShell.Run(Строка(СтрокаЗапуска), 0, ОжидатьЗавершения);
	ПодключитьОбработчикОжидания("ПроверкаНаличияФайлаДампРезультата", 3, Истина);
	
КонецПроцедуры

&НаКлиенте
