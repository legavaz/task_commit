	HTML = Новый COMОбъект("htmlfile");
	HTML.parentWindow.clipboardData.setData("Text", ТекстКопирования,"mytext");
	HTML = Неопределено;
	
	//Если ТекстКопирования = ПрочитатьИзБуфера() Тогда
	//	Возврат;
	//КонецЕсли;
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстКопирования);
	
	ИмяВремФайла = ПолучитьИмяВременногоФайла();
	
	ДопПараметры = Новый Структура("ИмяВремФайла, Текст", ИмяВремФайла, ТекстКопирования); 
	ОписаниеОповещения = Новый ОписаниеОповещения("ВремФайлЗаписьЗавершение", ЭтотОбъект, ДопПараметры);
	
	ТекстовыйДокумент.НачатьЗапись(ОписаниеОповещения, ИмяВремФайла, КодировкаТекста.ANSI, Символы.ПС);
	
