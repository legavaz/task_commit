&НаКлиенте
Процедура ВыделитьКнопкуРежимаЗапуска()
	
	Соотв = Новый Соответствие;
	Соотв.Вставить("CREATEINFOBASE", "РежимСозданиеБазы");
	Соотв.Вставить("DESIGNER",       "РежимКонфигуратор");
	Соотв.Вставить("ENTERPRISE",     "РежимПредприятие");
	
	ИмяКнопки = Соотв.Получить(РежимЗапуска);
	ЭлементКнопка = Элементы[ИмяКнопки];
	
	Для каждого Эл Из Элементы.ГруппаКнопки.ПодчиненныеЭлементы Цикл
		Шрифт = Эл.Шрифт;
		Эл.ЦветТекста = Новый Цвет;
		Эл.Шрифт   = Новый Шрифт(Шрифт, , 10, Ложь);
		Эл.Пометка = Ложь;
	КонецЦикла;
	
	
	ЭлементКнопка.ЦветТекста = Новый Цвет(0, 180, 0);
	Шрифт = ЭлементКнопка.Шрифт;
	ЭлементКнопка.Шрифт      = Новый Шрифт(Шрифт, ,10, Истина);
	ЭлементКнопка.Пометка    = Истина;
	
КонецПроцедуры

