Функция ЗаменитьСпецСимволы(Знач Строка) 
	
	Тире = Символ(8209);
	
	Строка = СтрЗаменить(Строка, Тире, "-");
	
	Возврат Строка;
	
КонецФункции

&НаКлиенте
Функция ПоискРегулярногоВыражения(Строка, Шаблон, ТолькоПервый = Истина) 
	
	ИнициализироватьRegExp();
	
	Glob = RegExp.Global;
	
	RegExp.Pattern = Шаблон;
	RegExp.Global = Не ТолькоПервый;
	
	Результаты = RegExp.Execute(Строка);
	
	
	RegExp.Global = Glob;

						
	Структура = Новый Структура("Количество, Результаты");
	Структура.Количество = Результаты.Count;
	Структура.Результаты = Новый Структура();
	Сч = 0;
	Для каждого Результат Из Результаты Цикл
		Стру = Новый Структура("Значение, КоличествоПодчиненных, Подчиненные");
		Стру.Значение = Результат.Value;
		Стру.КоличествоПодчиненных = Результат.Submatches.Count;
		
		Стру.Подчиненные = Новый Структура("Значение");
		Сч2 = 0;
		Для каждого Подчиненный Из Результат.Submatches Цикл
			Стру.Подчиненные.Вставить("Подчиненный" + XMLСтрока(Сч2), Подчиненный);
			Сч2 = Сч2 + 1;
		КонецЦикла;
		
		Структура.Результаты.Вставить("Результат" + XMLСтрока(Сч), Стру);
		
		Сч = Сч + 1;
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПодсказкиВвода(СтрокаТаблицы) 
	
	МассивПодсказок = Новый Массив;
	СодержитЗначение = Ложь;
	
	Если СтрокаТаблицы.СтруктураЗначенияПараметра = Неопределено Тогда
		Возврат МассивПодсказок;
	КонецЕсли;
	
	Если ДанныеСодержатЗначения(СтрокаТаблицы.СтруктураЗначенияПараметра) = Ложь Тогда
		Возврат МассивПодсказок;
	КонецЕсли;
	
	
	
	СтрокаГдеИскать = СтрокаТаблицы.ШаблонКоманды;
	Если Не ЗначениеЗаполнено(СтрокаГдеИскать) Тогда
		ВызватьИсключение("Не заполнен шаблон команды");
	КонецЕсли;
	
	ПараметрГдеИскать = СтрокаТаблицы.Параметр;
	
	СтрокаГдеИскать = СтрЗаменить(СтрокаГдеИскать, "<", "*<");
	СтрокаГдеИскать = СтрЗаменить(СтрокаГдеИскать, ">", ">*");
	Массив = СтрРазделить(СтрокаГдеИскать, "*[]=" + Символ(34));
	Для Сч = 0 По Массив.ВГраница() Цикл
		Массив[Сч] = СокрЛП(Массив[Сч]);
	КонецЦикла;
	
	ИндексПараметра = Массив.Найти(ПараметрГдеИскать);
	
	Для Сч = ИндексПараметра + 1 По Массив.ВГраница() Цикл
		Строка = Массив[Сч];
		
		Если СокрЛП(Строка) = ""  Тогда
			Продолжить;
		КонецЕсли;
		
		Если Лев(Строка, 1) <> "<" Тогда
			Прервать;
		КонецЕсли;
		
		МассивПодсказок.Добавить(Строка);
	КонецЦикла;
	
	Если МассивПодсказок.Количество() > 0 Тогда
		Возврат МассивПодсказок;		
	КонецЕсли;
	
	
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("ДиалогОткрытие",      "<имя файла>");
	Соответствие.Вставить("ДиалогСохранение",    "<имя файла>");
	Соответствие.Вставить("ДиалогВыборКаталога", "<имя каталога>");
	Соответствие.Вставить("Расширение",          "<имя расширения>");
	Соответствие.Вставить("Строка",              "<значение параметра>");
	
	
	Для каждого КЗ Из СтрокаТаблицы.СтруктураЗначенияПараметра Цикл
		Если КЗ.Ключ = "СодержитЗначения" Тогда
			Продолжить;
		КонецЕсли;
		
		КлючСоотв = СокрЛП(КЗ.Значение.ТипЗначения) + СокрЛП(КЗ.Значение.РежимДиалога);
		МассивПодсказок.Добавить(Соответствие[КлючСоотв]);
		
	КонецЦикла;
	
	
	Возврат МассивПодсказок;
	
КонецФункции

&НаКлиенте
Функция НайтиКонецСлова(Строка, НачальнаяПозиция = 1)
	
	Длина = СтрДлина(Строка);
	
	Если Длина = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	СтрокаСимволов = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЬЪЭЮЯ0123456789_ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	ВРегСтрока = ВРЕГ(Строка);
	
	Для Сч = НачальнаяПозиция По Длина Цикл
		
		Символ = Сред(ВРегСтрока, Сч, 1);
		Если СтрНайти(СтрокаСимволов, Символ) = 0 Тогда
			Возврат Сч - 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Длина;
	
КонецФункции

