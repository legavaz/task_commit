&НаКлиенте
Перем RegExp, 
	КомОбъект, WsShell, 
	СписокРасширений, 
	ПутьКФайлуЛога, 
	ПутьКФайлуЛогаРасширения, 
	ПутьКФайлуДампРезультата,
	КоличествоПроверокДампРезультата,
	КоличествоПроверокЛогРасширения;

&НаКлиенте
Перем КолонкиДереваЛево, КолонкиТаблицыПраво;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Отладка = Истина;
	
	Если Не ЗначениеЗаполнено(РежимЗапуска) Тогда
		РежимЗапуска = "DESIGNER";	
	КонецЕсли;
	
	
	Колонки = Новый Структура();
	Колонки.Вставить("КолонкиДереваЛево",   КолонкиТаблицыСтрокой("ТаблицаЛево"));
	Колонки.Вставить("КолонкиТаблицыПраво", КолонкиТаблицыСтрокой("ТаблицаПраво"));
	
	ЗаполнитьРеквизитыДляКлиента();
	
	КаталогЭтойОбработки = КаталогЭтойОбработки();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(ПутьКИсполняемомуФайлу) Тогда
		ПутьКИсполняемомуФайлу = ИмяИсполняемогоФайлаКлиентаПлатформы();
	КонецЕсли;
	
	Если КлючУникальности = Неопределено Тогда
		КлючУникальности = СтрРазделить(ИмяФормы, ".", Ложь)[1] + XMLСтрока(ТекущаяДата());
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаСоединенияИБ) Тогда
		Если ЭтоФайловаяБаза() Тогда
			
			КаталогИнформационнойБазы = НСтр(СтрокаСоединенияИнформационнойБазы(), "File");
			ВариантЗапуска = 3;
			СтрокаСоединенияИБ = "/F " + ВКавычки(КаталогИнформационнойБазы);
		Иначе
			
			ИмяСервера = НСтр(СтрокаСоединенияИнформационнойБазы(), "Srvr");
			ИмяИнформационнойБазы = НСтр(СтрокаСоединенияИнформационнойБазы(), "Ref");
			ВариантЗапуска = 2;
			СтрокаСоединенияИБ = "/S " + ВКавычки(ИмяСервера + "\" + ИмяИнформационнойБазы);
		КонецЕсли;
	КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(ВариантЗапуска) Тогда
		ВариантЗапуска = 1;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		//Пользователь = ИмяПользователя();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РежимЗапуска) Тогда
		РежимЗапуска = "DESIGNER";
	КонецЕсли;
	
	Если ВерсияПлатформы = "" Тогда
		ОбновитьИспользуемуюВерсиюПлатформы();
	ИначеЕсли СтрНайти(ПутьКИсполняемомуФайлу, ВерсияПлатформы + ".") = 0 Тогда
		Заголовок = ВерсияПлатформы;
	КонецЕсли;
	
	
	ВыделитьКнопкуРежимаЗапуска();
	
	СформироватьСтрокуЗапуска();
	
	ПрочитатьФайлДерева();
	
	ОбновитьТаблицуРекомендуемые();
	
	Если Не ЗначениеЗаполнено(МасштабФормы) Тогда
		МасштабФормы = 100;
	КонецЕсли;
	Масштаб = МасштабФормы;
	
	ПодключитьОбработчикОжидания("РазвернутьПрежнююСтроку", 0.5, Истина); 
	
КонецПроцедуры

&НаСервере
Функция КолонкиТаблицыСтрокой(ТаблицаИмя) 
	
	Таблица = РеквизитФормыВЗначение(ТаблицаИмя);
	
	Массив = Новый Массив;
	
	Для каждого Колонка Из Таблица.Колонки Цикл
		Массив.Добавить(Колонка.Имя);
	КонецЦикла;
	
	Возврат СтрСоединить(Массив, ",");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРеквизитыДляКлиента() 
	
	Реквизиты = ПолучитьРеквизиты();
	
	КлючиСтруктурыРеквизита = "Заголовок, Имя, Путь, СохраняемыеДанные, ТипЗначения";
	
	РеквизитыКлиент = Новый Структура;
	Для каждого Эл Из Реквизиты Цикл
		СтруктураРеквизита = Новый Структура(КлючиСтруктурыРеквизита);
		ЗаполнитьЗначенияСвойств(СтруктураРеквизита, Эл);
		СтруктураРеквизита.ТипЗначения = Строка(Эл.ТипЗначения);
		
		РеквизитыКлиент.Вставить(Эл.Имя, СтруктураРеквизита);
		
		Если Строка(Эл.ТипЗначения) = "Таблица значений" Или Строка(Эл.ТипЗначения) = "Дерево значений" Тогда
		
			ПодчиненныеРеквизиты = ПолучитьРеквизиты(Эл.Имя);
			Для каждого Подч Из ПодчиненныеРеквизиты Цикл
				СтруктураПодчиненныхРеквизитов = Новый Структура(КлючиСтруктурыРеквизита);
				ЗаполнитьЗначенияСвойств(СтруктураПодчиненныхРеквизитов, Подч);
				
				СтруктураПодчиненныхРеквизитов.Заголовок          = Подч.Заголовок;
				СтруктураПодчиненныхРеквизитов.Имя                = Подч.Имя;
				СтруктураПодчиненныхРеквизитов.Путь               = Подч.Путь + "." + Подч.Имя;
				СтруктураПодчиненныхРеквизитов.СохраняемыеДанные  = Подч.СохраняемыеДанные;
				СтруктураПодчиненныхРеквизитов.ТипЗначения        = Строка(Подч.ТипЗначения);
				
				РеквизитыКлиент.Вставить(Эл.Имя + "__" + Подч.Имя, СтруктураПодчиненныхРеквизитов);
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПрежнююСтроку() Экспорт
	
	Если ЗначениеЗаполнено(ТекущаяСтрокаЛево) И ТаблицаЛево.НайтиПоИдентификатору(ТекущаяСтрокаЛево) <> Неопределено Тогда
		Элементы.ТаблицаЛево.Развернуть(ТекущаяСтрокаЛево);
		Элементы.ТаблицаЛево.ТекущаяСтрока = ТекущаяСтрокаЛево;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьДиалогВыбораФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогВыбораФайла()
	
	РасширениеФайла = "exe";
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьФайлЗавершение", ЭтотОбъект);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	Шаблон = "Файл %1 (*.%2)|*.%2";
	Диалог.Фильтр = СтрШаблон(Шаблон, ВРег(РасширениеФайла), РасширениеФайла);
	Диалог.Каталог = КаталогФайла(ПутьКИсполняемомуФайлу);

	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Функция КаталогФайла(выбПуть) 
	
	Если Не ЗначениеЗаполнено(выбПуть) Тогда
		Возврат "";	
	КонецЕсли;
	
	Файл = Новый Файл(выбПуть);
	Если Файл.ЭтоКаталог() Тогда
		Возврат Файл.ПолноеИмя;
	КонецЕсли;
	
	Возврат Файл.Путь;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		ПутьКИсполняемомуФайлу = ВыбранныеФайлы[0];
	КонецЕсли;
	СформироватьСтрокуЗапуска();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПараметрыСоединения(Команда)
	
	ИмяОбработки = СтрРазделить(ИмяФормы, ".", Ложь)[1];
	ИмяФормыПараметрыСоединения = "ВнешняяОбработка." + ИмяОбработки + ".Форма.ПараметрыСоединения";
	
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытиеФормыПараметрыСоединения", ЭтотОбъект);
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("АутентификацияОС",          АутентификацияОС);
	ПараметрыОткрытия.Вставить("ИмяИнформационнойБазы",     ИмяИнформационнойБазы);
	ПараметрыОткрытия.Вставить("ИмяСервера",                ИмяСервера);
	ПараметрыОткрытия.Вставить("КаталогИнформационнойБазы", КаталогИнформационнойБазы);
	ПараметрыОткрытия.Вставить("Пользователь",              Пользователь);
	ПараметрыОткрытия.Вставить("Пароль",                    Пароль);
	ПараметрыОткрытия.Вставить("ВариантЗапуска",            ВариантЗапуска);
	ПараметрыОткрытия.Вставить("ИмяБазыИзСписка",           ИмяБазыИзСписка);
	ПараметрыОткрытия.Вставить("СтрокаСоединения",          СтрокаСоединения);
	
	ОткрытьФорму(ИмяФормыПараметрыСоединения, ПараметрыОткрытия, ЭтотОбъект, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗакрытиеФормыПараметрыСоединения(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	АутентификацияОС = РезультатВыполнения.АутентификацияОС;
	ИмяИнформационнойБазы = РезультатВыполнения.ИмяИнформационнойБазы;
	ИмяСервера = РезультатВыполнения.ИмяСервера;
	КаталогИнформационнойБазы = РезультатВыполнения.КаталогИнформационнойБазы;
	Пользователь = РезультатВыполнения.Пользователь;
	Пароль = РезультатВыполнения.Пароль;
	ВариантЗапуска = РезультатВыполнения.ВариантЗапуска;
	ИмяБазыИзСписка = РезультатВыполнения.ИмяБазыИзСписка;
	СтрокаСоединения = РезультатВыполнения.СтрокаСоединения;
	
	СтрокаСоединенияИБ = СтрокаСоединенияИБ();
	
	СформироватьСтрокуЗапуска();
	
	ОбновитьСписокРасширений();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РасширениеФайла(ПутьКФайлу)
	
	Файл = Новый Файл(ПутьКФайлу);
	РасширениеФайла = Файл.Расширение;
	
	Возврат РасширениеФайла;
	
КонецФункции

&НаКлиенте
Функция ИмяИсполняемогоФайлаКлиентаПлатформы() Экспорт
	
	Результат = "1cv8";
	
	Если ЭтоУчебнаяПлатформа() Тогда
		Результат = Результат + "t";
	КонецЕсли;
	
	КаталогПрограммы = ПолучитьКаталогПрограммы();
	
	Результат = КаталогПрограммы + Результат + ".exe";

	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Функция ПолучитьКаталогПрограммы() 
	
	// При нескольких установленных платформах, КаталогПрограммы() может выдавать
	// неверный результат
	
	КаталогПрограммы = КаталогПрограммы();
	
	Инфо = Новый СистемнаяИнформация;
	
	Поз = СтрНайти(КаталогПрограммы, "\common\");
	
	Если Поз = 0 Тогда
		Возврат КаталогПрограммы;
	КонецЕсли;
	
	Поз = СтрНайти(КаталогПрограммы, Инфо.ВерсияПриложения);
	
	Если Поз = 0 Тогда
		Массив = СтрРазделить(КаталогПрограммы, "\", Ложь);
		Для каждого Эл Из Массив Цикл
			Если СтрНачинаетсяС(Эл, "8.3.") Тогда
				Эл = Инфо.ВерсияПриложения;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		времКаталогПрограммы = СтрСоединить(Массив, "\");
		
		Файл = Новый Файл(времКаталогПрограммы);
		Если Файл.Существует() Тогда
			КаталогПрограммы = времКаталогПрограммы;
			Возврат КаталогПрограммы;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КаталогПрограммы;
	
КонецФункции

&НаКлиенте
Функция ЭтоУчебнаяПлатформа() Экспорт 

	Если Не ЭтоФайловаяБаза() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("mxl");
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Записать(ВременныйФайл, ТипФайлаТабличногоДокумента.MXL7); // В учебной версии платформы это запрещено https://www.hostedredmine.com/issues/923942
	Исключение
		// Сработает при отсутствии права "Вывод" (портативный вариант) и в учебной платформе ("Ограничение используемой лицензии")
		ОписаниеОшибки = ОписаниеОшибки();
		Возврат Истина;
	КонецПопытки; 
	УдалитьФайлы(ВременныйФайл);
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция ЭтоФайловаяБаза()

	Если ВариантЗапуска = 1 Тогда       // Из списка баз
		ФайлСписка = ИмяФайлаСпискаИнфобазПользователяОС();
		выбСтрокаСоединения = ПолучитьСтрокуСоединенияИзСпискаБаз(ФайлСписка);
		
		ФайловыйКаталог = НСтр(выбСтрокаСоединения, "File");
		Результат = Не ПустаяСтрока(ФайловыйКаталог);
		Возврат Результат;
	ИначеЕсли ВариантЗапуска = 2 Тогда  // Клиент-серверный
		Возврат Ложь;
	ИначеЕсли ВариантЗапуска = 3 Тогда  // Файловый
		Возврат Истина;
	Иначе			                    // По строке соединения
		ФайловыйКаталог = НСтр(выбСтрокаСоединения, "File");
		Результат = Не ПустаяСтрока(ФайловыйКаталог);
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ИмяФайлаСпискаИнфобазПользователяОС() 
	
	Каталог = РабочийКаталогДанныхПользователя();
	AppData = Сред(Каталог, 1, СтрНайти(Каталог, "\AppData\") + 8);
	
	ИмяФайлаСписка = AppData + "Roaming\1C\1CEStart\ibases.v8i";
	Возврат ИмяФайлаСписка;

КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуСоединенияИзСпискаБаз(ФайлСпискаБаз)
 
	Файл = Новый Файл(ФайлСпискаБаз);
	ДобавленныеСтроки = Новый Массив;
	Если Не Файл.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ФайлСпискаБаз);
	
	СписокБаз = ТекстовыйДокумент.ПолучитьТекст();
	
	врем = СтрЗаменить(СписокБаз, "[", "^[");
	
	МассивОписаний = СтрРазделить(врем, "^", Ложь);
	Для каждого Эл Из МассивОписаний Цикл
		Если СтрНайти(Эл, "[" + ИмяБазыИзСписка + "]") > 0 Тогда
			ОписаниеБазы = Эл;
		КонецЕсли;
	КонецЦикла;
	
	СписокПараметров = СтрРазделить(ОписаниеБазы, Символы.ПС, Ложь);
	
	Для каждого Эл Из СписокПараметров Цикл
		Если ВРег(Лев(Эл, 8)) = "CONNECT=" Тогда
			выбСтрокаСоединения = Сред(Эл, 9);
			Возврат выбСтрокаСоединения;
		КонецЕсли;
	КонецЦикла;	
		
	Возврат "";
	
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСтрокуСоединения() 
	
	
	
КонецПроцедуры

&НаКлиенте
Функция СтрокаСоединенияИБ() 
	
	Квч = Символ(34);	
	
	Если ВариантЗапуска = 0 Тогда
		ВариантЗапуска = 1;
		Стр = "/IBName " + ВКавычки(ИмяБазыИзСписка);
	ИначеЕсли ВариантЗапуска = 1 Тогда
		Стр = "/IBName " + ВКавычки(ИмяБазыИзСписка);
	ИначеЕсли ВариантЗапуска = 2 Тогда
		Стр = "/S " + ВКавычки(ИмяСервера + "\" + ИмяИнформационнойБазы);
	ИначеЕсли ВариантЗапуска = 3 Тогда
		Стр = "/F " + ВКавычки(КаталогИнформационнойБазы);
	ИначеЕсли ВариантЗапуска = 4 Тогда
		Стр = "/IBConnectionString " + ВКавычки(СтрокаСоединения);
	КонецЕсли;
	
	Если АутентификацияОС = Истина Тогда
		Стр = Стр + " /WA+";	
	Иначе
		
		Если ЗначениеЗаполнено(Пользователь) Тогда
			Стр = Стр + " /N " + ВКавычки(Пользователь);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Пароль) Тогда
			Стр = Стр + " /P ""Пароль скрыт""";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Стр;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВКавычки(Знач Текст) 
	
	Квч = Символ(34);	
	
	Текст = СтрЗаменить(Текст, Квч + Квч, "@%Квч2%@");
	
	Текст = СтрЗаменить(Текст, Квч, Квч + Квч);
	
	Текст = СтрЗаменить(Текст, "@%Квч2%@", Квч + Квч + Квч + Квч);
	
	Возврат Квч + Текст + Квч;
	
КонецФункции

&НаКлиенте
Процедура СформироватьСтрокуЗапуска() 
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ВКавычки(ПутьКИсполняемомуФайлу));
	МассивПараметров.Добавить(" ");
	
	Если РежимЗапуска = "DESIGNER" Тогда

		МассивПараметров.Добавить(РежимЗапуска);
	ИначеЕсли РежимЗапуска = "ENTERPRISE" Тогда
		
		МассивПараметров.Добавить(РежимЗапуска);
	Иначе
		
		МассивПараметров.Добавить(РежимЗапуска);
	КонецЕсли;
	
	МассивПараметров.Добавить(" ");
	МассивПараметров.Добавить(СтрокаСоединенияИБ);
	МассивПараметров.Добавить(" ");
	
	Разделитель = "";
	
	Для каждого Строка Из ТаблицаПраво Цикл
		
		Параметр = СокрЛП(Строка.Параметр);
		
		
		Если СтрДлина(Параметр) > 1 Тогда
			МассивПараметров.Добавить(Разделитель);
		КонецЕсли;
		МассивПараметров.Добавить(Параметр);

		
		//////////   Значение1  //////////
		
		ЗначениеПараметра = СокрЛП(Строка.Значение0);
		
		Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			
			Если Строка.Данные.Значение0.ТипЗначения <> "Список"
				И СтрДлина(ЗначениеПараметра) > 1 И Не ЭтоЧисло(ЗначениеПараметра) Тогда
				
				НовЗначение = ВКавычки(ЗначениеПараметра);
				
			Иначе	
				НовЗначение = ЗначениеПараметра;
			КонецЕсли;
			
			СтрокаЛево = ТаблицаЛево.НайтиПоИдентификатору(Строка.КлючСвязиЛево);
			ШаблонКоманды = СтрокаЛево.ШаблонКоманды;
			Разделитель = ПолучитьРазделительЗначения(Параметр, ШаблонКоманды);
			Если Разделитель = Неопределено Тогда
				Если СтрДлина(НовЗначение) > 1 И Не ЭтоЧисло(НовЗначение) Тогда
					МассивПараметров.Добавить(НовЗначение);
				Иначе
					МассивПараметров.Добавить(" " + НовЗначение);
				КонецЕсли;
			Иначе
				МассивПараметров.Добавить(Разделитель + НовЗначение);	
			КонецЕсли;
			
		КонецЕсли;

		//////////   Значение2    /////////////
		
		ЗначениеПараметра = СокрЛП(Строка.Значение1);
		
		Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			
			Если Строка.Данные.Значение1.ТипЗначения <> "СписокВыбора"
				И СтрДлина(ЗначениеПараметра) > 1 Тогда
				
				НовЗначение = ВКавычки(ЗначениеПараметра);
			Иначе	
				НовЗначение = ЗначениеПараметра;
			КонецЕсли;
			
			МассивПараметров.Добавить(" " + НовЗначение);
			
		КонецЕсли;
		
		////////
		
		Разделитель = " ";
	КонецЦикла;
	
	ВсяСтрокаЗапускаДокумент.УстановитьФорматированнуюСтроку(Новый ФорматированнаяСтрока(МассивПараметров));
	ВсяСтрокаЗапуска = СокрЛП(СтрСоединить(МассивПараметров));
	
	ЭтоФайловаяБаза = ЭтоФайловаяБаза();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьРазделительЗначения(Параметр, ШаблонКоманды) 
	
	Кавычки = Символ(34);
	
	Поз = СтрНайти(ШаблонКоманды, Параметр);
	Если Поз = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПозНачала = Поз + СтрДлина(Параметр);
	
	ПозКавычки = СтрНайти(ШаблонКоманды, Кавычки, , ПозНачала);
	ПозМеньше = СтрНайти(ШаблонКоманды, "<", , ПозНачала);
	
	Если ПозМеньше = 0 И ПозКавычки = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПозКавычки = 0 Тогда
		ПозОкончания = ПозМеньше;
	ИначеЕсли ПозМеньше = 0 Тогда
		ПозОкончания = ПозКавычки;
	Иначе
		ПозОкончания = Мин(ПозМеньше, ПозКавычки);
	КонецЕсли;

	
	Если ПозОкончания - ПозНачала = 1 Тогда
		Результат = Сред(ШаблонКоманды, ПозНачала, 1);
		Возврат Результат;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

