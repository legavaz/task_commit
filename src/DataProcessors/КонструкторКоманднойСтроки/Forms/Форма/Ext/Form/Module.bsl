	Параметр = СтрРазделить(Параметр, " <", Ложь)[0];
	
	СтрокаТаблицыПраво = ПеренестиРекомендуемыйПараметр(Параметр);
	
	ТаблицаПравоУсловноеОформлениеСтроки(СтрокаТаблицыПраво);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПравоПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СообщениеОтладки("ТаблицаПраво Перетаскивание");
	
	Если ИсточникПеретаскивания = ПолучательПеретаскивания Тогда
		ТаблицаПраво.Удалить(Элемент.ТекущиеДанные);
		
		ОбновитьТаблицуРекомендуемые();
		Возврат;
	КонецЕсли;
	
	
	Если ИсточникПеретаскивания = "ТаблицаРекомендуемые" Тогда
		
		Значение = ПолучитьЗначениеПеретаскивания(ПараметрыПеретаскивания.Значение);
		
		
		ПеренестиПараметрИзРекомендуемых(Значение.Параметр);
		
	ИначеЕсли ИсточникПеретаскивания = "ТаблицаЛево" Тогда
		
		СтрокаЛево = ПолучитьЗначениеПеретаскивания(ПараметрыПеретаскивания.Значение);
		
		Структура = СтрокаДереваВСтруктуру(СтрокаЛево, Колонки.КолонкиДереваЛево);
		
		Ошибки = МожноДобавитьПараметрСвойство(Структура);
		
		Если Ошибки.Количество() > 0 Тогда
			ПоказатьОшибки(Ошибки);
			Возврат;
		КонецЕсли;
		
		ПеренестиПараметрВправо(СтрокаЛево);	
		
	КонецЕсли;
	
	СортироватьПараметры();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибки(Ошибки) 
	
	ОчиститьСообщения();
	
	Строка = СтрСоединить(Ошибки, Символы.ПС);
	
	ДополнительныеПараметры = Новый Структура(); 
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборИзМенюЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	
	Список = Новый СписокЗначений;
	Для каждого Эл Из Ошибки Цикл
		
		Массив = СтрРазделить(Эл, ";", Ложь);
		Если Массив.Количество() > 1 Тогда
			//ПоказатьОповещениеПользователя(Массив[0], , Массив[1]);
			
			Список.Добавить(Массив[0],,, БиблиотекаКартинок.Информация);
			Для каждого Эл Из СтрРазделить(Массив[1], Символы.ПС, Ложь) Цикл
				Список.Добавить(Эл);
			КонецЦикла;
			ПоказатьВыборИзМеню(ОписаниеОповещения, Список, Элементы.ТаблицаЛевоПредставление);
		Иначе
			//ПоказатьОповещениеПользователя(Строка);
			Список = Новый СписокЗначений;
			Список.Добавить(Эл,,, БиблиотекаКартинок.Информация);
			ПоказатьВыборИзМеню(ОписаниеОповещения, Список, Элементы.ТаблицаЛевоПредставление);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

