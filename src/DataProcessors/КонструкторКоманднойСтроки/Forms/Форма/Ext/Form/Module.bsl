&НаКлиенте
Процедура ЗаполнитьДерево(Коллекция, Куда) 

	Строки = Коллекция;

	Для каждого Эл Из Строки Цикл
		Если Эл.ИмяЭлемента = "Элемент" Тогда
			Строка = Куда.Добавить();
			Строка.Параметр = Эл.ПервыйДочерний.СледующийСоседний.ТекстовоеСодержимое;
			Строка.Описание = НайтиЭлементПоИмени(Эл.ДочерниеУзлы, "Представление").ТекстовоеСодержимое;
			
			Структура = Новый Структура();
			Для каждого Свойство Из Эл.ДочерниеУзлы Цикл
				Если Свойство.ИмяУзла = "Элемент" Тогда
					Продолжить;	
				КонецЕсли;
				
				Если Свойство.ИмяУзла = "СтруктураЗначенияПараметра" Тогда
					СтруктураЗначенияПараметра = ПолучитьСтруктуруЭлементов(Свойство);
					Структура.Вставить("СтруктураЗначенияПараметра", СтруктураЗначенияПараметра);
					Продолжить;
				КонецЕсли;
				
				Структура.Вставить(Свойство.ИмяУзла, Свойство.ТекстовоеСодержимое);
				
			КонецЦикла;
			Строка.Данные = Структура;
			
			ЗаполнитьДерево(Эл.ДочерниеУзлы, Строка.ПолучитьЭлементы());
		КонецЕсли;
		
		
	КонецЦикла;	
	
КонецПроцедуры

