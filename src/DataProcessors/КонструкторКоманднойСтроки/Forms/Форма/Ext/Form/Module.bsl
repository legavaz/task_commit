&НаКлиенте
Процедура ТаблицаЛевоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтрокаТаблицы = ТаблицаЛево.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	СтандартнаяОбработка = Ложь;
	
	Если Поле = Элементы.ТаблицаЛевоПараметр Тогда
		
		Структура = СтрокаДереваВСтруктуру(Элемент.ТекущиеДанные, Колонки.КолонкиДереваЛево);
		
		Если СтрокаТаблицы.ЭтоГруппа Тогда
			Возврат;
		КонецЕсли;
		
		Если ПроверитьПараметрУжеЕсть(СтрокаТаблицы.Параметр) Тогда
			Возврат;	
		КонецЕсли;
		
		Ошибки = МожноДобавитьПараметрСвойство(Структура);
		
		Если Ошибки.Количество() > 0 Тогда
			ПоказатьОшибки(Ошибки);
			Возврат;
		КонецЕсли;
		
		ПеренестиПараметрВправо(СтрокаТаблицы);
		
	ИначеЕсли Поле = Элементы.ТаблицаЛевоПредставление Тогда
		
		
		ОткрытьЗначениеВОтдельнойФорме(СтрокаТаблицы.Описание);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПараметрУжеЕсть(Параметр) 
		
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Параметр", Параметр);
	
	НайденныеСтроки = ТаблицаПраво.НайтиСтроки(СтруктураОтбора);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ТаблицаЛевоПриАктивизацииСтроки(Элемент)

	ТекДанные = Элемент.ТекущиеДанные;
	
	Элементы.ОписаниеHTML.Видимость = Ложь;
	Элементы.ОписаниеТекст.Видимость = Истина;
	
	Описание = ТекДанные.Описание;
	Возврат;
	
	//!!! HTML описания пока не реализованы
	Если ТекДанные.ЭтоГруппа = Ложь Тогда
		ОписаниеHTML = ПолучитьОписаниеHTMLИзФайла(ТекДанные.Параметр);
		Возврат;
	КонецЕсли;
	
	выбОписание = ТекДанные.Описание;

	ОписаниеHTML = ПолучитьОписаниеHTML(выбОписание); 
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОписаниеHTMLИзФайла(Параметр) 
	
	Если СтрНачинаетсяС(Параметр, "/") Или СтрНачинаетсяС(Параметр, "-") Тогда
		выбПуть = КаталогЭтойОбработки + Сред(Параметр, 2) + ".htm";
	Иначе
		выбПуть = КаталогЭтойОбработки + Параметр + ".htm";
	КонецЕсли;
	
	Файл = Новый Файл(выбПуть);
	
	Если Не Файл.Существует() Тогда
		Возврат "<html><body></body></html>";
	КонецЕсли;
	
	ТД = Новый ТекстовыйДокумент;
	ТД.Прочитать(выбПуть, КодировкаТекста.UTF8);
	Текст = ТД.ПолучитьТекст();
	
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОписаниеHTML(выбОписание)
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция ИнициализироватьRegExp();
	
	Если RegExp = Неопределено Тогда
		RegExp = Новый COMОбъект("VBScript.RegExp");
	КонецЕсли;

    RegExp.MultiLine    = Истина;
    RegExp.Global       = Ложь;   // истина — поиск по всей строке, ложь — до первого совпадения
    RegExp.IgnoreCase   = Истина;        // истина — игнорировать регистр строки при поиске

	Возврат RegExp;
	
КонецФункции

&НаКлиенте
Процедура ПеренестиПараметрВправо(СтрокаТаблицы)
	
	Данные = СтрокаТаблицы.СтруктураЗначенияПараметра;
	
		
	НоваяСтрока = ТаблицаПраво.Добавить();
	
	НоваяСтрока.КлючСвязиЛево = СтрокаТаблицы.ПолучитьИдентификатор();
	НоваяСтрока.Параметр = СтрокаТаблицы.Параметр;
	НоваяСтрока.Данные = Данные;
	
	Если Данные <> Неопределено Тогда
		Если Данные.Свойство("Значение0") Тогда
			Данные.Значение0.Свойство("ВозможноПустое", НоваяСтрока.ВозможноПустоеЗначение0);
		КонецЕсли;
		Если Данные.Свойство("Значение1") Тогда
			Данные.Значение1.Свойство("ВозможноПустое", НоваяСтрока.ВозможноПустоеЗначение1);
		КонецЕсли;
	КонецЕсли;
	
	Массив = ПолучитьПодсказкиВвода(СтрокаТаблицы);
	Для Сч = 0 По Массив.ВГраница() Цикл
		НоваяСтрока["ПодсказкаВвода" + Сч] = Массив[Сч];
	КонецЦикла;
	
	ОчиститьСообщения();

	
	ОбновитьТаблицуРекомендуемые();
	
	СортироватьПараметры();
	
	СформироватьСтрокуЗапуска();
	
КонецПроцедуры

&НаКлиенте
Функция НайтиПараметрВДереве(Параметр, Строки = Неопределено) 
	
	Если Строки = Неопределено Тогда
		Строки = ТаблицаЛево.ПолучитьЭлементы();
		
		//ищем только в ветке своего режима
		Для каждого Строка Из Строки Цикл
			Если ВРег(РежимЗапуска) = ВРег(Строка.Параметр) Тогда
				Строки = Строка.ПолучитьЭлементы();
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для каждого Строка Из Строки Цикл
		Если Строка.Параметр = Параметр Тогда
			Возврат Строка;
		КонецЕсли;
		
		Подчиненные = Строка.ПолучитьЭлементы();
		Если Подчиненные.Количество() > 0 Тогда
			выбСтрока = НайтиПараметрВДереве(Параметр, Подчиненные);
			Если выбСтрока <> Неопределено Тогда
				Возврат выбСтрока;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

