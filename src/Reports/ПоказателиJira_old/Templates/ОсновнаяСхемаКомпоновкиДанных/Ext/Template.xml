		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НЕДЕЛЯ(ЕСТЬNULL(dwh_1_jira_issues.closed_at, &amp;ТекущаяДата)) КАК Неделя,
	dwh_1_jira_issues.project_name КАК Вид,
	dwh_1_jira_issues.reporter_name КАК reporter_name,
	dwh_1_jira_issues.assignee_name КАК assignee_name,
	dwh_1_jira_issues.issue_key КАК Задача,
	dwh_1_jira_issues.customfield_10109_status КАК status,
	dwh_1_jira_issues.issue_summary КАК issue_summary,
	dwh_1_jira_issues.created_at КАК Создано,
	ЕСТЬNULL(dwh_1_jira_issues.closed_at, ДАТАВРЕМЯ(1, 1, 1)) КАК Закрыто,
	РАЗНОСТЬДАТ(dwh_1_jira_issues.created_at, ЕСТЬNULL(dwh_1_jira_issues.closed_at, dwh_1_jira_issues.created_at), ДЕНЬ) КАК День,
	1 КАК Количество,
	ВЫБОР
		КОГДА dwh_1_jira_issues.closed_at ЕСТЬ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Активная,
	dwh_1_jira_statuses.name КАК Статус
ИЗ
	ВнешнийИсточникДанных.кст_Jira_sql.Таблица.dwh_1_jira_issues КАК dwh_1_jira_issues
		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.кст_Jira_sql.Таблица.dwh_1_jira_statuses КАК dwh_1_jira_statuses
		ПО dwh_1_jira_issues.status_id = dwh_1_jira_statuses.id
ГДЕ
	(dwh_1_jira_issues.created_at МЕЖДУ &amp;НачалоПериода И &amp;ОкончаниеПериода
			ИЛИ dwh_1_jira_issues.closed_at МЕЖДУ &amp;НачалоПериода И &amp;ОкончаниеПериода
			ИЛИ dwh_1_jira_issues.closed_at ЕСТЬ NULL)</query>
	</dataSet>
