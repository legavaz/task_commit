		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	dbo_DDIPS.table_name КАК table_name,
	dbo_DDIPS.index_name КАК index_name,
	ВЫРАЗИТЬ(dbo_DDIPS.avg_fragmentation_in_percent КАК ЧИСЛО(15, 0)) КАК avg_fragmentation_in_percent,
	dbo_DDIPS.page_count КАК page_count,
	dbo_DDIPS.now КАК now
ИЗ
	ВнешнийИсточникДанных.ks_tech.Таблица.dbo_DDIPS КАК dbo_DDIPS
ГДЕ
	dbo_DDIPS.now МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
