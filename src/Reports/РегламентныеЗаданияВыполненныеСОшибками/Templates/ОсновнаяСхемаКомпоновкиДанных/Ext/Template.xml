			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Информационная база</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РаботаФоновыхЗаданий.НачалоРаботы КАК НачалоРаботы,
	РаботаФоновыхЗаданий.ОкончаниеРаботы КАК ОкончаниеРаботы,
	РаботаФоновыхЗаданий.РегламентноеЗадание КАК РегламентноеЗадание,
	РаботаФоновыхЗаданий.ОписаниеИнформацииОбОшибке КАК ОписаниеИнформацииОбОшибке,
	ЕСТЬNULL(РегламентныеЗадания.Ответственный, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК Ответственный,
	РаботаФоновыхЗаданий.ИнформационнаяБаза КАК ИнформационнаяБаза
ИЗ
	РегистрСведений.РаботаФоновыхЗаданий КАК РаботаФоновыхЗаданий
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РегламентныеЗадания КАК РегламентныеЗадания
		ПО РаботаФоновыхЗаданий.РегламентноеЗадание = РегламентныеЗадания.Ссылка
ГДЕ
	РаботаФоновыхЗаданий.СтатусРаботы = "Задание завершено с ошибками"
{ГДЕ
	(РаботаФоновыхЗаданий.НачалоРаботы &gt; &amp;НачалоРаботы),
	(РаботаФоновыхЗаданий.ОкончаниеРаботы &lt; &amp;ОкончаниеРаботы),
	(ЕСТЬNULL(РегламентныеЗадания.Ответственный, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) = &amp;Ответственный)}</query>
	</dataSet>
