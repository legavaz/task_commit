Функция ВыполнитьЗапрос(JKL)  
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	НастройкаПрокси = Неопределено;
	Порт = Неопределено;	
	Таймаут = 60;   
	jira_сервер = "sd.istk.ru"; 
	jira_токен	=	"NzQ0NzE3Mjk3ODIxOqweF2v3Lig/ACLJV36/En4fVjZJ";
	 
	
	СоединениеHTTP = Новый HTTPСоединение(jira_сервер, Порт, , , НастройкаПрокси,Таймаут, ЗащищенноеСоединение);
	НовыйЗапрос = Новый HTTPЗапрос;
	
	castom_jql = "search?jql="+JKL;
	
	НовыйЗапрос.АдресРесурса = "/rest/api/2/"+castom_jql;
	
	НовыйЗапрос.Заголовки.Вставить("Accept","application/json");
	НовыйЗапрос.Заголовки.Вставить("Content-Type","application/json");
	
	//Аутентификация BearerToken	
	ПрефиксТокена = "Bearer";
	НовыйЗапрос.Заголовки.Вставить("Authorization", ПрефиксТокена +" "+jira_токен);
	
	ВидЗапроса = "GET";
	
	НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод(ВидЗапроса, НовыйЗапрос);
	ОкончаниеВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Длительность = ОкончаниеВыполнения - НачалоВыполнения;
	
	КодСостояния = ОтветHTTP.КодСостояния;
	ТелоОтветаСтрока = ОтветHTTP.ПолучитьТелоКакСтроку();  
	
	Если КодСостояния<>200 Тогда
		Сообщить(""+КодСостояния+" ("+JKL+") "+ТелоОтветаСтрока); 
		Возврат Неопределено;
	КонецЕсли; 
	
	строка_http = ТелоОтветаСтрока; 
	
	ТелоОтветаСтрока	=	СтрЗаменить(ТелоОтветаСтрока,"48x48","key48");	
	ТелоОтветаСтрока	=	СтрЗаменить(ТелоОтветаСтрока,"24x24","key24");
	ТелоОтветаСтрока	=	СтрЗаменить(ТелоОтветаСтрока,"16x16","key16");
	ТелоОтветаСтрока	=	СтрЗаменить(ТелоОтветаСтрока,"32x32","key32");
	
	Возврат ДесереализацияJSON(ТелоОтветаСтрока); 
	
КонецФункции


