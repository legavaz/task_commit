Функция ВернутьПользователя1С(Наименование) Экспорт

	Нс = Справочники.Пользователи1С.НайтиПоНаименованию(Наименование);
	Если не ЗначениеЗаполнено(нс) Тогда
		СО = Справочники.Пользователи1С.СоздатьЭлемент();
		СО.Наименование = Наименование;
		СО.Записать();
		нс = СО.Ссылка;
	КонецЕсли;
	
	возврат Нс;	
	
КонецФункции
