Процедура ОбработатьВерсии_РазобратьМетаданные(МассивСсылокВерсий) Экспорт
		
	ТаблицаВерсийКонфигураций = ВернутьКонфигурацийПоМассивуВерсий(МассивСсылокВерсий); 
		
	мТаблица = ТаблицаВерсийКонфигураций.Скопировать(,"Конфигурация");
	мТаблица.свернуть("Конфигурация");
	
	КэшМетаданных = ПолучитьКэшМетаданныхПоКонфигурации(мТаблица.выгрузитьКолонку("Конфигурация"));
	КэшОтработанныхСсылок = Новый Массив;	
	СсылкаЭлКонфигурации = Неопределено;
	мВерсияИзмененена = Ложь;
	
	Для каждого ТекВерсии из МассивСсылокВерсий Цикл    
		Если КэшОтработанныхСсылок.Найти(ТекВерсии)<> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок = ТаблицаВерсийКонфигураций.НайтиСтроки(Новый Структура("ВерсияСсылка",ТекВерсии));
		Если МассивСтрок.количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
						
		мСостав = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекВерсии,"Состав").Выгрузить();		
		
		Для каждого ТекСтрока из МассивСтрок Цикл
			СсылкаЭлКонфигурации = ВернутьСсылкуИзКэшаМетаданных(КэшМетаданных,ТекСтрока.Конфигурация,ТекСтрока.ВерсияОбъектМетаданныхСтрокой);			
			Если не ЗначениеЗаполнено(СсылкаЭлКонфигурации) Тогда				
				СсылкаЭлКонфигурации = ВернутьСсылкуНаЭлементКонфигурации(ТекСтрока.Конфигурация,ТекСтрока.ВерсияОбъектМетаданныхСтрокой,КэшМетаданных);
			КонецЕсли;			
			
			Если не ЗначениеЗаполнено(СсылкаЭлКонфигурации) Тогда	
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не создан <%1> в конфигурации <%2>",ТекСтрока.Конфигурация,ТекСтрока.ВерсияОбъектМетаданныхСтрокой));	
				Продолжить;
			КонецЕсли;

			//Расставим в объекте данные
			МассивСтрокТЧ = мСостав.НайтиСтроки(Новый Структура("ОбъектМетаданныхСтрокой",ТекСтрока.ВерсияОбъектМетаданныхСтрокой));
			
			Для каждого ТекСтрокиТЧ из МассивСтрокТЧ Цикл
				Если ТекСтрокиТЧ.ОбъектМетаданных <> СсылкаЭлКонфигурации Тогда
					ТекСтрокиТЧ.ОбъектМетаданных = СсылкаЭлКонфигурации;
					мВерсияИзмененена = Истина;
				КонецЕсли;				
			КонецЦикла;	
			
			СсылкаЭлКонфигурации = Неопределено;			
			КэшОтработанныхСсылок.Добавить(ТекВерсии); //на случай дублирования
			
		КонецЦикла; 
		
		Если мВерсияИзмененена Тогда
			СО = ТекВерсии.ПолучитьОбъект();
			СО.Состав.загрузить(мСостав);
			СО.Записать();                  		
			мВерсияИзмененена = Ложь;		
		КонецЕсли;
		
	КонецЦикла;
		
	
	

КонецПроцедуры //<< Danilin.V 05.03.2025 SD-86203

Функция ВернутьСсылкуИзКэшаМетаданных(Кэш,Конфигурация,ПолноеИмя)
	
	Результат = Неопределено;
	МассивСтрок = Кэш.найтиСтроки(Новый Структура("Конфигурация,ПолноеИмя",Конфигурация,ПолноеИмя));
	Если МассивСтрок.Количество()>0 Тогда
		Результат = МассивСтрок[0].ссылка;
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции


Функция ВернутьСсылкуНаЭлементКонфигурации(Конфигурация,ВерсияОбъектМетаданныхСтрокой,КэшМетаданных)
	
	МассивПути = СтрРазделить(ВерсияОбъектМетаданныхСтрокой,".");
	
	мРодитель = Справочники.ЭлементКонфигурации.ПустаяСсылка();
	мПолноеИмя = "";
	мКлюч = "";
	СсылкаНаЭлементКонфигурации = Неопределено;
	
	Для каждого ТекЭлемента из МассивПути Цикл
		
		мПолноеИмя = ?(ПустаяСтрока(мПолноеИмя),ТекЭлемента,СтрШаблон("%1.%2",мПолноеИмя,ТекЭлемента));	  
		
		СсылкаНаЭлементКонфигурации = ВернутьСсылкуИзКэшаМетаданных(КэшМетаданных,Конфигурация,мПолноеИмя);
		
		Если НЕ ЗначениеЗаполнено(СсылкаНаЭлементКонфигурации) Тогда 									
			
			СО = Справочники.ЭлементКонфигурации.СоздатьЭлемент();	  
			СО.Родитель = мРодитель;
			СО.Имя = ТекЭлемента;
			со.Наименование = ТекЭлемента;
			СО.ПолноеИмя = мПолноеИмя;
			СО.Конфигурация = Конфигурация;
			СО.Записать(); 
			
			НоваяСтрока = КэшМетаданных.Добавить();		
			НоваяСтрока.Конфигурация = Конфигурация;
			НоваяСтрока.ПолноеИмя = мПолноеИмя;
			НоваяСтрока.Ссылка = СО.Ссылка;			
			
			СсылкаНаЭлементКонфигурации = СО.Ссылка;
		КонецЕсли;		
		
		мРодитель = СсылкаНаЭлементКонфигурации;	
		
	КонецЦикла; 
	
	Возврат СсылкаНаЭлементКонфигурации;
	
	
КонецФункции

Функция ВернутьКонфигурацийПоМассивуВерсий(МассивСсылокВерсий) 
	
	КонфигурацииСоответствие = новый Соответствие;	
	МассивКонфигураций = новый массив;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗД_Хранилища.Конфигурация КАК Конфигурация,
		|	ВерсииХранилищаСостав.Ссылка КАК ВерсияСсылка,
		|	ВерсииХранилищаСостав.ОбъектМетаданныхСтрокой КАК ВерсияОбъектМетаданныхСтрокой
		|ИЗ
		|	Справочник.ВерсииХранилища.Состав КАК ВерсииХранилищаСостав
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗД_Хранилища КАК ЗД_Хранилища
		|		ПО ВерсииХранилищаСостав.Ссылка.Владелец = ЗД_Хранилища.Ссылка
		|ГДЕ
		|	ВерсииХранилищаСостав.Ссылка В(&МассивСсылок)";
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылокВерсий);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();	
	РезультатЗапроса.Индексы.Добавить("ВерсияСсылка");
	
	Возврат РезультатЗапроса;
    
КонецФункции


Функция  ПолучитьКэшМетаданныхПоКонфигурации(Конфигурация)
	
	КэшМетаданных = Неопределено;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЭлементКонфигурации.ПолноеИмя КАК ПолноеИмя,
		|	ЭлементКонфигурации.Ссылка КАК Ссылка,
		|	ЭлементКонфигурации.Конфигурация КАК Конфигурация
		|ИЗ
		|	Справочник.ЭлементКонфигурации КАК ЭлементКонфигурации
		|ГДЕ
		|	ЭлементКонфигурации.Конфигурация В(&Конфигурация)
		|	И НЕ ЭлементКонфигурации.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Конфигурация", Конфигурация);
	
	КэшМетаданных = Запрос.Выполнить().Выгрузить();
	КэшМетаданных.Индексы.Добавить("ПолноеИмя,Конфигурация");
	
	
	Возврат КэшМетаданных;
	
КонецФункции


