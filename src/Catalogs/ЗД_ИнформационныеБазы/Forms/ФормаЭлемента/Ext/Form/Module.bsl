&НаСервере
Процедура ЗаполнитьСтрокуПодключения()

	мПортКластера = ?(ЗначениеЗаполнено(Объект.ПортКластера),Объект.ПортКластера,1541);
	Объект.СтрокаПодключенияБазы = СтрШаблон("/S %1:%2\%3",Объект.ИмяСервера,формат(мПортКластера,"ЧГ=0"),Объект.ИмяБазы);	
	
КонецПроцедуры

&НаСервере
Процедура ТекущийСкриптНаСервере(мСкриптСсылка)
	
	//1) сформировать скрипт
	СтруктураПеременных = новый Структура("ИБ,Ошибка",Объект.Ссылка,"");
	мТекстСкрипта = Справочники.ЗД_Скрипты.СформироватьСкрипт(мСкриптСсылка,СтруктураПеременных);
	
	Если ПустаяСтрока(СтруктураПеременных.Ошибка) Тогда
		Сообщить("-------------------------------------");
		Сообщить(мТекстСкрипта);
		Сообщить("-------------------------------------"); 
	Иначе
		Сообщить("ошибка: "+СтруктураПеременных.Ошибка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийСкрипт(Команда)
	
	ТекДанные = Элементы.Сценарий.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выделена строка",Объект.Ссылка,"Объект.Сценарий", Ложь);
		Возврат;	
	КонецЕсли;
	
	ТекущийСкриптНаСервере(ТекДанные.Скрипт);
	
КонецПроцедуры

