
&НаСервере
Процедура ОбновитьСписокНаСервере()
	Список.Параметры.УстановитьЗначениеПараметра("Конфигурация", ?(ПроизвольныеПараметрыСписков, Конфигурация, Справочники.Конфигурация.ПустаяСсылка()));
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	 ОбновитьСписокНаСервере();
КонецПроцедуры
