
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	
	Если СтрНайти(ПутьКПлатформе1С,"1cestart.exe")>0 Тогда
		Отказ = Истина;
		Сообщить("Нельзя использовать 1cestart.exe, укажите 1cv8.exe нужной версии");
	КонецЕсли;

	
КонецПроцедуры
