Процедура УдалитьУстаревшиеДанные() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГлубинаХранения.ЗнчМетаданные КАК ЗнчМетаданные,
		|	ГлубинаХранения.РеквизитПоиска КАК РеквизитПоиска,
		|	ГлубинаХранения.СрокХраненияДней КАК СрокХраненияДней
		|ИЗ
		|	РегистрСведений.ГлубинаХранения КАК ГлубинаХранения";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗнчМетаданные = ВыборкаДетальныеЗаписи.ЗнчМетаданные;
		РеквизитПоиска = ВыборкаДетальныеЗаписи.РеквизитПоиска;
		СрокХраненияДней = ВыборкаДетальныеЗаписи.СрокХраненияДней; 
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ЗнчМетаданные); 
		Если Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
			УдалитьУстаревшиеДанныеПоОтбору(ЗнчМетаданные, РеквизитПоиска, СрокХраненияДней, ОбъектМетаданных)	
		Иначе
			УдалитьУстаревшиеДанныеПоСсылкам(ЗнчМетаданные, РеквизитПоиска, СрокХраненияДней)
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры   

Процедура УдалитьУстаревшиеДанныеПоОтбору(ЗнчМетаданные, РеквизитПоиска, СрокХраненияДней, ОбъектМетаданных)
	ПоДату = НачалоДня(ТекущаяДата())- 86400 * СрокХраненияДней; 
	МИзмерения = Новый Массив;
	Если ОбъектМетаданных.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Для Каждого Изм Из ОбъектМетаданных.Измерения Цикл
			МИзмерения.Добавить(Изм.Имя);	
		КонецЦикла;
	Иначе
		МИзмерения.Добавить("Период");
		Для Каждого Изм Из ОбъектМетаданных.Измерения Цикл
			МИзмерения.Добавить(Изм.Имя);	
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос; 
	СтрИзмерения = "";
	Для Каждого Эл Из МИзмерения Цикл 
		Если СтрИзмерения = "" Тогда
			СтрИзмерения = Эл;
		Иначе
			СтрИзмерения = СтрИзмерения + ", " + Эл; 
		КонецЕсли;
	КонецЦикла;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	&СтрИзмерения
		|ИЗ
		|	&Метаданные КАК Т
		|ГДЕ
		|	&РеквизитПоиска <= &ПоДату"; 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Метаданные", ЗнчМетаданные);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеквизитПоиска", РеквизитПоиска);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтрИзмерения", СтрИзмерения);
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПоДату", ПоДату);
	ЗапросРез = Запрос.Выполнить();
	ЗапросВыб = ЗапросРез.Выбрать();
	Пока ЗапросВыб.Следующий() Цикл
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ЗнчМетаданные);
		НаборЗаписей = Менеджер.СоздатьНаборЗаписей(); 
		Для Каждого Эл Из МИзмерения Цикл
			ЗначОтбора = ЗапросВыб[Эл];
			ЭлОтбора = НаборЗаписей.Отбор[Эл];
			ЭлОтбора.Установить(ЗначОтбора);
		КонецЦикла;  
		НаборЗаписей.Записать();
	КонецЦикла;

	//ТаблицаОставляемыхЗаписей  = Запрос.Выполнить().Выгрузить(); 
	//Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ЗнчМетаданные);
	//
	//НаборЗаписей = Менеджер.СоздатьНаборЗаписей();
	//НаборЗаписей.Загрузить(ТаблицаОставляемыхЗаписей);
	//НаборЗаписей.Записать();   

	
КонецПроцедуры

Процедура УдалитьУстаревшиеДанныеПоСсылкам(ЗнчМетаданные, РеквизитПоиска, СрокХраненияДней)
	ПоДату = НачалоДня(ТекущаяДата())- 86400 * СрокХраненияДней;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	&Метаданные КАК Т
		|ГДЕ
		|	&РеквизитПоиска <= &ПоДату"; 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Метаданные", ЗнчМетаданные);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеквизитПоиска", РеквизитПоиска); 
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПоДату", ПоДату);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Попытка
			СсылкаНаОбъект = ВыборкаДетальныеЗаписи.Ссылка;
			УдаляемыйОбъект = СсылкаНаОбъект.ПолучитьОбъект();
			УдаляемыйОбъект.Удалить(); 
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры