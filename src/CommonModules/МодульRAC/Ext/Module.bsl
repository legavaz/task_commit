Функция ПолучитьТаблицуСеансовНаСервере(СтрокаПлатформа,Сервер,ИдентификаторКластера,НомерПорта,КодировкаЗаписи="cp866",КодировкаЧтения="cp866") Экспорт
	
	Если ПустаяСтрока(СтрокаПлатформа) Тогда
		СтрокаПлатформа = ПолучитьСтрокуПлатформыRAC();	
	КонецЕсли;
	
	Если ИдентификаторКластера = "" Тогда		
		ИдентификаторКластера = ПолучитьИдентификаторКластера(СтрокаПлатформа,НомерПорта,КодировкаЗаписи,КодировкаЧтения);					
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторКластера) Тогда
		
		мНомерПорта = формат(НомерПорта,"ЧЦ=4; ЧРГ=' '; ЧГ=0"); 
		СерверПорт = ?(не ПустаяСтрока(НомерПорта)," localhost:"+мНомерПорта," localhost:1545");
		СерверПорт = СтрЗаменить(СерверПорт,"localhost",Сервер);
		
		ТекущаяКоманда = СтрокаПлатформа +СерверПорт+ " session list --cluster=" + ИдентификаторКластера;
	
		СписокСеансов = ПолучитьРезультатКомандыНаСервере(ТекущаяКоманда, КодировкаЗаписи, КодировкаЧтения);
		
		МассивИнформации = СтрРазделить(СписокСеансов, Символы.ПС);
		
		ТаблицаСеансов = новый ТаблицаЗначений;
		//мКолонкиТЗ = "Сессия,Пользователь,Сервер,Кластер,Приложение,ЭтоКонфигуратор,ИмяФайла,Комплект,ИспользуетсяНаСервере,ТипЛицензии,МаксимумПользователей,PID,Описание,ПолноеОписание";
		мКолонкиТЗ = "session,cluster,sessionId,infobase,connection,process,userName,host,appId,locale,startedAt,lastActiveAt,hibernate,passiveSessionHibernateTime,hibernateSessionTerminateTime,blockedByDbms,blockedByLs,bytesAll,bytesLast5min,callsAll,callsLast5min,dbmsBytesAll,dbmsBytesLast5min,dbProcInfo,dbProcTook,dbProcTookAt,durationAll,durationAllDbms,durationCurrent,durationCurrentDbms,durationLast5min,durationLast5minDbms,memoryCurrent,memoryLast5min,memoryTotal,readCurrent,readLast5min,readTotal,writeCurrent,writeLast5min,writeTotal,durationCurrentService,durationLast5minService,durationAllService,currentServiceName,cpuTimeCurrent,cpuTimeLast5min,cpuTimeTotal,dataSeparation,clientIP";
		Для Каждого ТекЭлемента из СтрРазделить(мКолонкиТЗ,",") Цикл
			ТаблицаСеансов.Колонки.Добавить(ТекЭлемента);
		КонецЦикла;
		Для Каждого ЭлементТекст Из МассивИнформации Цикл
			МассивКолонки = СтрРазделить(ЭлементТекст, ":", Истина);
			Если МассивКолонки.Количество() > 1 Тогда
				Если СокрЛП(МассивКолонки[0]) ="session" Тогда 
					НоваяСтрока = ТаблицаСеансов.Добавить();				
					НоваяСтрока.session = СокрЛП(СтрЗаменить(ЭлементТекст, МассивКолонки[0] + ":", ""));
					НоваяСтрока.cluster = СтрШаблон("%1:%2",Сервер,НомерПорта);
				Иначе 
					ИмяКолонки =  СокрЛП(СтрЗаменить(МассивКолонки[0], "-", ""));
					НоваяСтрока[ИмяКолонки] = СокрЛП(СтрЗаменить(ЭлементТекст, МассивКолонки[0] + ":", ""));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;  
	
	Возврат ТаблицаСеансов;

