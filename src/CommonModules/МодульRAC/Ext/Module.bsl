//DEV-12001 baklanov 03.12.2024
Функция ПолучитьТаблицуНаСервере(ТекущаяКоманда="",КолонкиТЗ="",КодировкаЗаписи="cp866",КодировкаЧтения="cp866") 
	
	ТаблицаРезультат = Новый ТаблицаЗначений;    
	
	
	Если ТекущаяКоманда <> "" И КолонкиТЗ <> "" Тогда		
		СписокРезультат = ПолучитьРезультатКомандыНаСервере(ТекущаяКоманда, КодировкаЗаписи, КодировкаЧтения);
		МассивИнформации = СтрРазделить(СписокРезультат, Символы.ПС);
		ТаблицаРезультат = Новый ТаблицаЗначений;
		Для Каждого ТекЭлемента из СтрРазделить(КолонкиТЗ,",") Цикл
			ТаблицаРезультат.Колонки.Добавить(ТекЭлемента);
		КонецЦикла;	
		НоваяСтрока = ТаблицаРезультат.Добавить();
		Для Каждого ЭлементТекст Из МассивИнформации Цикл
			МассивКолонки = СтрРазделить(ЭлементТекст, ":", Истина);
			Если МассивКолонки.Количество() > 1 Тогда
				ИмяКолонки = СокрЛП(СтрЗаменить(МассивКолонки[0], "-", ""));
				////<< TODO Danilin.V 26 января 2026 г. 15:07:00   
				Если ТаблицаРезультат.Колонки.Найти(ИмяКолонки)=Неопределено Тогда
					ТаблицаРезультат.Колонки.Добавить(ИмяКолонки);	
				КонецЕсли;
				НоваяСтрока[ИмяКолонки] = СокрЛП(СтрЗаменить(ЭлементТекст, МассивКолонки[0] + ":", ""));
				ЭтоПустаяСтрока = Ложь;
			Иначе
				НоваяСтрока = ТаблицаРезультат.Добавить();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;  
	
	Возврат ТаблицаРезультат;

КонецФункции 


