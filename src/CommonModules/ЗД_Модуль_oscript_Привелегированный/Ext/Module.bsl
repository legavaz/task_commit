 
 
 
 
 //Параметры = новый Структура;
 //Интропретатор = Строка запуска скрипта
 Процедура ЗапуститьСкрипт(мСкриптСсылка,ИнфБаза,Параметры=Неопределено) Экспорт
	 
	 МассивОшибок = Новый Массив;
	 ТипСкрипта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(мСкриптСсылка,"ТипСкрипта");
	 
	 Если ТипСкрипта = Перечисления.ЗД_ТипСкрипта.os Тогда
		 ЗапуститьOSСкрипт(мСкриптСсылка,ИнфБаза,МассивОшибок);	 
		 
	 ИначеЕсли ТипСкрипта = Перечисления.ЗД_ТипСкрипта.bat Тогда
		 ЗапуститьBATСкрипт(мСкриптСсылка,ИнфБаза,МассивОшибок);
		 
	 ИначеЕсли ТипСкрипта = Перечисления.ЗД_ТипСкрипта.cmd Тогда
		 
		 ЗапуститьCMDСкрипт(мСкриптСсылка,ИнфБаза,МассивОшибок);		 
		 
	 Иначе
		 МассивОшибок.Добавить("ошибка: алгоритм не определен"); 		 		 
	 КонецЕсли;
	 
	 РегистрацияВыводОшибок("ЗД_Модуль_oscript_Привелегированный.ЗапуститьСкрипт",ИнфБаза,мСкриптСсылка,МассивОшибок)
	 
 КонецПроцедуры      
 
 Процедура ЗапуститьOSСкрипт(мСкриптСсылка,ИнфБаза,Параметры)
	 
	 //Проверка настроек путей запуска
	 МассивОшибок = Новый Массив;
	 ИнтроптераторОСкрипт = Константы.ЗД_ПутьДо_oscript.Получить();
	 Если не ЗначениеЗаполнено(ИнтроптераторОСкрипт) Тогда		 
		 МассивОшибок.Добавить("В настройках системы не указан путь до oscript");
	 Иначе		 
		 СтруктураПеременных = Новый Структура("Ошибка");
		 
		 //Формирование текста скрипта
		 мТекстСкрипта = Справочники.ЗД_Скрипты.СформироватьСкрипт(мСкриптСсылка,СтруктураПеременных);  
		 
		 Если не ПустаяСтрока(СтруктураПеременных.Ошибка) Тогда
			 МассивОшибок.Добавить("Ошибки формирования скрипта:"+мСкриптСсылка+Символы.ПС+СтруктураПеременных.Ошибка);		 
		 КонецЕсли;
		 
	 КонецЕсли; 
	 
	 ИмяФайла = ВернутьФайлСкрипта(мСкриптСсылка,мТекстСкрипта,".os",МассивОшибок);	 
	 
	 //Запуск скрипта на выполнение
	 Если МассивОшибок.Количество()=0 Тогда
		 
		 МассивКоманд = Новый Массив;
		 МассивКоманд.Добавить(ИнтроптераторОСкрипт);
		 МассивКоманд.Добавить(ИмяФайла);  
		 Если ТипЗнч(Параметры)=Тип("Структура") Тогда
			 Для каждого ТекПараметр из Параметры Цикл 
				 МассивКоманд.Добавить(ТекПараметр.Значение);  		 
			 КонецЦикла;
		 КонецЕсли;
		 
		 СтрокаКоманды = СтрСоединить(МассивКоманд," "); 
		 
		 ЗапуститьПриложение(СтрокаКоманды);	
		 РегистрыСведений.ЖурналЗапускаСкриптов.СоздатьЗаписьЗапускаСкрипта(ИнфБаза,мСкриптСсылка,"Успешно: "+СтрокаКоманды);
	 Иначе
		 
		 РегистрацияВыводОшибок("ЗД_Модуль_oscript_Привелегированный.ЗапуститьOSСкрипт",ИнфБаза,мСкриптСсылка,МассивОшибок);		 
		 
		 
	 КонецЕсли;
	 
 КонецПроцедуры   
 
 Процедура ЗапуститьCMDСкрипт(мСкриптСсылка,ИнфБаза,МассивОшибок)
	 
	 СтруктураПеременных = Новый Структура("ИБ,Ошибка",ИнфБаза,"");
	 
	 Ковычка = Символ(34);
	 //Формирование текста скрипта
	 мТекстСкрипта = Справочники.ЗД_Скрипты.СформироватьСкрипт(мСкриптСсылка,СтруктураПеременных);  
	 
	 
	 Если не ПустаяСтрока(СтруктураПеременных.Ошибка) Тогда
		 МассивОшибок.Добавить("Ошибки формирования скрипта:"+мСкриптСсылка+Символы.ПС+СтруктураПеременных.Ошибка);		 
		 
	 Иначе		 
		 //ОбъектСистемы = новый COMОбъект("WScript.Shell");				 
		 КодВозврата = 0;
		 Попытка			 
			 ЗапуститьПриложение(мТекстСкрипта,,Истина,КодВозврата);
			 //КодВозврата = ОбъектСистемы.Run(мТекстСкрипта, 0, 1);	
			 //Процесс = ОбъектСистемы.Exec(мТекстСкрипта);
			 
			 Если КодВозврата <> 0 Тогда
			     МассивОшибок.Добавить("Ошибка (код возврата):"+ КодВозврата);
			 Иначе
				РегистрыСведений.ЖурналЗапускаСкриптов.СоздатьЗаписьЗапускаСкрипта(ИнфБаза,мСкриптСсылка,"Успешно: ЗапуститьПриложение");	 
			 КонецЕсли;				 
		 Исключение     
			МассивОшибок.добавить("Ошибка запуска скрипта: "+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));			 
		 КонецПопытки;                                      		 
	 КонецЕсли;
	 
	 
	 
 КонецПроцедуры

