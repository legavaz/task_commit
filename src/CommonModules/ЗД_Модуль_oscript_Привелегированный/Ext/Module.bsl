 Функция ВернутьФайлСкрипта(ИмяСкрипта,мТекстСкрипт,ТипФайла,МассивОшибок)
	 
	 СтрокаКоманды = КаталогВременныхФайлов()+СтроковыеФункцииКлиентСервер.СтрокаЛатиницей(ИмяСкрипта)+ТипФайла;
	 ТелоКоманды = Новый ТекстовыйДокумент;
	 ТелоКоманды.УстановитьТекст(мТекстСкрипт);
	 ТелоКоманды.Записать(СтрокаКоманды,"UTF-8");			
	 
	 
	 //// открываем файл и считываем символы после символов BOM
	 //Данные = Новый ДвоичныеДанные(СтрокаКоманды);
	 //Строка64=Base64Строка(Данные);
	 //Строка64=Прав(Строка64,СтрДлина(Строка64)-4);
	 //ДанныеНаЗапись=Base64Значение(Строка64);
	 //ДанныеНаЗапись.Записать(СтрокаКоманды); // записываем	 
	 
	 НФ = новый Файл(СтрокаКоманды);
	 Если не НФ.Существует() Тогда
		 МассивОшибок.Добавить("Файл не существует:"+СтрокаКоманды);	 
	 КонецЕсли; 
	 
	 Возврат СтрокаКоманды;
	 
 КонецФункции
 
 Процедура РегистрацияВыводОшибок(ИмяСобытия,ИнфБаза,мСкриптСсылка,МассивОшибок) 
	 
	 Если МассивОшибок.Количество()>0 Тогда
		 мСообщениеОбОшибке = СтрСоединить(МассивОшибок," ");
		 
		 ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия,УровеньЖурналаРегистрации.Ошибка,,мСкриптСсылка,мСообщениеОбОшибке);
		 
		 РегистрыСведений.ЖурналЗапускаСкриптов.СоздатьЗаписьЗапускаСкрипта(ИнфБаза,мСкриптСсылка,"Ошибка: "+мСообщениеОбОшибке);
		 МассивОшибок =  Новый Массив;			 
	 КонецЕсли;	 
	 
	 
 КонецПроцедуры
 