Функция ПолучитьНачалоВыполнения(Задание, КлючПараметров)
	Рез = ДАТА(1,1,1,0,0,0); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	Т.НачалоВыполнения КАК НачалоВыполнения
	|ИЗ
	|	РегистрСведений.SQLВыполнениеЗаданий КАК Т
	|ГДЕ
	|	Т.Задание = &Задание
	|	И Т.КлючПараметров = &КлючПараметров"; 
	
    Запрос.УстановитьПараметр("Задание", Задание);
	Запрос.УстановитьПараметр("КлючПараметров", КлючПараметров);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Рез = Выборка.НачалоВыполнения; 
	КонецЦикла;
	
	Возврат Рез;	
КонецФункции


Процедура УстановитьЗавершениеЗаданий() Экспорт
	
	ТекЗадание = ЗаданиеПроверить();
	Пока ЗначениеЗаполнено(ТекЗадание.Задание) Цикл 
		СтруктураПараметров = Новый Структура;
		Если Не ТекЗадание.КлючПараметров = "" Тогда
			СтруктураПараметров = СтрокаJSONВСтруктуруПараметров(ТекЗадание.СтрокаJson);
			Если Не СтруктураПараметров.Свойство("Задание") Тогда
				СтруктураПараметров.Вставить("Задание", ТекЗадание.Задание);
			КонецЕсли;   
			Если Не СтруктураПараметров.Свойство("КлючПараметров") Тогда
				СтруктураПараметров.Вставить("КлючПараметров", ТекЗадание.КлючПараметров);
			КонецЕсли;   
		Иначе
			СтруктураПараметров.Вставить("Задание", ТекЗадание.Задание);
		КонецЕсли;
		Результат = Ложь;
		Ошибка = ""; 
		Если ТекЗадание.Задание.ТипЗадания = Перечисления.sqlТипыЗаданий.Восстановление Тогда
			Результат = ПроверитьСостояниеВосстановления(СтруктураПараметров, Ошибка); 
		ИначеЕсли ТекЗадание.Задание.ТипЗадания = Перечисления.sqlТипыЗаданий.РезервноеКопирование Тогда	
			Результат = ПроверитьСостояниеРезервногоКопирования(СтруктураПараметров, Ошибка); 
		ИначеЕсли ТекЗадание.Задание.ТипЗадания = Перечисления.sqlТипыЗаданий.Сокращение Тогда	
			Результат = ПроверитьСостояниеСокращения(СтруктураПараметров, Ошибка);
		ИначеЕсли ТекЗадание.Задание.ТипЗадания = Перечисления.sqlТипыЗаданий.Управление Тогда	
			Результат = ПроверитьСостояниеУправления(СтруктураПараметров, Ошибка);
		КонецЕсли;
		Если Результат Тогда
			Набор = РегистрыСведений.SQLВыполнениеЗаданий.СоздатьНаборЗаписей();
		    Набор.Отбор.Задание.Значение = ТекЗадание.Задание;
		    Набор.Отбор.Задание.Использование = Истина;
		    Набор.Отбор.КлючПараметров.Значение = ТекЗадание.КлючПараметров;
		    Набор.Отбор.КлючПараметров.Использование = Истина;
		    Набор.Прочитать();
			Если Набор.Количество() = 1 Тогда
				Если Набор[0].РезультатВыполнения = Ложь И НЕ ЗначениеЗаполнено(Набор[0].ОшибкаВыполнения) Тогда
                    ЕстьОшибка = Ошибка;
					Если Ошибка = "" Тогда
						Ошибка = "Обновление успешно завершено";
						Набор[0].РезультатВыполнения = Истина;
					Иначе 
						Набор[0].ОшибкаВыполнения = Ошибка;
						ЕстьОшибка = "Не завершилось задание";
					КонецЕсли; 
					Если Набор[0].ДатаВыполнения = ДАТА(1,1,1,0,0,0) Тогда
			    		Набор[0].ДатаВыполнения = ТекущаяДата();
					КонецЕсли;
			    	Набор[0].КоличествоПопыток = Набор[0].КоличествоПопыток + 1;
			        СообщитьОВыполнении(СтруктураПараметров, Ошибка); 
					Набор.Записать(); 
					//26.11.2024
					УведомитьУправляющийПроцесс(СтруктураПараметров, ЕстьОшибка);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		СтароеЗадание = ТекЗадание;
		ТекЗадание = ЗаданиеПроверить(СтароеЗадание.Задание, СтароеЗадание.КлючПараметров);
	КонецЦикла;
		
КонецПроцедуры

