Процедура СоздатьЗадание(Задание, СтруктураПараметров = Неопределено, ОтказОтПродолжения, ЕстьОшибка = "")   
	СтрокаИдентификатора = СтруктураПараметров.КлючПараметров;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ  
		|	Т.РезультатВыполнения КАК РезультатВыполнения
		|ИЗ
		|	РегистрСведений.SQLВыполнениеЗаданий КАК Т
		|ГДЕ
		|	Т.Задание = &Задание И Т.КлючПараметров = &КлючПараметров";
	
	Запрос.УстановитьПараметр("Задание", Задание);
	Запрос.УстановитьПараметр("КлючПараметров", СтрокаИдентификатора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОтложеноДо = Дата(1,1,1);
		SQLВыполнениеЗаданий.ДобавитьЗаписьВРегистрВыполнениеЗаданий(Задание, СтруктураПараметров, СтрокаИдентификатора, ОтложеноДо);
	    ОтказОтПродолжения = Истина;
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Если НЕ ВыборкаДетальныеЗаписи.РезультатВыполнения Тогда
			ОтказОтПродолжения = Истина;	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

Процедура УстановитьПарольСлужебногоПользователяПоУмолчанию(СтруктураПараметров = Неопределено, ЕстьОшибка = "")
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Т1.Ссылка КАК Ссылка,
		|	Т2.ЛогинБазы КАК ЛогинБазы,
		|	Т2.ПарольБазы КАК ПарольБазы
		|ИЗ
		|	Справочник.SQLDBТестовые КАК SQLDBТестовые
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЗД_ИнформационныеБазы КАК Т1
		|		ПО (Т1.SQL_db = SQLDBТестовые.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЗД_ИнформационныеБазы КАК Т2
		|		ПО (Т2.SQL_db = SQLDBТестовые.Владелец)
		|ГДЕ
		|	SQLDBТестовые.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", СтруктураПараметров.База);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		СпрСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		СпрОбъект = СпрСсылка.ПолучитьОбъект();
		СпрОбъект.ЛогинБазы = ВыборкаДетальныеЗаписи.ЛогинБазы;
		СпрОбъект.ПарольБазы = ВыборкаДетальныеЗаписи.ПарольБазы; 
		Если (НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ЛогинБазы) ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПарольБазы)) И СпрОбъект.СохранятьCF Тогда
			СпрОбъект.СохранятьCF = Ложь;	
		КонецЕсли;
		Попытка
			СпрОбъект.Записать();
		Исключение
			ЕстьОшибка = ОписаниеОшибки();	
		КонецПопытки;
	КонецЦикла;
		
КонецПроцедуры 

