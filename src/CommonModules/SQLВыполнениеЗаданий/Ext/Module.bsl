Функция ПроверитьСостояниеСокращения(СтруктураПараметров = Неопределено, Ошибка = "")
	
	Результат = Ложь; 
	НачалоВыполнения = ПолучитьНачалоВыполнения(СтруктураПараметров.Задание, СтруктураПараметров.КлючПараметров);
	Если НачалоВыполнения <> ДАТА(1,1,1,0,0,0) Тогда
		ПутьВыгрузки = Константы.ПутьDatabaseCompressionTool.Получить();
		Поз = СтрНайти(ПутьВыгрузки, "\",НаправлениеПоиска.СКонца);
		Если Поз > 0 Тогда  
			ПутьККаталогу = Лев(ПутьВыгрузки, Поз-1);
		КонецЕсли; 
		ФайлыЛогов = Новый Массив;
	    ФайлыЛогов = НайтиФайлы(ПутьККаталогу, "*.txt"); 
		ИскомыйФайл = "";
		Для Каждого ФайлXLS Из ФайлыЛогов Цикл 
			Если ФайлXLS.Существует() И ФайлXLS.ПолучитьВремяИзменения() > НачалоВыполнения Тогда
				ИскомыйФайл = ПутьККаталогу + "\" + ФайлXLS.Имя;
				Прервать;
	        КонецЕсли;
		КонецЦикла; 
		Если ИскомыйФайл <> "" Тогда
			Текст = Новый ТекстовыйДокумент;
			Текст.Прочитать(ИскомыйФайл);
			КоличествоСтрок = Текст.КоличествоСтрок();
			Для Строка = 1 По КоличествоСтрок Цикл
				СтрокаДляРазбора = Текст.ПолучитьСтроку(Строка);
				Если СтрокаДляРазбора = "Конвертация завершена." Тогда
					Результат = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции    

