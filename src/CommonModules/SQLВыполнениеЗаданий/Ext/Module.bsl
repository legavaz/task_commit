
Процедура ОбработатьЗадания() Экспорт
    ТекЗадание = ЗаданиеНаОбработку();
	Пока ЗначениеЗаполнено(ТекЗадание.Задание) Цикл 
		СтруктураПараметров = Новый Структура;
		Если Не ТекЗадание.КлючПараметров = "" Тогда
			СтруктураПараметров = СтрокаJSONВСтруктуруПараметров(ТекЗадание.СтрокаJson);
			Если Не СтруктураПараметров.Свойство("Задание") Тогда
				СтруктураПараметров.Вставить("Задание", ТекЗадание.Задание);
			КонецЕсли;   
			Если Не СтруктураПараметров.Свойство("КлючПараметров") Тогда
				СтруктураПараметров.Вставить("КлючПараметров", ТекЗадание.КлючПараметров);
			КонецЕсли;   
		Иначе
			СтруктураПараметров.Вставить("Задание", ТекЗадание.Задание);
		КонецЕсли;
		ЕстьОшибка = ""; 
		Набор = РегистрыСведений.SQLВыполнениеЗаданий.СоздатьНаборЗаписей();
		Набор.Отбор.Задание.Значение = ТекЗадание.Задание;
		Набор.Отбор.Задание.Использование = Истина;
		Набор.Отбор.КлючПараметров.Значение = ТекЗадание.КлючПараметров;
		Набор.Отбор.КлючПараметров.Использование = Истина;
		Набор.Прочитать();
		Если Набор.Количество() = 1 Тогда  
			Набор[0].НачалоВыполнения = ТекущаяДата(); 
		КонецЕсли;
		Набор.Записать(); 
		Попытка
			ВыполнитьЗадание(ТекЗадание.Задание, СтруктураПараметров, ЕстьОшибка);
		Исключение
			Если ОписаниеОшибки() = "" Тогда
				ЕстьОшибка = "Неизвестная ошибка!";	
			Иначе					
				ЕстьОшибка = ОписаниеОшибки();
			КонецЕсли;
		КонецПопытки;
		Набор = РегистрыСведений.SQLВыполнениеЗаданий.СоздатьНаборЗаписей();
		Набор.Отбор.Задание.Значение = ТекЗадание.Задание;
		Набор.Отбор.Задание.Использование = Истина;
		Набор.Отбор.КлючПараметров.Значение = ТекЗадание.КлючПараметров;
		Набор.Отбор.КлючПараметров.Использование = Истина;
		Набор.Прочитать();
		Если Набор.Количество() = 1 Тогда 
			Если ЕстьОшибка = "" Тогда
				Набор[0].РезультатВыполнения = Истина;
			Иначе
				Набор[0].НачалоВыполнения = ДАТА(1,1,1,0,0,0);
			КонецЕсли;
			Набор[0].ОшибкаВыполнения = ЕстьОшибка;
			Набор[0].ДатаВыполнения = ТекущаяДата(); 
			Набор[0].КоличествоПопыток = Набор[0].КоличествоПопыток + 1; 
		КонецЕсли;
		Набор.Записать(); 
		ТекЗадание = ЗаданиеНаОбработку();
	КонецЦикла;
КонецПроцедуры 

Функция ЗаданиеПроверить(Задание = Неопределено, КлючПараметров = Неопределено)
	Рез = Новый Структура;
	Рез.Вставить("Задание", Справочники.SQLЗадания.ПустаяСсылка());
	Рез.Вставить("КлючПараметров", "");
	Рез.Вставить("СтрокаJson", "");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Задание КАК Задание,
	|	Т.КлючПараметров КАК КлючПараметров,
	|	Т.СтрокаJson КАК СтрокаJson
	|ИЗ
	|	РегистрСведений.SQLВыполнениеЗаданий КАК Т
	|ГДЕ
	|	НЕ Т.РезультатВыполнения
	|	И Т.КоличествоПопыток < &КоличествоПопыток
	|	И Т.ОтложеноДо <= &ТекДата
	|	И НЕ (Т.Задание = &Задание И Т.КлючПараметров = &КлючПараметров) 
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.ДатаЗаписи"; 
	
	КоличествоПопыток = Константы.SQLЗаданиеКоличествоПопыток.Получить();
    Запрос.УстановитьПараметр("КоличествоПопыток",КоличествоПопыток);
	Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
	Запрос.УстановитьПараметр("Задание",Задание);
	Запрос.УстановитьПараметр("КлючПараметров",КлючПараметров);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Рез.Задание = Выборка.Задание; 
		Рез.КлючПараметров = Выборка.КлючПараметров;
		Рез.СтрокаJson = Выборка.СтрокаJson;
	КонецЦикла;
	
	Возврат Рез;
		
КонецФункции  

Функция ЗаданиеНаОбработку()
	Рез = Новый Структура;
	Рез.Вставить("Задание", Справочники.SQLЗадания.ПустаяСсылка());
	Рез.Вставить("КлючПараметров", "");
	Рез.Вставить("СтрокаJson", "");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Задание КАК Задание,
	|	Т.КлючПараметров КАК КлючПараметров,
	|	Т.СтрокаJson КАК СтрокаJson
	|ИЗ
	|	РегистрСведений.SQLВыполнениеЗаданий КАК Т
	|ГДЕ
	|	НЕ Т.РезультатВыполнения
	|	И Т.КоличествоПопыток < &КоличествоПопыток
	|	И Т.НачалоВыполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И Т.ОтложеноДо <= &ТекДата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.ДатаЗаписи"; 
	
	КоличествоПопыток = Константы.SQLЗаданиеКоличествоПопыток.Получить();
    Запрос.УстановитьПараметр("КоличествоПопыток", КоличествоПопыток);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Рез.Задание = Выборка.Задание; 
		Рез.КлючПараметров = Выборка.КлючПараметров;
		Рез.СтрокаJson = Выборка.СтрокаJson;
	КонецЦикла;
	
	Возврат Рез;
		
КонецФункции


Функция СтрокаJSONВСтруктуруПараметров(СтрокаJSON) Экспорт  
	Если СтрокаJSON = "" Тогда
		Возврат Новый Структура;
	КонецЕсли;
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Структура = ПрочитатьJSON(ЧтениеJSON, Ложь);
	СтруктураПараметров = Новый Структура;
	Для каждого эл из Структура Цикл  
		Если Не ТипЗнч(эл.Значение) = Тип("Массив") Тогда 
			СтруктураПараметров.Вставить(эл.Ключ,эл.Значение);
			Продолжить;
		КонецЕсли;
		Если эл.Значение[0] = "Дата" Тогда
			Значение = ПрочитатьДатуJSON(Формат(эл.Значение[1], "ЧГ="), ФорматДатыJSON.ISO);
			СтруктураПараметров.Вставить(эл.Ключ, Значение);
			Продолжить;
		КонецЕсли;
		// <-- Пантелеев Д.И. 17.04.2023, Ссылка на задачу в Redmine (Jira): SD-22910 
		Если эл.Значение[0] = "ТаблицаЗначений" Тогда  
			ТЗ = Новый ТаблицаЗначений;
			к = 1;
			Пока к < эл.Значение.Количество() Цикл 
				Если к = 1 Тогда
					ТЗ = СтруктураВТЗ(СтрокаJSONВСтруктуруПараметров(эл.Значение[к]));
				Иначе
					врТЗ = СтруктураВТЗ(СтрокаJSONВСтруктуруПараметров(эл.Значение[к]));
					новСтр = ТЗ.Добавить();
					ЗаполнитьЗначенияСвойств(новСтр, врТЗ[0]);
				КонецЕсли; 
				к = к + 1;
			КонецЦикла;
			СтруктураПараметров.Вставить(эл.Ключ, ТЗ);
			Продолжить;
		КонецЕсли; 
		// --> Пантелеев Д.И. 17.04.2023 
		Попытка
			Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(эл.Значение[0]);
			Если СтрНайти(эл.Значение[0], "Перечисление") Тогда  
				Значение = Менеджер.Получить(эл.Значение[1]);
			Иначе
				Значение = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(эл.Значение[1]));
			КонецЕсли;
			СтруктураПараметров.Вставить(эл.Ключ, Значение);
		Исключение
			СтруктураПараметров.Вставить("Исключение", эл.Значение[0]);
		КонецПопытки;
	КонецЦикла;
	ЧтениеJSON.Закрыть(); 
	Возврат СтруктураПараметров; 
КонецФункции

Функция СтруктураВТЗ(Структра) 
	
	ТЗ = Новый ТаблицаЗначений;
	НовСтр=ТЗ.Добавить();

	Для Каждого ТекЭлем из Структра Цикл
		
		ТЗ.Колонки.Добавить(ТекЭлем.Ключ);
			
		НовСтр[ТекЭлем.Ключ] = ТекЭлем.Значение;                          
		
	КонецЦикла;
 	
	Возврат ТЗ;
	
КонецФункции

Процедура ДобавитьЗаписьВРегистрВыполнениеЗаданий(Задание, СтруктураПараметров = Неопределено, КлючПараметр = "", ОтложеноДо) Экспорт 
	Если Не ТипЗнч(КлючПараметр) = Тип("Строка") Тогда
		КлючПараметр = Строка(КлючПараметр);
	КонецЕсли;
	Запись = РегистрыСведений.SQLВыполнениеЗаданий.СоздатьМенеджерЗаписи();
	Запись.Задание = Задание;
	Запись.ДатаЗаписи = ТекущаяДата();
	Если ЗначениеЗаполнено(КлючПараметр) Тогда
		Запись.КлючПараметров = КлючПараметр;
		Если ЗначениеЗаполнено(СтруктураПараметров) Тогда
			Запись.СтрокаJson = СтруктураПараметровВСтрокуJSON(СтруктураПараметров);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(СтруктураПараметров) Тогда
		Запись.КлючПараметров = "Истина";
		Запись.СтрокаJson = СтруктураПараметровВСтрокуJSON(СтруктураПараметров);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтложеноДо) Тогда
		Запись.ОтложеноДо = ОтложеноДо; 
	КонецЕсли;
	Запись.Записать(Истина);
КонецПроцедуры 

Функция СтруктураПараметровВСтрокуJSON(СтруктураПараметров)   
	//ЗаписьJSON = Новый ЗаписьJSON;
	//ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	//ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON;
	//ЗаписьJSON.ОткрытьФайл("ИмяФайла",,,ПараметрыЗаписиJSON);
	//ЗаписатьJSON(ЗаписьJSON, СтруктураПараметров, Новый НастройкиСериализацииJSON);  
	Структура = Новый Структура;
	Для каждого эл из СтруктураПараметров Цикл
		Если ТипЗнч(Эл.Значение) = Тип("Строка")
			или ТипЗнч(Эл.Значение) = Тип("Число")
			или ТипЗнч(Эл.Значение) = Тип("Булево") 
			или Эл.Значение = Неопределено 
			Тогда
			Структура.Вставить(эл.Ключ, эл.Значение);
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Эл.Значение) = Тип("Дата") Тогда
			Массив = Новый Массив; 
			Массив.Добавить("Дата");
			Массив.Добавить(эл.Значение);
			Структура.Вставить(эл.Ключ, Массив);
			Продолжить;
		КонецЕсли; 
		// <-- Пантелеев Д.И. 17.04.2023, Ссылка на задачу в Redmine (Jira): SD-22910 
		Если ТипЗнч(Эл.Значение) = Тип("ТаблицаЗначений") Тогда   
			Массив = Новый Массив; 
			Массив.Добавить("ТаблицаЗначений"); 
			МассивСтруктур = ТЗВСтруктуру(эл.Значение);
			Для каждого элМС из МассивСтруктур Цикл
				Массив.Добавить(СтруктураПараметровВСтрокуJSON(элМС));
			КонецЦикла;
			Структура.Вставить(эл.Ключ, Массив);
			Продолжить;
		КонецЕсли;	
		// --> Пантелеев Д.И. 17.04.2023
		Массив = Новый Массив; 
		Тип = Метаданные.НайтиПоТипу(ТипЗнч(эл.Значение)).ПолноеИмя();
		Массив.Добавить(Тип); 
		Если СтрНайти(Тип, "Перечисление") Тогда
			Массив.Добавить(Перечисления[эл.Значение.Метаданные().Имя].Индекс(эл.Значение)); 
		Иначе 
			Массив.Добавить(Строка(эл.Значение.УникальныйИдентификатор())); 
		КонецЕсли;
		Структура.Вставить(эл.Ключ, Массив);
	КонецЦикла;
	ЗначенияJSON = Новый ЗаписьJSON;
	ЗначенияJSON.ПроверятьСтруктуру = Ложь;
	ЗначенияJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗначенияJSON, Структура,);
	Возврат ЗначенияJSON.Закрыть();
	//СтрокаJSON = ЗначенияJSON.Закрыть(); 
	//Возврат СтрЗаменить(СтрЗаменить(СтрокаJSON, "\r\n", Символы.ПС), "\", ""); 
КонецФункции 

Функция ТЗВСтруктуру(ТабЗначений)

	Результат = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТабЗначений);
	КоллекцияКолонок = ТабЗначений.Колонки;	
	
	Для каждого ТекЭлемента из Результат Цикл		
		Для каждого ТекКолонки из КоллекцияКолонок Цикл
			мЗначение	=	ТекЭлемента[ТекКолонки.имя];
			ТекЭлемента[ТекКолонки.имя]	= мЗначение;			
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции


Процедура ВыполнитьЗадание(Задание, СтруктураПараметров = Неопределено, ЕстьОшибка = "") 
	Если Задание.Отключено Тогда
		ЕстьОшибка = "Задание отключено";
		Возврат;
	КонецЕсли; 
	
	Для Каждого Шаг Из Задание.Сценарий Цикл
		ОтказОтПродолжения = Ложь;
		Если СтрДлина(Шаг.КомандаСценария) > 15 И Лев(Шаг.КомандаСценария, 15) = "СоздатьЗадание(" Тогда
			ПозОконч = СтрНайти(Шаг.КомандаСценария, ",",,1,1);
			Если ПозОконч > 16 Тогда
				ИмяЗадания = Сред(Шаг.КомандаСценария, 16, ПозОконч - 16); 
				НовоеЗадание = Неопределено;
				Для каждого ЭлементСтруктуры Из СтруктураПараметров Цикл
					Если ЭлементСтруктуры.Ключ = ИмяЗадания Тогда
						НовоеЗадание = ЭлементСтруктуры.Значение;	
					КонецЕсли;				
				КонецЦикла;
				Если ЗначениеЗаполнено(НовоеЗадание) Тогда
					СоздатьЗадание(НовоеЗадание, СтруктураПараметров, ОтказОтПродолжения, ЕстьОшибка);
				Иначе
					ЕстьОшибка = "Не удалось создать задание";
				КонецЕсли;
			Иначе
				ЕстьОшибка = "Не удалось создать задание";
			КонецЕсли;
		Иначе
			ВыполнитьШагЗадания(Шаг.КомандаСценария, СтруктураПараметров, ОтказОтПродолжения, ЕстьОшибка);
		КонецЕсли;
		Если ОтказОтПродолжения Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

  
Процедура ВыполнитьШагЗадания(ТекстКоманды, СтруктураПараметров = Неопределено, ОтказОтПродолжения, ЕстьОшибка = "")
	Если ЗначениеЗаполнено(ТекстКоманды) Тогда
		Выполнить(ТекстКоманды);
	КонецЕсли;
	Если ЕстьОшибка <> "" Тогда
		 ОтказОтПродолжения = Истина;
	КонецЕсли;
КонецПроцедуры     

Процедура СкриптВосстановления(СтруктураПараметров = Неопределено, ЕстьОшибка = "")

	ОЛАПСоединение = Новый COMОбъект("ADODB.Connection"); 
	ОЛАПСоединение.CursorLocation=3;
	Пароль = СтруктураПараметров.База.Сервер.Пароль;
	Пользователь = СтруктураПараметров.База.Сервер.Агент;
	Сервер = СтруктураПараметров.База.Сервер.Наименование;

	ОЛАПСоединение.ConnectionString="Provider=SQLOLEDB.1;Password="+Пароль+";Persist Security Info=True;User ID="+Пользователь+";Initial Catalog=master;Data Source="+Сервер;
	ОЛАПСоединение.Open();
	
	ЗапросАДО = Новый COMОбъект("ADODB.Command"); 
	ExecuteOptionEnum = Новый Структура ("adAsyncExecute, adAsyncFetch, adAsyncFetchNonBlocking, adExecuteNoRecords, adExecuteStream, adOptionUnspecified", 16, 32, 64, 128, 1024, -1);
			
	ЗапросАДО.CommandText = "dbo.DatabaseRestoreAdm";
	ЗапросАДО.CommandType=4;
	ЗапросАДО.CommandTimeout = 300;
	ЗапросАДО.ActiveConnection = ОЛАПСоединение;
	
	ЗапросАДО.Parameters.Item("@databaseName").Value=Строка(СтруктураПараметров.База.Владелец.Наименование);
	ЗапросАДО.Parameters.Item("@serverName").Value=СтруктураПараметров.База.Владелец.Сервер.Наименование;
	ЗапросАДО.Parameters.Item("@pathBackup").Value=СтруктураПараметров.База.Владелец.Сервер.ПутьКБекапам;
	ЗапросАДО.Parameters.Item("@pathNetBackup").Value=СтруктураПараметров.База.Владелец.Сервер.ПутьКБекапамСетевой;
	ЗапросАДО.Parameters.Item("@databaseNameNew").Value=СтруктураПараметров.База.Наименование;
	ЗапросАДО.Parameters.Item("@DirectoryRestoreData").Value=СтруктураПараметров.База.Сервер.ПутьКДанным;
