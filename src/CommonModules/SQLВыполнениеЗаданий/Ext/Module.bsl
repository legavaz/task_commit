#Region DataCompressionTool

Процедура ВыполнитьDataCompressionTool(СтруктураПараметров = Неопределено, ЕстьОшибка = "")
    ПараметрКоманды = СтруктураПараметров.База;
	ИнформационнаяБаза = "";

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗД_ИнформационныеБазы КАК Т
		|ГДЕ
		|	Т.SQL_db = &ПараметрКоманды";
	
	Запрос.УстановитьПараметр("ПараметрКоманды", ПараметрКоманды);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ИнформационнаяБаза = ВыборкаДетальныеЗаписи.Ссылка; 
	КонецЦикла;

	Если ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
		АвтономныйСервер.ПолучитьФайлDataCompressionTool(ИнформационнаяБаза);
	Иначе
		ЕстьОшибка = "Не найдена информационная база";
	КонецЕсли;
КонецПроцедуры

#EndRegion
