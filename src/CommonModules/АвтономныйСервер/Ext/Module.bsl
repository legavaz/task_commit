			PasswordSQL=""; //Пароль пользователя SQL
			
			Сообщение = Новый СообщениеПользователю();
			ПрочитаннаяСтрока = Текст.ПрочитатьСтроку();
			Сообщение.Текст = ПрочитаннаяСтрока;
			Сообщение.Сообщить();
			СтрокаРазделителя = ":";  
			ИскатьВСтроке = Ложь;
			Пока ПрочитаннаяСтрока <> Неопределено Цикл
				ПрочитаннаяСтрока = Текст.ПрочитатьСтроку(); 
				Если ПрочитаннаяСтрока = "database:" Тогда
					ИскатьВСтроке = Истина;	
				ИначеЕсли ПрочитаннаяСтрока = "infobase:" Тогда
					ИскатьВСтроке = Ложь;
				КонецЕсли;
				Если ИскатьВСтроке Тогда
					СтрокиДанных = СтрРазделить(ПрочитаннаяСтрока, СтрокаРазделителя);
					Если СтрокиДанных.Количество() = 2 Тогда
						Если СтрокиДанных[0] = "  dbms" Тогда
							Если СтрокиДанных[1] <> " MSSQLServer" Тогда
								ServerType="PG";
							КонецЕсли;
						ИначеЕсли СтрокиДанных[0] = "  server" Тогда
							ServerSQL = СокрЛ(СтрокиДанных[1]); 
						ИначеЕсли СтрокиДанных[0] = "  name" Тогда
							BaseSQL = СокрЛ(СтрокиДанных[1]);
						ИначеЕсли СтрокиДанных[0] = "  user" Тогда
							UserSQL = СокрЛ(СтрокиДанных[1]);
						ИначеЕсли СтрокиДанных[0] = "  password" Тогда
							PasswordSQL = СокрЛ(СтрокиДанных[1]);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;  
		
			КаталогВременныхФайлов = КаталогВременныхФайлов();
			ИмяБатФайла = "DCT" + ИмяБазы + ".bat";
			ПолноеИмяИмяБатФайла = КаталогВременныхФайлов + ИмяБатФайла; 
			//ПолноеИмяИмяБатФайла = Путь + "\" + ИмяБатФайла;
			
			БатФайл = Новый ТекстовыйДокумент;
			//БатФайл.ДобавитьСтроку("chcp 65001");
	        БатФайл.ДобавитьСтроку("echo off");     
			//Параметры запуска базы 1С
			БатФайл.ДобавитьСтроку("set PlatformVersion=" + Версия1С); //Номер версии платформы
			Если ВыборкаДетальныеЗаписи.ПортКластера <> "" Тогда
				БатФайл.ДобавитьСтроку("set Server1C=" + ВыборкаДетальныеЗаписи.ИмяСервера+":"+ВыборкаДетальныеЗаписи.ПортКластера); //Адрес сервера 1С 
			Иначе 
				БатФайл.ДобавитьСтроку("set Server1C=" + ВыборкаДетальныеЗаписи.ИмяСервера); //Адрес сервера 1С 
			КонецЕсли;
			БатФайл.ДобавитьСтроку("set Base1C=" + ВыборкаДетальныеЗаписи.ИмяБазы); //Имя базы 1С
			БатФайл.ДобавитьСтроку("set User1C=" + ВыборкаДетальныеЗаписи.ЛогинБазы); //Имя пользователя 1С
			БатФайл.ДобавитьСтроку("set Password1C=" + ВыборкаДетальныеЗаписи.ПарольБазы); //Пароль пользователя 1С
			БатФайл.ДобавитьСтроку("set Path=" + ПутьDatabaseCompressionTool); //Полный путь до обработки без кириллических символов C:\DatabaseCompressionTool.epf
			//Параметры запуска базы SQL
			БатФайл.ДобавитьСтроку("set ServerType=" + ServerType); //Тип СУБД: MS (MS SQL), PG (PostgreSQL)
			БатФайл.ДобавитьСтроку("set ServerSQL=" + ServerSQL); //Адрес сервера SQL
			БатФайл.ДобавитьСтроку("set BaseSQL=" + BaseSQL); //Имя базы SQL
			БатФайл.ДобавитьСтроку("set UserSQL=" + UserSQL); //Имя пользователя SQL
			БатФайл.ДобавитьСтроку("set PasswordSQL=" + PasswordSQL); //Пароль пользователя SQL 
			//Основные параметры автоматической конвертации
			БатФайл.ДобавитьСтроку("set ConversionMode=MS"); //Режим конвертации: MS (Minimum Size), MP (Maximum Performance), MC (Maximum Consistency)
			БатФайл.ДобавитьСтроку("set ReductionDate=" + Формат(НачалоКвартала(ДобавитьМесяц(ТекущаяДата(), -3)), "ДФ=""ггггММдд""")); //Граница среза данных в формате YYYYMMDD
			////Дополнительные параметры автоматической конвертации
			БатФайл.ДобавитьСтроку("set ProcessRowsPerRequest=500000"); //Обрабатывать строк за запрос
			БатФайл.ДобавитьСтроку("set NumberOfRowsPerRemainingEntryDocument=50000"); //Количество строк в документе ввода остатков
			БатФайл.ДобавитьСтроку("set DeleteObjectVersions=Y"); //Удалять версии объектов (N - Нет, Y - Да)
			БатФайл.ДобавитьСтроку("set DeleteAttachedFiles=Y"); //Удалять прикрепленные файлы (N - Нет, Y - Да)
			БатФайл.ДобавитьСтроку("set UseExclusiveMode=Y"); //Использовать монопольный режим (N - Нет, Y - Да)
			БатФайл.ДобавитьСтроку("set BreakOnError=Y"); //Прерывать при ошибке (N - Нет, Y - Да)
			БатФайл.ДобавитьСтроку("set WriteProtocol=Y"); //Записывать протокол выполнения (N - Нет, Y - Да)
			БатФайл.ДобавитьСтроку("set UseTableLocks=N"); //Использовать табличные блокировки (N - Нет, Y - Да)
			БатФайл.ДобавитьСтроку("set AccountingRollUpAccounts=000"); //Номер бухгалтерского счета для свертки (Если есть планы счетов и Режим конвертации: MaximumConsistency)
			//"C:\Program Files\1cv8\%PlatformVersion%\bin\1cv8c.exe" ENTERPRISE /IBConnectionString "Srvr=""%Server1C%"";Ref=""%Base1C%"";" /N %User1C% /P %Password1C% /Execute "%Path%" /DisableStartupMessages /DisableStartupDialogs /c"DCT;ST=%ServerType%;SSQL=%ServerSQL%;BSQL=%BaseSQL%;USQL=%UserSQL%;PSQL=%PasswordSQL%;CM=%ConversionMode%;RDD=%ReductionDate%;ARA=%AccountingRollUpAccounts%;WP=%WriteProtocol%;PRPR=%ProcessRowsPerRequest%;NRPD=%NumberOfRowsPerRemainingEntryDocument%;DOV=%DeleteObjectVersions%;DAF=%DeleteAttachedFiles%;UEM=%UseExclusiveMode%;BE=%BreakOnError%;UTL=%UseTableLocks%;"
			БатФайл.ДобавитьСтроку("%PlatformVersion%\1cv8c.exe ENTERPRISE /IBConnectionString ""Srvr=""""%Server1C%"""";Ref=""""%Base1C%"""";"" /N %User1C% /P %Password1C% /Execute ""%Path%"" /DisableStartupMessages /DisableStartupDialogs /c""DCT;ST=%ServerType%;SSQL=%ServerSQL%;BSQL=%BaseSQL%;USQL=%UserSQL%;PSQL=%PasswordSQL%;CM=%ConversionMode%;RDD=%ReductionDate%;ARA=%AccountingRollUpAccounts%;WP=%WriteProtocol%;PRPR=%ProcessRowsPerRequest%;NRPD=%NumberOfRowsPerRemainingEntryDocument%;DOV=%DeleteObjectVersions%;DAF=%DeleteAttachedFiles%;UEM=%UseExclusiveMode%;BE=%BreakOnError%;UTL=%UseTableLocks%;""");
			//БатФайл.ДобавитьСтроку("pause");
			БатФайл.Записать(ПолноеИмяИмяБатФайла, КодировкаЗаписи);
			ЗапуститьПриложение(ИмяБатФайла, КаталогВременныхФайлов, Истина, КодВозврата);
			//УдалитьФайлы(ПолноеИмяИмяБатФайла);	
		КонецЦикла;  
	КонецЕсли;
	
КонецПроцедуры