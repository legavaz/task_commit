 
Функция СоздатьКонфигурационныйФайл_old(Версия1С ,ИмяБазы, КонфигурационныйФайл, Перезаписывать = Ложь, ПортАвтономногоСервера = 8314) Экспорт 
	Рез = "";
	Ковычка = Символ(34);
	
	Если Не Перезаписывать И ПроверитьНаличиеФайла(КонфигурационныйФайл) Тогда
		Рез = КонфигурационныйФайл;
	Иначе
		КодВозврата = Неопределено;  
		КодировкаЗаписи = "cp866"; 
		КодировкаЧтения = "cp866";   
		//Версия1С = Константы.АвтономныйСерверВерсия1С.Получить();
		ДанныеКластера = Константы.АвтономныйСерверДанныеКластера.Получить(); 
	
		КаталогВременныхФайлов = КаталогВременныхФайлов();
		ИмяБатФайла = "CreateConfig.bat";
		ПолноеИмяИмяБатФайла = КаталогВременныхФайлов + ИмяБатФайла;
		СтрПортАвтономногоСервера = СтрЗаменить(Строка(Число(ПортАвтономногоСервера)),Символы.НПП,"");
		
		БатФайл = Новый ТекстовыйДокумент;
		//БатФайл.ДобавитьСтроку("set v8=" + Версия1С);
		БатФайл.ДобавитьСтроку("set v8=" + Ковычка+Версия1С+Ковычка);
		БатФайл.ДобавитьСтроку("%v8%ibcmd.exe server config import --cluster-data=""" + ДанныеКластера + """ --name=" + ИмяБазы + " --port=" + СтрПортАвтономногоСервера + " --out="+КонфигурационныйФайл);
		БатФайл.Записать(ПолноеИмяИмяБатФайла, КодировкаЗаписи);
		
		ЗапуститьПриложение(ИмяБатФайла, КаталогВременныхФайлов, Истина, КодВозврата);	
				
	    Если КодВозврата = 0 Тогда
	        Рез = КонфигурационныйФайл;
			УдалитьФайлы(ПолноеИмяИмяБатФайла);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

Функция СоздатьКонфигурационныйФайл(Версия1С ,ИмяБазы, КонфигурационныйФайл, Перезаписывать = Ложь, ПортАвтономногоСервера = 8314) Экспорт 
	Рез = КонфигурационныйФайл;
	Ковычка = Символ(34);
	
	ПортАвтономногоСервера	=	?(не ЗначениеЗаполнено(ПортАвтономногоСервера),8314,ПортАвтономногоСервера);
	
	Перезаписывать = не ПроверитьНаличиеФайла(КонфигурационныйФайл);
	
	Если Перезаписывать Тогда
		КодВозврата = Неопределено;  
		КодировкаЗаписи = "cp866"; 				
		ДанныеКластера = Константы.АвтономныйСерверДанныеКластера.Получить(); 
	
		КаталогВременныхФайлов = КаталогВременныхФайлов();
		//КаталогВременныхФайлов = Объект.КаталогРазборки;
		
		ИмяБатФайла = "CreateConfig.bat";
		ПолноеИмяИмяБатФайла = КаталогВременныхФайлов +"\" + ИмяБатФайла;
		СтрПортАвтономногоСервера = СтрЗаменить(Строка(Число(ПортАвтономногоСервера)),Символы.НПП,"");
		
		МассивКомманд = Новый Массив;
		МассивКомманд.Добавить(Ковычка+Версия1С+Ковычка);
		МассивКомманд.Добавить("server config import");	
		МассивКомманд.Добавить("--cluster-data="+ДанныеКластера);
		МассивКомманд.Добавить("--name="+ИмяБазы);
		МассивКомманд.Добавить("--port="+СтрПортАвтономногоСервера);
		МассивКомманд.Добавить("--out="+КонфигурационныйФайл);
		
		стрКоманда = СтрСоединить(МассивКомманд," ");  
		ЗапуститьПриложение(стрКоманда,КаталогВременныхФайлов, Истина, КодВозврата);
		Сообщить("("+КодВозврата+")"+стрКоманда);
		Пауза(1);
		
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

Функция ПроверитьНаличиеФайла(ИмяФайла)Экспорт
	Рез = Ложь;
	МойФайл = Новый Файл(ИмяФайла);
	Рез = МойФайл.Существует(); 
	Возврат Рез;
КонецФункции    

Функция ОстановитьИсполнение()
	
	Если Константы.ОстановитьИсполнение.Получить() = Истина Тогда
		
		ТекстСообщения = "Выполнение остановлено пользователем через константу";
		ЗаписьЖурналаРегистрации("Обновление из хранилища",,,,ТекстСообщения);
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура Пауза(Секунд) Экспорт
	
	Для к=1 По Секунд Цикл
		
		Если ОстановитьИсполнение() Тогда
			Прервать;
		КонецЕсли; 
		
		СтрокаЗапроса = "ping -n 2 localhost"; 
		Соединение = Новый COMОбъект("WScript.Shell");
		Соединение.Run(СтрокаЗапроса, 0, -1);	
		
	КонецЦикла;
	
КонецПроцедуры

Функция глПолучитьКаталог(Кат) экспорт
  Возврат ?(ПустаяСтрока(Кат)=0, ?(Прав(СОКРП(Кат),1)<>"\",СОКРЛП(Кат)+"\",СОКРЛП(Кат)),"");
КонецФункции

//Команды:
//export  - выгрузка в хмл
//sync - синхронизация файлов
//import - загрузка из хмл
//save - сохранить в cf
//load - загрузить из  cf
//apply - обновит конфигурацию базы данных (с выполнением, при необходимости, реструктуризации базы данных).
//dump - выгрузка dt   
//restore - восстановить
Процедура ВыполнитьСценарийАвтономногоСервера(ИнформационнаяБаза,Команда,знач РабочийКаталог,ИмяРасширения="") Экспорт
	
	Ковычка = Символ(34); 
	КодВозврата = "999";		    
	КодировкаЗаписи = "cp866";
	
	мНачалоСценария = ТекущаяДата(); 
	КомандаХМЛ = Новый Массив;
	КомандаХМЛ.Добавить("export");	
	КомандаХМЛ.Добавить("sync");
	КомандаХМЛ.Добавить("import"); 
	
	КомандаДТ = Новый Массив;
	КомандаДТ.Добавить("dump");	
	КомандаДТ.Добавить("restore");
	
	РабочийКаталог = глПолучитьКаталог(РабочийКаталог);
	
	ЭтоДТ_Команда = КомандаДТ.Найти(Команда)<>Неопределено;	
	ЭтоХМЛ_Команда = КомандаХМЛ.Найти(Команда)<>Неопределено;	
	
	Если не ПроверитьНаличиеФайла(РабочийКаталог) Тогда
		СоздатьКаталог(РабочийКаталог);
		ОбщегоНазначения.СообщитьПользователю(""+РабочийКаталог+" - создан!");
	КонецЕсли;   
	
	КаталогВыгрузкиXML = РабочийКаталог + "cfg_xml";	
	Если ЭтоХМЛ_Команда и 
		не ПроверитьНаличиеФайла(КаталогВыгрузкиXML) Тогда
		
		СоздатьКаталог(КаталогВыгрузкиXML);
		ОбщегоНазначения.СообщитьПользователю(""+КаталогВыгрузкиXML+" - создан!");		
	КонецЕсли;	
	
	РеквизитыИБ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИнформационнаяБаза,"ИмяБазы,ПортАвтономногоСервера,ЛогинБазы,ПарольБазы");	
	
	//Платформа
	ТекПлатформа = РегистрыСведений.зд_АктуальнаяПлатформа.ПолучитьПоследнее(ТекущаяДата()).Платформа;   
	Версия1С = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекПлатформа,"ПутьКПлатформе1С");
	Версия1С = СтрЗаменить(Версия1С,"1cv8.exe","ibcmd.exe");  
	
	ИмяФайла_ibcmd =  Команда+"_"+РеквизитыИБ.ИмяБазы;	
	ИмяБатФайла = ИмяФайла_ibcmd + ".bat";
	ИмяlogФайла = РабочийКаталог+ИмяФайла_ibcmd + ".log";
		
	ИмяФайла1С = РеквизитыИБ.ИмяБазы+?(ЭтоДТ_Команда,".dt",".cf");
		
	КонфигурационныйФайл = КаталогВременныхФайлов() + РеквизитыИБ.ИмяБазы + ".yml"; 		
	КонфигурационныйФайл = АвтономныйСервер.СоздатьКонфигурационныйФайл(Версия1С,РеквизитыИБ.ИмяБазы, КонфигурационныйФайл, Ложь, ?(РеквизитыИБ.ПортАвтономногоСервера=0,Неопределено,РеквизитыИБ.ПортАвтономногоСервера)); 
	
	Если НЕ ПроверитьНаличиеФайла(КонфигурационныйФайл) Тогда
		ОбщегоНазначения.СообщитьПользователю("(Отмена скрипта)не создан конф. файл: "+КонфигурационныйФайл);	
		Возврат;
	КонецЕсли;
	
	МассивКомманд = Новый Массив;
	МассивКомманд.Добавить(Ковычка+Версия1С+Ковычка);
	
	//БатФайл.ДобавитьСтроку("%v8% infobase dump -c " + КонфигурационныйФайл + " " + ПутьВыгрузки + "\" + ИмяБазы + "\1cv8.dt -u " + ЛогинБазы + " -P " + ПарольБазы);
	
	Если ЭтоДТ_Команда Тогда
		МассивКомманд.Добавить("infobase "+Команда);				
	Иначе		
		Если Команда="sync" Тогда
			МассивКомманд.Добавить("infobase config export");		
		Иначе
			МассивКомманд.Добавить("infobase config "+Команда);			
		КонецЕсли;			
	Конецесли;
		
	МассивКомманд.Добавить("--user="+РеквизитыИБ.ЛогинБазы);
	МассивКомманд.Добавить("--password="+РеквизитыИБ.ПарольБазы);
	
	Если Команда="sync" Тогда
		МассивКомманд.Добавить("--sync="+КонфигурационныйФайл);	
	КонецЕсли;
	
	МассивКомманд.Добавить("--config="+КонфигурационныйФайл);
	Если ЭтоХМЛ_Команда Тогда
		МассивКомманд.Добавить(КаталогВыгрузкиXML);
	Иначе
		МассивКомманд.Добавить(РабочийКаталог+ИмяФайла1С);		
	КонецЕсли; 
	
	Если Команда="apply" Тогда
		МассивКомманд.Добавить("--force");		
	КонецЕсли;
	
	МассивКомманд.Добавить(">"+ИмяlogФайла);
	
	стрКоманда = СтрСоединить(МассивКомманд," "); 	
	
	БатФайл = Новый ТекстовыйДокумент;	
	БатФайл.ДобавитьСтроку("echo off");
	БатФайл.ДобавитьСтроку(стрКоманда);
	БатФайл.Записать(РабочийКаталог+ИмяБатФайла, КодировкаЗаписи);
	ЗапуститьПриложение(ИмяБатФайла, РабочийКаталог, Истина, КодВозврата);
	Сообщить("("+КодВозврата+") Начало:"+мНачалоСценария+" - завершено: "+ТекущаяДата());	
	   
	//чтение логов  
	мТекстФайла="";
	Если ПроверитьНаличиеФайла(ИмяlogФайла) Тогда
		мТекстФайла = "";
		ТекстФайл = новый Файл(ИмяlogФайла);
		Если ТекстФайл.Существует() Тогда
			Текст = Новый ТекстовыйДокумент;	
			Текст.Прочитать(ИмяlogФайла,КодировкаТекста.UTF8);	
			мТекстФайла = Текст.ПолучитьТекст();
		КонецЕсли;
		Сообщить(""+ИмяlogФайла+": "+Символы.ПС+мТекстФайла);  
	КонецЕсли;    
	ЗаписьЖурналаРегистрации("АвтономныйСервер."+Команда,?(КодВозврата=0,УровеньЖурналаРегистрации.Информация,УровеньЖурналаРегистрации.Ошибка),Метаданные.Справочники.ЗД_ИнформационныеБазы,ИнформационнаяБаза,""+мНачалоСценария+"-"+ТекущаяДата()+" "+мТекстФайла);
	
		
КонецПроцедуры


Процедура СохранитьКонфигурацию(ИнформационнаяБаза = Неопределено) Экспорт
	
	////Версия1С = Константы.АвтономныйСерверВерсия1С.Получить(); 	
	Путь = Константы.АвтономныйСерверПутьКонфигурации.Получить();
	ПутьВыгрузки = Константы.АвтономныйСерверПутьВыгрузки.Получить();  
	
	ДеньВыгрузки = "_"+Строка(ДеньНедели(ТекущаяДата()));  //ДанилинВИ 24/02/25
	ТекПлатформа = РегистрыСведений.зд_АктуальнаяПлатформа.ПолучитьПоследнее(ТекущаяДата()).Платформа;    //ДанилинВИ 24/02/25
	Версия1С = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекПлатформа,"ПутьКПлатформе1С");
	Версия1С = СтрЗаменить(Версия1С,"1cv8.exe","ibcmd.exe");
	Ковычка = Символ(34); 
	
	Запрос = Новый Запрос;  
	Если ИнформационнаяБаза = Неопределено Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗД_ИнформационныеБазы.Ссылка КАК Ссылка,
			|	ЗД_ИнформационныеБазы.ИмяБазы КАК ИмяБазы,
			|	ЗД_ИнформационныеБазы.ЛогинБазы КАК ЛогинБазы,
			|	ЗД_ИнформационныеБазы.ПарольБазы КАК ПарольБазы,
			|	ЗД_ИнформационныеБазы.ПортАвтономногоСервера КАК ПортАвтономногоСервера
			|ИЗ
			|	Справочник.ЗД_ИнформационныеБазы КАК ЗД_ИнформационныеБазы
			|ГДЕ
			|	ЗД_ИнформационныеБазы.СохранятьCF = ИСТИНА";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗД_ИнформационныеБазы.Ссылка КАК Ссылка,
			|	ЗД_ИнформационныеБазы.ИмяБазы КАК ИмяБазы,
			|	ЗД_ИнформационныеБазы.ЛогинБазы КАК ЛогинБазы,
			|	ЗД_ИнформационныеБазы.ПарольБазы КАК ПарольБазы,
			|	ЗД_ИнформационныеБазы.ПортАвтономногоСервера КАК ПортАвтономногоСервера
			|ИЗ
			|	Справочник.ЗД_ИнформационныеБазы КАК ЗД_ИнформационныеБазы
			|ГДЕ
			|	ЗД_ИнформационныеБазы.Ссылка = &ИнформационнаяБаза";
		Запрос.УстановитьПараметр("ИнформационнаяБаза", ИнформационнаяБаза);
	
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  
	мПутьВыгрузки = "";
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл   
		ИмяБазы = ВыборкаДетальныеЗаписи.ИмяБазы; //+"_"+ДеньВыгрузки; //ДанилинВИ 24/02/25
		ЛогинБазы = ВыборкаДетальныеЗаписи.ЛогинБазы;
		ПарольБазы = ВыборкаДетальныеЗаписи.ПарольБазы;
		ПортАвтономногоСервера = ВыборкаДетальныеЗаписи.ПортАвтономногоСервера;
		
		КодВозврата = Неопределено;  
		//КодировкаЗаписи = "cp866"; 
		КодировкаЗаписи = КодировкаТекста.UTF8;
		//КодировкаЧтения = "cp866";   
		
		КонфигурационныйФайл = Путь +"\" + ИмяБазы + ".yml"; 
		КонфигурационныйФайл = СоздатьКонфигурационныйФайл(Версия1С,ИмяБазы, КонфигурационныйФайл, Истина, ПортАвтономногоСервера); 
		
		Если ПустаяСтрока(КонфигурационныйФайл) Тогда
			Продолжить;
			ЗаписьЖурналаРегистрации("АвтономныйСервер.Ошибка.СохранитьКонфигурацию",УровеньЖурналаРегистрации.Ошибка,,ВыборкаДетальныеЗаписи.Ссылка,"Ошибка формирования файла конфигурации");	
		КонецЕсли;
		
		
		КаталогВременныхФайлов = КаталогВременныхФайлов();
		ИмяБатФайла = ИмяБазы + ".bat";
		ПолноеИмяИмяБатФайла = КаталогВременныхФайлов + ИмяБатФайла; 
		//ПолноеИмяИмяБатФайла = Путь + "\" + ИмяБатФайла;
		
		БатФайл = Новый ТекстовыйДокумент;
		//БатФайл.ДобавитьСтроку("chcp 65001");
        БатФайл.ДобавитьСтроку("echo off");
		//БатФайл.ДобавитьСтроку("set v8=" + Версия1С);
		БатФайл.ДобавитьСтроку("set v8=" + Ковычка+Версия1С+Ковычка); 
		Если Не ПроверитьНаличиеФайла(ПутьВыгрузки + "\" + ИмяБазы) Тогда
			БатФайл.ДобавитьСтроку("mkdir " + ПутьВыгрузки + "\" + ИмяБазы);	
		КонецЕсли;
		
		БатФайл.ДобавитьСтроку("%v8% infobase config save -c " + КонфигурационныйФайл + " " + ПутьВыгрузки + "\" + ИмяБазы+ДеньВыгрузки + "\Main.cf -u " + ЛогинБазы + " -P " + ПарольБазы);

		//БатФайл.ДобавитьСтроку("%v8%\ibcmd.exe infobase config save -c " + КонфигурационныйФайл + " " + ПутьВыгрузки + "\" + ИмяБазы+ДеньВыгрузки + "\Main.cf -u " + ЛогинБазы + " -P " + ПарольБазы);
		//БатФайл.ДобавитьСтроку("pause");
		БатФайл.Записать(ПолноеИмяИмяБатФайла, КодировкаЗаписи);
		ЗапуститьПриложение(ИмяБатФайла, КаталогВременныхФайлов, Истина, КодВозврата);	
		УдалитьФайлы(ПолноеИмяИмяБатФайла); 
		
		Если КодВозврата>0 Тогда
			
			Продолжить;
			ЗаписьЖурналаРегистрации("АвтономныйСервер.Ошибка.СохранитьКонфигурацию",УровеньЖурналаРегистрации.Ошибка,,ВыборкаДетальныеЗаписи.Ссылка,"Ошибка запуска бат-файла для выгрузки конфигурации");	
	
		КонецЕсли;
		
					
		ЗапросРасширений = Новый Запрос;
		ЗапросРасширений.Текст = 
			"ВЫБРАТЬ
			|	ЗД_Хранилища.Наименование КАК Наименование
			|ИЗ
