
Процедура СоздатьЗаписьЗапускаСкрипта(ИБ,Скрипт,СодержаниеЛога) Экспорт
	//логирование
	ЖурналОбновлений = РегистрыСведений.ЖурналЗапускаСкриптов.СоздатьМенеджерЗаписи();
	ЖурналОбновлений.Период = ТекущаяДата();
	ЖурналОбновлений.ИБ = ИБ;
	ЖурналОбновлений.Скрипт = Скрипт;
	ЖурналОбновлений.Лог = СодержаниеЛога;   
	ЖурналОбновлений.Записать(Истина);	
КонецПроцедуры

